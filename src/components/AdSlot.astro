---
/* Ad slot — law 8: OFF = zero height, zero request, zero shift. No ad JS ever loads here. */
const props = Astro.props;
---
<div class="ad-slot" data-ad-slot={props.id || 'slot'}>
  <div class="slot-frame">
    <span class="slot-label">Advertisement · reserved</span>
    <span class="slot-note">{props.note || 'No ad code loaded — slots stay dark until the King flips the switch.'}</span>
  </div>
</div>
