---
/* ArticleChrome — shared article furniture + vanilla islands (no jQuery, ever).
   Used by [...slug].astro and the kitchen-sink style test.
   Props: title, url (absolute), tags (string[]). */
import SocialRow from './SocialRow.astro';
import { SOCIAL_PERSONAL } from '../data/socials';
import { SITE } from '../data/site';
const { title, url, tags = [] } = Astro.props;
const enc = encodeURIComponent;
const shareX = `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`;
const shareWa = `https://wa.me/?text=${enc(title + ' ' + url)}`;
const shareTg = `https://t.me/share/url?url=${enc(url)}&text=${enc(title)}`;
---
<!-- reading progress: fixed top GPU bar, transform scaleX only (zero CLS) -->
<div class="rprog" id="reading-progress" aria-hidden="true"><i></i></div>

<!-- trust footer: tags + share -->
{tags.length > 0 && (
  <ul class="post-tags" aria-label="Tagged">
    {tags.map(t => (<li><a href={`/latest/`} rel="tag">#{t}</a></li>))}
  </ul>
)}
<div class="share-row" aria-label="Share this guide">
  <span class="share-k" aria-hidden="true">Share</span>
  <!-- v0.6.9 King addendum #5: icons + Copy link = ONE right-hand group so that on
       wrap, Copy link stacks UNDER the icon column, never orphaned under the label. -->
  <span class="share-grp">
  <a class="sh-btn sh-btn--icon" href={shareX} target="_blank" rel="noopener noreferrer" aria-label="Share on X"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path style="fill:currentColor;stroke:none" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg><span class="sr-only">Share on X</span></a>
<!-- v0.6.5 share glyph updates (King screenshot verdict on v0.6.3: WA read as a TILTED MAP PIN
     with handset ends welded to the wall — root cause: v0.6.3's arc flags `0 1 1` drew the
     REFLECTED circle. v3 bubble = ONE continuous path, major arc `0 1 0` (verified renders the
     true circle) r7.0 c(12,11.2) + SHORT integrated stub tail to tip ~(6.2,18.6) max y18.6<19,
     no long sweep; handset = bowed bar + 2 bulb circles r0.85, ends at r3.2 from centre ->
     >=2.5u clear of the wall at every point (never touching). Blind-read PASS: "circular speech
     bubble with a small pointed tail... WhatsApp". TG v2 (King: "double-pointed glitched nose,
     wings too narrow, fold misaligned"): nose ONE corner (21.2,4.8), left tail corner (2.6,12.4),
     small notch mid-tail, bottom wing corner (12.8,19.4); miter joins + square caps; fold line
     tail-centre->nose stopping 1.4u short so the cap never doubles at the tip; 2 paths max.
     Blind-read PASS: "paper airplane... Telegram... Send". X + Copy-link bytes untouched.
<!-- v0.6.7 share glyph OPTICAL BALANCE (King: WA + TG read smaller than X at the 16px phone size):
     both resized to X's optical footprint in the 24u grid via group scale about (12,12) — no other
     bytes touched (viewBox, aria, sr-only, hrefs identical). Measured in cairosvg lab @16px true size,
     light #f6f8f8 + dark #0B1F1A sheets, blind vision read gate: X geom ink bbox 17.6x17.3u = the band
     (15.7-19.2/axis). WA shape v4: the stroke v3 STILL failed the cold read (reads as "prohibited sign"
     at 16px); per King addendum the brand mark was REBUILT as the authentic WhatsApp silhouette (official
     Simple-Icons path, filled currentColor — handset punched by the path's own evenodd, brand-realistic)
     at scale 0.86 uniform. FINISH-LEG ITERATION (2 of cap 4 used): the dead leg's 0.745 rastered a
     12x12px ink bbox at the true 16px phone size vs X's 14x14 (ratio 0.857 — outside +-10%; its
     stroke-free 24u-geom measure said PASS, the device raster said no). 0.86 is the fit: 16px device
     raster 14x14 both themes (ratio 1.00/1.00, ink 106 vs X 118), 480px-lab ratio w 0.907 h 1.046
     area 0.949 — every axis inside +-10%. Transform-only: brand path bytes verbatim from wa_d.txt,
     viewBox/aria/sr-only/hrefs identical; blind cold-read PASS both themes ("speech bubble with tail
     enclosing a handset — WhatsApp"), all three in one bounding-box class. TG = approved v2 shape,
     resize-only scale(0.95 1.10) (dead leg's own gate line called .95/1.10 but its applied edit
     carried the earlier 0.92/1.16 — raster h-ratio 1.124, band-out): now 16px device raster 14x14
     (1.00/1.00), 480-lab w 1.033 h 1.066, stroke-free geom 17.6x16.0u inside the 15.7-19.2 band
     (was 18.6x14.6 — height deficit fixed), strokes + non-scaling kept. Blind cold-read names both
     themes "Telegram/paper plane", equal size class. X + Copy-link bytes untouched. -->
  <a class="sh-btn sh-btn--icon" href={shareWa} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g transform="translate(12 12) scale(0.86) translate(-12 -12)"><path style="fill:currentColor;stroke:none" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></g></svg><span class="sr-only">Share on WhatsApp</span></a>
<!-- v0.6.15 TG PLANE-ONLY FIX (King screenshots 12:29 + follow-up: "Telegram SVG looks odd with the
     circle compared to others — I like the others, let Telegram match their type design"): v0.6.13
     shipped the Simple-Icons 'telegram' COMPOUND path — its first sub-path is the brand disc, and the
     plane renders as a negative cutout inside it. On our monochrome currentColor tiles that reads as a
     dark circle with a plane-shaped hole, NOT the solid-glyph family X/WA set. FIX: drop the circle
     sub-path entirely; keep ONLY the plane sub-path as a single SOLID filled silhouette (currentColor),
     matching X's solid mark family. The plane sub-path began with a RELATIVE 'm' anchored at the
     circle's start point (11.944,0) — anchor baked to absolute M16.906 7.224, remaining bytes verbatim.
     Fold slits tested (even-odd cuts at 16px): collapse to 1px speckle noise + edge erosion at tile
     size — REJECTED per cairosvg A/B vision gate; clean solid plane ships. Re-centered on the plane's
     own ink-bbox center (10.861,12.329) and scale(1.67) about (12,12): cairosvg trio lab @16px true
     device size both themes — TG raster ink 15x13 vs X 14x14 / WA 14x14 = w1.07 h0.93, inside the
     +-10% trio law (uniform 1.63-1.70 all pass; 1.67 best optical weight per zoom-sheet eye check).
     Blind cold-read of the trio sheet both themes: "X / WhatsApp / Telegram", TG reads solid paper
     plane, same filled family as X, NO disc. aria-label/href/tile/viewBox/sr-only identical; X/WA/Copy
     bytes untouched. Prior: v0.6.13 brand-mark fix, v0.6.5/6.7 stroke plane. -->
  <a class="sh-btn sh-btn--icon" href={shareTg} target="_blank" rel="noopener noreferrer" aria-label="Share on Telegram"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g transform="translate(12 12) scale(1.67) translate(-10.861 -12.329)"><path style="fill:currentColor;stroke:none" d="M16.906 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></g></svg><span class="sr-only">Share on Telegram</span></a>
  <button class="sh-btn sh-btn--icon" type="button" data-copy-link={url} aria-label="Copy link"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path vector-effect="non-scaling-stroke" d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path vector-effect="non-scaling-stroke" d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span>Copy link</span></button>
  </span>
</div>

<!-- author bio -->
<div class="author-box" itemprop="author" itemscope itemtype="https://schema.org/Person">
  <!-- AUDIT-01 M5: self-hosted author photo (was Gravatar) — zero third-party requests. 48px slot kept => zero layout shift. -->
  <img class="a-photo" src="/img/author.png"
       alt="G-will Chijioke" itemprop="image" loading="lazy" decoding="async" width="48" height="48" />
  <div class="a-body">
    <h4 itemprop="name">G-will Chijioke</h4>
    <p><span itemprop="description">Founder of AndroidScroll. Fixes Android on cheap data and cheaper phones — everything tested on real Tecno/Infinix hardware.</span> Corrections and tips: <a href="mailto:desk@androidscroll.com">desk@androidscroll.com</a> · <a href="/how-we-test/">How we test</a></p>
    <!-- v0.6.10 personal accounts (King-verified slugs; IG has NO underscore) -->
    <div class="a-socials">
      <SocialRow items={SOCIAL_PERSONAL} label="G-will Chijioke on social media" variant="paper" />
    </div>
  </div>
</div>

<!-- ONE in-article newsletter slot -->
<section class="notify notify-art" aria-label="Launch alerts">
  <div class="notify-in">
    <div>
      <h2>One fix a week. No noise.</h2>
      <p>Launch alerts go out when a shelf opens. {SITE.email} answers.</p>
    </div>
    <form data-notify-form action="/contact/" method="get">
      <label class="sr-only" for="nl-email" style="position:absolute;left:-9999px">Email address</label>
      <input id="nl-email" type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
      <button class="btn-deep" type="submit">Tell me</button>
      <span class="n-note">Static site — submit opens the contact desk. No trackers.</span>
    </form>
  </div>
</section>

<script>
/* Article islands — vanilla, article routes only. One IIFE per concern. */
(function () {
  'use strict';
  var reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 1. reading progress: scaleX on the GPU, rAF-throttled, passive. */
  var pb = document.getElementById('reading-progress');
  var ticking = false;
  function updatePb() {
    ticking = false;
    if (!pb) return;
    var mx = document.documentElement.scrollHeight - innerHeight;
    var pc = mx > 0 ? Math.min(1, Math.max(0, scrollY / mx)) : 0;
    pb.firstElementChild.style.transform = 'scaleX(' + pc + ')';
  }
  addEventListener('scroll', function () {
    if (!ticking) { ticking = true; requestAnimationFrame(updatePb); }
  }, { passive: true });
  updatePb();

  /* 2. heading IDs (respect explicit id, dedupe -2/-3) + dual TOC build. */
  function slugify(s) {
    return s.toLowerCase().trim().replace(/[^a-z0-9\s-]/g, '').replace(/[\s_]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '') || 'section';
  }
  var prose = document.querySelector('.prose');
  var heads = prose ? Array.prototype.slice.call(prose.querySelectorAll('h2, h3')) : [];
  var seen = Object.create(null);
  heads.forEach(function (h) {
    var id = h.id || slugify(h.textContent || '');
    if (seen[id] !== undefined) { seen[id] += 1; id = id + '-' + (seen[id] + 1); }
    else seen[id] = 0;
    h.id = id;
  });
  var h2s = heads.filter(function (h) { return h.tagName === 'H2'; });
  var tocM = document.querySelector('[data-toc-mobile]');
  var tocD = document.querySelector('[data-toc-desktop]');
  /* >2-H2 gate: short posts skip the TOC entirely (tech rule). */
  if (h2s.length <= 2) {
    if (tocM && tocM.closest('details')) tocM.closest('details').hidden = true;
    if (tocD) tocD.hidden = true;
  } else {
  /* build items by document order walk (robust): h3s nest under the preceding h2 */
  var items = [];
    var cur = null;
    heads.forEach(function (h) {
      if (h.tagName === 'H2') { cur = { h: h, subs: [] }; items.push(cur); }
      else if (cur) cur.subs.push(h);
    });
    function listHTML(cls) {
      return '<ul class="' + cls + '">' + items.map(function (it, i) {
        var s = '<li><a href="#' + escA(it.h.id) + '" data-spy="' + escA(it.h.id) + '">' + esc(it.h.textContent) + '</a>';
        if (it.subs.length) {
          s += '<ul>' + it.subs.map(function (x) {
            return '<li><a href="#' + escA(x.id) + '" data-spy="' + escA(x.id) + '">' + esc(x.textContent) + '</a></li>';
          }).join('') + '</ul>';
        }
        return s + '</li>';
      }).join('') + '</ul>';
    }
    if (tocM) { tocM.innerHTML = listHTML('toc-list'); tocM.closest('details').hidden = false; }
    if (tocD) { tocD.innerHTML = '<p class="toc-k">&gt;_ On this page</p>' + listHTML('toc-list'); tocD.hidden = false; }
    /* label it like a real TOC: "In this guide (N)" */
    var cnt = document.querySelector('.toc-mobile .toc-count');
    if (cnt) cnt.textContent = '(' + items.length + ')';
  }

  /* 3. scroll-spy: IntersectionObserver, .cur on the visible section link. */
  if ('IntersectionObserver' in window && h2s.length > 2 && !reduceMotion) {
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-spy]'));
    var map = {};
    links.forEach(function (a) { (map[a.getAttribute('data-spy')] = map[a.getAttribute('data-spy')] || []).push(a); });
    var obs = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        links.forEach(function (a) { a.classList.remove('cur'); });
        (map[en.target.id] || []).forEach(function (a) { a.classList.add('cur'); });
      });
    }, { rootMargin: '-20% 0px -65% 0px' });
    heads.forEach(function (h) { obs.observe(h); });
  }

  /* 4. code blocks: micro-tokenizer bash highlighting (zero deps, token colors)
   + copy button + lang chip on a NON-scrolling wrapper (v0.4.9 King: the chip and
   button lived inside the x-scrolling pre and slid off-screen). No Prism, no jQuery. */
  var BASH_CMDS = /^(adb|pm|wm|am|svc|cmd|content|settings|dumpsys|input|getprop|setprop|logcat|install|uninstall|push|pull|shell|devices|wait|start|reboot|emu|grep|egrep|fgrep|cat|tail|head|echo|df|du|ls|find|rm|mv|cp|mkdir|unzip|zip|tar|sha256sum|md5sum|openssl|run-as|split|monkey|bu|dmesg|sort|cut|sed|awk|wc|sleep|kill|pkill)$/;
  function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function escA(s) { return esc(s).replace(/"/g, '&quot;'); }
  function hlBash(text) {
    var re = /(#[^\n]*)|("[^"\n]*"|'[^'\n]*')|(-{1,2}[A-Za-z][\w-]*)|(\|\||&&|[|><;]|\$[\w{}]+)|(\d+)|([a-z][a-z0-9_.-]*)|([\s\S])/g, out = '', m;
    while ((m = re.exec(text))) {
      var t = m[0], cls = m[1] ? 'tk-cmt' : m[2] ? 'tk-str' : m[3] ? 'tk-flag' : m[4] ? 'tk-op' : m[5] ? 'tk-num' : (m[6] && BASH_CMDS.test(m[6])) ? 'tk-cmd' : '';
      out += cls ? '<span class="' + cls + '">' + esc(t) + '</span>' : esc(t);
    }
    return out;
  }
  document.querySelectorAll('.prose pre').forEach(function (pre) {
    if (pre.classList.contains('verse')) return; /* v0.4.12 King: poems are not code — no copy button, no wrapper, no chip */
    var code = pre.querySelector('code');
    var lang = 'code';
    if (code) {
      var m = (code.className || '').match(/language-([\w+-]+)/);
      if (m) lang = m[1];
      if (/^(bash|sh|shell|console)$/i.test(lang) && !code.querySelector('span')) code.innerHTML = hlBash(code.textContent);
    }
    var wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    wrap.setAttribute('data-lang', lang);
    pre.parentNode.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code block (' + lang + ')');
    btn.addEventListener('click', function () {
      var txt = code ? code.textContent : pre.textContent;
      function done() {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = 'Copy'; }, 1600);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(txt).then(done, function () { fallback(); done(); });
      } else { fallback(); done(); }
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = txt;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) { /* ignore */ }
        document.body.removeChild(ta);
      }
    });
    wrap.appendChild(btn);
  });

  /* 5. table x-scroll wrappers (JS safety net; CSS .tbl-wrap is primary). */
  document.querySelectorAll('.prose table').forEach(function (t) {
    if (t.parentElement && t.parentElement.classList.contains('tbl-wrap')) return;
    var w = document.createElement('div');
    w.className = 'tbl-wrap';
    w.setAttribute('tabindex', '0');
    w.setAttribute('role', 'region');
    w.setAttribute('aria-label', 'Scrollable table');
    t.parentNode.insertBefore(w, t);
    w.appendChild(t);
  });

  /* 6. lightbox — vanilla port of the themes' gl-overlay pattern:
        dialog + focus trap + counter + caption + swipe (>40px).
        Scope: EVERY article image the reader can zoom — hero + every figureimg,
        not only .prose descendants (gallery + hero live outside prose). */
  var lbImgs = Array.prototype.slice.call(document.querySelectorAll('figure img, .gallery img, .art-hero img, .qa-box img')).filter(function (im) {
    return !im.closest('.no-zoom') && !im.closest('a');
  });
  lbImgs.forEach(function (im) {
    im.style.cursor = 'zoom-in';
    im.setAttribute('tabindex', '0');
    im.setAttribute('role', 'button');
    im.setAttribute('aria-label', 'Enlarge image: ' + (im.alt || 'screenshot'));
  });
  var ov = null, lbImg = null, lbCap = null, lbCount = null, idx = 0, lastTrigger = null;
  function buildLb() {
    if (ov) return;
    ov = document.createElement('div');
    ov.className = 'gl-overlay';
    ov.setAttribute('role', 'dialog');
    ov.setAttribute('aria-modal', 'true');
    ov.setAttribute('aria-label', 'Image lightbox');
    ov.hidden = true;
    ov.innerHTML = '<button class="gl-close" aria-label="Close">&times;</button>' +
      '<button class="gl-nav gl-prev" aria-label="Previous image">&lsaquo;</button>' +
      '<div class="gl-image-wrap"><img class="gl-image" src="" alt=""></div>' +
      '<button class="gl-nav gl-next" aria-label="Next image">&rsaquo;</button>' +
      '<div class="gl-counter" aria-live="polite"></div>' +
      '<div class="gl-caption"></div>';
    document.body.appendChild(ov);
    lbImg = ov.querySelector('.gl-image');
    lbCap = ov.querySelector('.gl-caption');
    lbCount = ov.querySelector('.gl-counter');
    ov.querySelector('.gl-close').addEventListener('click', closeLb);
    ov.addEventListener('click', function (e) { if (e.target === ov) closeLb(); });
    ov.querySelector('.gl-prev').addEventListener('click', function (e) { e.stopPropagation(); navLb(-1); });
    ov.querySelector('.gl-next').addEventListener('click', function (e) { e.stopPropagation(); navLb(1); });
    document.addEventListener('keydown', function (e) {
      if (!ov || ov.hidden) return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') navLb(-1);
      if (e.key === 'ArrowRight') navLb(1);
      if (e.key === 'Tab') {
        var f = Array.prototype.filter.call(ov.querySelectorAll('button'), function (b) { return !b.disabled; });
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && (document.activeElement === first || !ov.contains(document.activeElement))) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && (document.activeElement === last || !ov.contains(document.activeElement))) { e.preventDefault(); first.focus(); }
      }
    });
    var sx = 0, sy = 0;
    ov.addEventListener('touchstart', function (e) {
      if (e.target.closest('.gl-close') || e.target.closest('.gl-nav')) return;
      sx = e.changedTouches[0].screenX; sy = e.changedTouches[0].screenY;
    }, { passive: true });
    ov.addEventListener('touchend', function (e) {
      if (e.target.closest('.gl-close') || e.target.closest('.gl-nav')) return;
      var dx = e.changedTouches[0].screenX - sx, dy = e.changedTouches[0].screenY - sy;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 40) navLb(dx > 0 ? -1 : 1);
    }, { passive: true });
  }
  function captionFor(im) {
    var fig = im.closest('figure');
    var fc = fig ? fig.querySelector('figcaption') : null;
    return fc ? fc.textContent : (im.alt || '');
  }
  function showLb() {
    var im = lbImgs[idx];
    var src = im.currentSrc || im.src || '';
    if (!src) { var a = im.getAttribute('src'); if (a) { try { src = new URL(a, document.baseURI).href; } catch (e) { src = a; } } } /* v0.4.13 King: never hand the dialog an empty src (paints zero px, no broken icon) */
    lbImg.src = src;
    lbImg.alt = im.alt || '';
    lbCap.textContent = captionFor(im);
    lbCount.textContent = (idx + 1) + ' / ' + lbImgs.length;
    var single = lbImgs.length < 2;
    ov.querySelector('.gl-prev').style.display = single ? 'none' : '';
    ov.querySelector('.gl-next').style.display = single ? 'none' : '';
  }
  function openLb(i, trigger) {
    buildLb();
    idx = i; lastTrigger = trigger || null;
    showLb();
    ov.hidden = false;
    requestAnimationFrame(function () { ov.classList.add('gl-open'); });
    document.documentElement.classList.add('locked');
    ov.querySelector('.gl-close').focus();
  }
  function closeLb() {
    if (!ov) return;
    ov.classList.remove('gl-open');
    ov.hidden = true;
    document.documentElement.classList.remove('locked');
    if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
  }
  function navLb(d) {
    idx = (idx + d + lbImgs.length) % lbImgs.length;
    showLb();
  }
  lbImgs.forEach(function (im, i) {
    im.addEventListener('click', function () { openLb(i, im); });
    im.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLb(i, im); }
    });
  });

  /* 7. embed facades: click swaps the provider iframe in (zero 3rd-party until play).
        v0.4.17: card facades (poster+badge+play) for YouTube/Vimeo/TikTok/Spotify/AppleMusic —
        same swap-in, but the iframe REPLACES the card innards and the card keeps its frame. */
  document.querySelectorAll('[data-facade]').forEach(function (f) {
    var btn = f.querySelector('button');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var src = f.getAttribute('data-src');
      if (!src) {
        var note = f.querySelector('.facade-note');
        if (note) note.hidden = false;
        btn.disabled = true;
        return;
      }
      var ifr = document.createElement('iframe');
      ifr.src = src;
      ifr.title = f.getAttribute('data-title') || 'Embedded media';
      ifr.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation');
      ifr.setAttribute('allow', 'autoplay; encrypted-media; fullscreen; picture-in-picture');
      ifr.allowFullscreen = true;
      
      /* v0.4.27 King: v0.4.23 fix broke because .fc-live iframe CSS applied aspect-ratio:16/9
         to ALL live iframes — audio players (Spotify 152, Apple 270, Audiomack 252) need the px
         height, not a ratio box. Now the JS sets the exact sizing per card: data-embed-height =
         px height + aspect-ratio:auto for audio players, data-embed-ratio (fallback 16/9) for
         video. The blanket CSS ratio is gone. */
      var eh = f.getAttribute('data-embed-height');
      var er = f.getAttribute('data-embed-ratio');
      if (eh) {
        ifr.style.height = eh + 'px';
        ifr.style.aspectRatio = 'auto'; /* explicit: no engine may re-apply a ratio to audio */
      } else {
        ifr.style.height = 'auto';
        ifr.style.aspectRatio = er || '16/9'; /* TikTok 9/16, YouTube/Vimeo/YT-Music 16/9 */
      }
      /* wipe card innards, keep the card shell (its aspect-ratio/border carry the frame) */
      while (f.firstChild) f.removeChild(f.firstChild);
      f.appendChild(ifr);
      f.classList.add('fc-live');
      /* v0.4.29 King: provider class so per-provider CSS can align corners/bg with the widget */
      try {
        var host = new URL(src).hostname.replace(/^www\./, '').split('.');
        var pk = host.length > 2 ? host[host.length-2] : host[0];
        if (/music/.test(src) && /youtube/.test(src)) pk = 'ytmusic';
        f.classList.add('fc-live-' + pk);
      } catch (e) {}
    });
  });

  /* 8. copy-link with execCommand fallback + toast. */
  function toast(msg) {
    var t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._h);
    t._h = setTimeout(function () { t.classList.remove('show'); }, 2200);
  }
  document.querySelectorAll('[data-copy-link]').forEach(function (b) {
    b.addEventListener('click', function () {
      var link = b.getAttribute('data-copy-link');
      function done(ok) { toast(ok ? 'Link copied.' : 'Copy failed — long-press the URL.'); }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(link).then(function () { done(true); }, function () { done(false); });
      } else {
        var ta = document.createElement('textarea');
        ta.value = link;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(true); } catch (e) { done(false); }
        document.body.removeChild(ta);
      }
    });
  });
})();
</script>
