---
// Comments — click-to-load, zero third-party JS, Worker rail (brief §4).
// v0.5.3 (COMMENTSUX-BRIEF Leg A+B): optimistic reactions (§3a.3), heart geometry
//   candidate B + fill-on-active + non-scaling stroke (§3c), relative time + 60 s
//   refresh (D1), live count probe via IntersectionObserver (D6), localStorage
//   own-reaction mirror (§3a.3-i), ONE summary pill → picker (D2), single action
//   footer row: reactions · Reply · Share · Report (D4/D9/D10), inline reply moves
//   the form (D8), one thread rail + tightened rhythm (D5/D15), pending ghost row
//   + structured skeleton (D13/D12). Sanitizer path untouched. No spinners.
interface Props {
  postId: number;            // REQUIRED — WP post id
  postSlug?: string;         // analytics/moderation context
  authorName?: string;       // post author display name → is_author badge match
  initialCount?: number;     // build-time count, rendered in the button label
  policyUrl?: string;        // default '/comments-policy'
  apiBase?: string;          // Worker origin — one constant to roll back
}
const {
  postId,
  postSlug = '',
  authorName = '',
  initialCount,
  policyUrl = '/comments-policy',
  apiBase = 'https://androidscroll-comments.gwill.workers.dev',
} = Astro.props;
const hasCount = typeof initialCount === 'number' && initialCount > 0;
---

<section class="comments col" id="comments-section" data-post-id={postId} data-post-slug={postSlug}
  data-author={authorName} data-api={apiBase} aria-labelledby="comments-h">
  <div class="rule-s">
    <span class="s-no">§</span>
    <h2 id="comments-h">Comments</h2>
    <span class="s-side">{hasCount ? `${initialCount} approved · new posts held for review` : 'New posts held for review'}</span>
  </div>

  <button id="load-comments-btn" type="button">
    {hasCount
      ? <>Read the <span class="cnt">{initialCount}</span>&nbsp;comments</>
      : <>Be the first to comment</>}
  </button>
  <noscript><p class="c-noscript">Comments require JavaScript — read our
    <a href={policyUrl}>comments policy</a>.</p></noscript>

  <div id="comments-inner" hidden>
    <!-- structured 2-row skeleton — avatar square + 2 bars (brief §4.7 / D12) -->
    <div id="comments-loading" aria-busy="true">
      <div class="c-skel-row"><span class="sk-av" aria-hidden="true"></span><span class="sk-lines"><span class="sk-bar"></span><span class="sk-bar sk-bar-s"></span></span></div>
      <div class="c-skel-row"><span class="sk-av" aria-hidden="true"></span><span class="sk-lines"><span class="sk-bar"></span><span class="sk-bar sk-bar-s"></span></span></div>
    </div>
    <div id="comments-error" hidden>
      <p class="c-err-msg" role="alert">Couldn't load comments — the thread service didn't answer.</p>
      <button id="retry-comments" type="button">Retry</button>
    </div>
    <div id="comments-list" hidden></div>

    <div id="comments-form" hidden>
      <div class="c-form-card">
        <div class="kicker-h">Leave a comment</div>
        <!-- reply strip: sits ABOVE the fields; moves WITH the form card when
             Reply is tapped (§4.6). role=status announces "Replying to {name}".
             Cancel returns focus to the originating Reply button (WCAG 2.4.3). -->
        <div id="reply-indicator" hidden role="status">
          <span class="c-re-mark" aria-hidden="true">↳</span>
          <span class="c-reply-txt">Replying to <strong id="reply-name"></strong></span>
          <button type="button" id="cancel-reply">Cancel <span aria-hidden="true">×</span></button>
        </div>
        <form id="comment-form">
          <div class="comment-form-grid">
            <div class="c-field">
              <label for="c-name">Name <span class="c-req">*</span></label>
              <input id="c-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" />
            </div>
            <div class="c-field">
              <label for="c-email">Email <span class="c-opt">(optional — needed only for reply notices)</span></label>
              <input id="c-email" name="email" type="email" maxlength="254" autocomplete="email" />
            </div>
          </div>
          <div class="c-field">
            <label for="c-url">Website <span class="c-opt">(optional)</span></label>
            <input id="c-url" name="url" type="url" maxlength="200" inputmode="url" autocomplete="url" placeholder="https://…" />
          </div>
          <div class="c-field">
            <label for="c-content">Comment <span class="c-req">*</span></label>
            <textarea id="c-content" name="content" rows="4" required maxlength="5000" aria-describedby="c-count"></textarea>
            <span id="c-count" class="c-count" aria-live="polite"></span>
          </div>
          <input id="c-parent" name="parent" type="hidden" value="0" />
          <!-- honeypot: bots fill it, humans never see it -->
          <div class="c-hp" aria-hidden="true"><label for="c-hp">Leave this empty</label><input id="c-hp" name="honeypot" type="text" tabindex="-1" autocomplete="off" /></div>
          <!-- JS guard owns consent feedback (Safari bubble blocked submit silently) -->
          <!-- v0.6.9 FINISH-3: label is inline-flex gap:8px — the "policy. " text was an
             anonymous flex item, so gap:8px re-glued nothing (star still 8px off the
             period). Wrap trailing text + period + star in ONE inline span: flex gap
             only applies input↔span, star sits flush against the period. -->
<p class="c-check"><label><input id="c-consent" name="consent" type="checkbox" /> <span>I agree to the <a href={policyUrl} target="_blank" rel="noopener">comments policy</a>.<span class="c-req">*</span></span></label></p>
          <p class="c-check"><label><input id="c-notify" name="notify" type="checkbox" /> Email me when someone replies.</label></p>
          <button type="submit" id="c-submit" class="btn-deep">Post Comment</button>
          <p id="form-msg" aria-live="polite" role="status"></p>
          <p class="n-note">Held for review first — approved comments appear here and by email reply notices go to the thread followers.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
const section = document.getElementById('comments-section') as HTMLElement;
const postId  = section?.dataset.postId || '';
const API     = (section?.dataset.api || '') + '/api/comments';

const ALLOWED_COMMENT_TAGS = new Set([
  'a','b','strong','i','em','u','s','p','br','ul','ol','li',
  'blockquote','pre','code','span','del','ins'
]);

const ALLOWED_COMMENT_ATTRS: Record<string, Set<string>> = {
  'a':   new Set(['href', 'title', 'rel', 'target']),
  '*':   new Set(['class']),
};

// XSS boundary — unchanged (DESIGN-RESEARCH §4.12.4): template round-trip.
function sanitizeCommentHtml(html: string): string {
  const tpl = document.createElement('template');
  tpl.innerHTML = html;
  sanitizeNode(tpl.content);
  return tpl.innerHTML;
}

function sanitizeNode(node: Node): void {
  const remove: Node[] = [];
  node.childNodes.forEach(child => {
    if (child.nodeType === Node.ELEMENT_NODE) {
      const el = child as Element;
      const tag = el.tagName.toLowerCase();
      if (!ALLOWED_COMMENT_TAGS.has(tag)) {
        node.insertBefore(document.createTextNode(el.textContent || ''), child);
        remove.push(child);
        return;
      }
      const drop: string[] = [];
      for (const attr of Array.from(el.attributes)) {
        const n = attr.name.toLowerCase();
        const tagAllowed  = ALLOWED_COMMENT_ATTRS[tag] ?? new Set<string>();
        const globAllowed = ALLOWED_COMMENT_ATTRS['*'] ?? new Set<string>();
        if (!tagAllowed.has(n) && !globAllowed.has(n)) { drop.push(attr.name); continue; }
        if (/^on/i.test(n)) { drop.push(attr.name); continue; }
        if (n === 'href' && /^\s*(javascript|data|vbscript):/i.test(attr.value)) {
          drop.push(attr.name); continue;
        }
      }
      drop.forEach(a => el.removeAttribute(a));
      if (tag === 'a') {
        el.setAttribute('rel', 'noopener noreferrer nofollow');
        if (/^https?:/i.test(el.getAttribute('href') || '')) el.setAttribute('target', '_blank');
      }
      sanitizeNode(el);
    } else if (child.nodeType === Node.COMMENT_NODE) {
      remove.push(child);
    }
  });
  remove.forEach(n => node.removeChild(n));
}

function esc(str: string): string {
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}

const $ = (id: string) => document.getElementById(id);
const show = (el: HTMLElement | null, on = true) => { if (el) el.hidden = !on; };
const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

// ── monogram avatar (t-mono-av house component — §4.3) ──
// Deterministic bg among the 4 brand greens only: deep, teal, deeper, verdict.
const AV_BG = ['var(--deep)', 'var(--teal)', 'var(--deeper)', 'var(--verdict)'];
function avHash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}
function avatarBg(c: any): string {
  return c.is_author ? AV_BG[0] : AV_BG[avHash(String(c.name || '')) % AV_BG.length];
}
function initials(name: string): string {
  const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return 'A';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

// ── relative time (brief D1 / §3a P2 — vanilla, no time lib) ──
function timeAgo(iso: string): string {
  const t = Date.parse(iso);
  if (!t) return '';
  const s = Math.max(0, (Date.now() - t) / 1000);
  if (s < 45) return 'just now';
  if (s < 3600) return `${Math.round(s / 60)}m ago`;
  if (s < 86400) return `${Math.round(s / 3600)}h ago`;
  if (s < 604800) return `${Math.round(s / 86400)}d ago`;
  if (s < 2592000) return `${Math.round(s / 604800)}w ago`;
  if (s < 31536000) return `${Math.round(s / 2592000)}mo ago`;
  return `${Math.round(s / 31536000)}y ago`;
}
function absDate(iso: string): string {
  const t = Date.parse(iso);
  if (!t) return '';
  return new Date(t).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function stampTimes(root: ParentNode) {
  root.querySelectorAll('time.c-date[data-ts]').forEach(el => {
    const iso = (el as HTMLElement).dataset.ts || '';
    el.setAttribute('title', absDate(iso)); // honest absolute date on hover/SR
    el.textContent = timeAgo(iso);
  });
}
// 60 s refresh — skips work while the tab is hidden (plugin-proven guard)
setInterval(() => { if (!document.hidden) stampTimes(document); }, 60000);
document.addEventListener('visibilitychange', () => { if (!document.hidden) stampTimes(document); });

// ── reactions: BESPOKE inline SVG (King law: geometry, not emoji; zero DNA ──
// ── from vibe-comments; non-scaling stroke keeps hairlines true at 14-18px ──
// heart = brief §3c.2 CANDIDATE B (two-cubic classic): off-centre lobes + cleft
// at x=12 — the shipped dome (semicircle apex at centre) is retired for good.
const REACTIONS = [['like', 'Like'], ['heart', 'Heart'], ['fire', 'Fire'], ['laugh', 'Laugh']] as const;
const VE = ' vector-effect="non-scaling-stroke"';
const REACT_SVG: Record<string, string> = {
  // thumbs-up: straight-line palm + cuff (fills solid when reacted)
  like: `<path class="fl"${VE} d="M8.6 20.4V11l5-8.2c2 0 3.2 1.2 3.2 3.2l-.6 3.4h4c1.6 0 2.6 1.2 2.4 2.6l-1.2 6.4c-.2 1.2-1.2 2-2.4 2H8.6Z"/><path class="fl"${VE} d="M3.6 11.6h5v8.8h-5z"/>`,
  // heart: candidate B — two-cubic classic silhouette (brief §3c.2)
  heart: `<path class="fl"${VE} d="M12 20.8C12 20.8 3.2 15 3.2 9.4 3.2 6.4 5.5 4.3 8.2 4.3c1.8 0 3.1 1 3.8 2.3.7-1.3 2-2.3 3.8-2.3 2.7 0 5 2.1 5 5.1 0 5.6-8.8 11.4-8.8 11.4Z"/>`,
  // flame: angular outline + SOLID core (v0.6.2 King: the hollow diamond read as a
  // droplet/leaf at 18px). Core is now always-filled, no .fl state, and grown
  // (6x7px solid mass) so the flame silhouette beats droplet/leaf at a glance.
  // Raster gate @18/24/36px both themes: pointed tip -> split side licks -> solid
  // core -> rounded base; unambiguous flame in light+dark.
  fire: `<path${VE} d="M12 2.8 16.2 9.4l1.6-1.6c1.6 2 2.6 4 2.6 6.2a8.4 8.4 0 1 1-16.8 0c0-2.2 1-4.2 2.6-6.2l1.6 1.6L12 2.8Z"/><path fill="currentColor" stroke="none" d="M12 10.6 15.5 15.4 12 20.2 8.5 15.4Z"/>`,
  // laugh: 😂 tears-of-joy — v0.6.3 LAUGH-v3 geometry, v0.6.6 OPTICAL SIZE MATCH (King:
  // "You didn't increase the size of the laughter SVG" — at equal 21px CSS it read SMALLER
  // than like/heart/fire because the face disc spanned only 13.2u of the 24 grid vs the
  // siblings' ~16-18u). Fix is geometry, not CSS. VISION GATE HISTORY (real Obscura picker
  // crops, both themes): r7.4 FAILED (21x13 disc still read small), r7.6s FAILED (read
  // compact), r8.8s size-PASSed light but both-theme mass reads said 'too heavy' vs the
  // monoline siblings. SHIPS r7.9s: face disc r6.6→7.9 (15.8u; wedge eyes + grin
  // proportional — same 68% mouth:face opening, same eye-mouth septum, evenodd knock-out
  // untouched); teardrops TRANSLATED along their radial axis to cusp tips (3.073,8.75)/
  // (20.927,8.75) = radius 9.5 = R+1.6 → glyph-lab 1.6u tip gutter law holds EXACTLY; bulbs
  // slimmed 0.80 about the tip (r1.7→1.36) so fill x[0.042,23.885] stays inside the 24u
  // viewBox (unscaled r7.9 bulbs clip ~0.03u/side — the "stubby handles" reject class).
  // Raster gate (cairosvg @ EXACT 21px picker + 16px pill, light #f6f8f8/#52635F + dark
  // #0B241D/#B6CCC6, vs shipped siblings heart 17x16 ink118/120, like 19x18 ink153/154,
  // fire 17x20 ink175/178): laugh 21x15 ink171 both themes; @16 16x12 ink104/106.
  // Brand monochrome — currentColor only, never emoji yellow/blue. No dark-mode colour
  // change (King: idle icons read great in dark as-is).
  laugh: `<path fill="currentColor" stroke="none" fill-rule="evenodd" d="M4.1 12a7.9 7.9 0 1 0 15.8 0a7.9 7.9 0 1 0 -15.8 0Z M7.935 7.411L6.314 9.965L10.264 9.965L8.644 7.411A0.419 0.419 0 0 0 7.935 7.411Z M15.356 7.411L13.736 9.965L17.686 9.965L16.065 7.411A0.419 0.419 0 0 0 15.356 7.411Z M6.614 11.88H17.386a5.386 6.344 0 0 1 -10.773 0Z"/><path d="M3.073 8.75L2.765 10.849A1.36 1.36 0 1 1 1.037 9.347Z" fill="currentColor" stroke="none"/><path d="M20.927 8.75L22.963 9.347A1.36 1.36 0 1 1 21.235 10.849Z" fill="currentColor" stroke="none"/>`,
};
const reactIcon = (k: string) =>
  '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + (REACT_SVG[k] || '') + '</svg>';

// ── own-reaction mirror (brief §3a.3 option i) — localStorage, try/catch ──
// v0.6.5: single-highlight semantics — the mirror stores ONE emoji key (string)
// per comment or deletes the entry. Old array format is migrated on read: the
// LAST valid key in the array wins (it was the most recent tap).
const RX_KEY = 'androidscroll:rx:' + postId;
const VALID_RX = new Set(REACTIONS.map(([k]) => k));
function readMirror(): Record<string, string | string[]> {
  try {
    const raw = localStorage.getItem(RX_KEY);
    const o = raw ? JSON.parse(raw) : {};
    return (o && typeof o === 'object' && !Array.isArray(o)) ? o : {};
  } catch { return {}; } // private browsing / disabled storage → degrade silently
}
function writeMirror(o: Record<string, string | string[]>) {
  try { localStorage.setItem(RX_KEY, JSON.stringify(o)); } catch { /* non-fatal */ }
}

// ── per-comment reaction state (optimistic source of truth) ──
const CSTATE = new Map<string, { counts: Record<string, number>; mine: Set<string>; err?: string }>();

function stateFor(c: any) {
  const id = String(c.id);
  const counts: Record<string, number> = {};
  for (const [k] of REACTIONS) counts[k] = Number((c.reactions && c.reactions[k]) || 0);
  const mine = new Set<string>();
  const stored = readMirror()[id];
  // v0.6.5 single-highlight: mirror is one key (string). Migrate the old array
  // format on read — last valid key wins — and rewrite the mirror in the new shape.
  let migrated: string | undefined;
  if (typeof stored === 'string' && VALID_RX.has(stored)) migrated = stored;
  else if (Array.isArray(stored)) { const last = stored.filter(k => VALID_RX.has(k)).pop(); if (last) migrated = last; }
  if (migrated) {
    mine.add(migrated);
    const m = readMirror();
    if (m[id] !== migrated) { m[id] = migrated; writeMirror(m); }
  } else if (stored !== undefined && stored !== null) {
    const m = readMirror(); delete m[id]; writeMirror(m); // stale/invalid entry pruned
  }
  const st = { counts, mine };
  CSTATE.set(id, st);
  return st;
}
function persistMine(id: string, st: { mine: Set<string> }) {
  const m = readMirror();
  const one = st.mine.size ? Array.from(st.mine)[0] : undefined; // v0.6.5: single key or null
  if (one) m[id] = one; else delete m[id];
  writeMirror(m);
}

function total(st: { counts: Record<string, number> }): number {
  return REACTIONS.reduce((n, [k]) => n + (st.counts[k] || 0), 0);
}

// ONE summary pill (P3): overlapping 18px glyph bubbles (top 3 types) + aggregate
// total; zero-state = dashed '+ React' slot-frame idiom. Tap → picker.
// v0.6.9 (King, phone screenshot: "the most that's in the front should be on top
// most" — v0.6.6 misread this as last/rightmost-on-top): TRUE Facebook semantics —
// DESCENDING by count, so the MOST-reacted bubble is FIRST (leftmost) in the chain,
// and .rx-stack nth-child z-index (3/2/1) paints earlier siblings OVER later ones.
// Ties keep the canonical REACTIONS order (like, heart, fire, laugh) via stable sort.
// Each non-first bubble still tucks in via margin-left — now under its neighbor.
function sumInner(st: { counts: Record<string, number>; mine: Set<string> }): string {
  const t = total(st);
  if (!t) return `<span class="rx-add" aria-hidden="true">+</span>React`;
  const top = REACTIONS.map(([k]) => k)
    .filter(k => (st.counts[k] || 0) > 0)
    .sort((a, b) => st.counts[b] - st.counts[a])
    .slice(0, 3)
    .map(k => `<span class="rx-bub${st.mine.has(k) ? ' is-mine' : ''}" data-emoji="${k}">${reactIcon(k)}</span>`)
    .join('');
  return `<span class="rx-stack" aria-hidden="true">${top}</span><span class="rx-total">${t}</span>`;
}

function reactionWrap(c: any, st: any): string {
  const id = esc(String(c.id));
  const opts = REACTIONS.map(([k, label]) =>
    `<button type="button" class="c-react" data-id="${id}" data-emoji="${k}" aria-pressed="${st.mine.has(k)}"` +
    ` aria-label="${label} reaction">${reactIcon(k)}<span class="c-react-n">${st.counts[k] || ''}</span></button>`).join('');
  return `<span class="c-rx" data-cid="${id}">` +
    `<button type="button" class="c-react-sum${total(st) ? '' : ' is-zero'}" data-cid="${id}" aria-expanded="false" aria-haspopup="true"` +
    ` aria-label="Reactions — open picker">${sumInner(st)}</button>` +
    `<span class="c-react-picker" hidden role="group" aria-label="Choose a reaction">${opts}</span>` +
    `<span class="c-rx-err" role="status" hidden></span></span>`;
}

function renderRx(id: string) {
  const st = CSTATE.get(id); if (!st) return;
  const wrap = document.querySelector(`.c-rx[data-cid="${id}"]`); if (!wrap) return;
  const sum = wrap.querySelector('.c-react-sum');
  if (sum) {
    (sum as HTMLElement).innerHTML = sumInner(st);
    sum.classList.toggle('is-zero', total(st) === 0);
    sum.setAttribute('aria-label', total(st) ? `${total(st)} reactions — open picker` : 'React — open picker');
  }
  wrap.querySelectorAll('.c-react').forEach(b => {
    const el = b as HTMLElement, k = el.dataset.emoji || '';
    el.setAttribute('aria-pressed', String(st.mine.has(k)));
    const n = el.querySelector('.c-react-n');
    if (n) n.textContent = st.counts[k] ? String(st.counts[k]) : '';
    el.classList.toggle('is-error', !!st.err);
  });
  const errEl = wrap.querySelector('.c-rx-err');
  if (errEl) {
    errEl.textContent = st.err || '';
    (errEl as HTMLElement).hidden = !st.err;
  }
}

// 240 ms spring pulse (§4.8) — the only acknowledgement a tap ever gets. No spinner.
function pop(el: HTMLElement) {
  if (REDUCED.matches) return;
  el.classList.remove('c-rx-pop');
  void (el as HTMLElement).offsetWidth; // restart the keyframe
  el.classList.add('c-rx-pop');
}

// ── optimistic state machine (brief §3a.3) — kills the silent return at old :228 ──
// v0.6.5 SINGLE-HIGHLIGHT (King bug #2): a tap REPLACES my reaction — mine holds at
// most one emoji. Tapping the same emoji again clears it (toggle-off). Every path
// (optimistic, server confirm, rollback) repaints all four buttons via renderRx, so
// no stale aria-pressed can survive. Rollback restores the full prior snapshot.
async function toggleReact(btn: HTMLElement) {
  if (btn.classList.contains('is-syncing')) return; // tap-block while syncing
  const cid = btn.dataset.id || '', emoji = btn.dataset.emoji || '';
  const st = CSTATE.get(cid); if (!st || !(emoji in st.counts)) return;
  st.err = undefined;

  // snapshot for rollback BEFORE the optimistic replace
  const prevMine = new Set(st.mine);
  const prevCounts = { ...st.counts };
  const was = st.mine.has(emoji);
  const delta = was ? -1 : 1;
  // PENDING (local): replace-or-clear mine so only ONE key can be highlighted
  st.mine = was ? new Set() : new Set([emoji]);
  st.counts[emoji] = Math.max(0, (st.counts[emoji] || 0) + delta);
  btn.classList.add('is-syncing');
  pop(btn);
  renderRx(cid);
  closePickers(); // King: the picker must vanish the instant a choice is applied

  const ctl = new AbortController();
  const timer = setTimeout(() => ctl.abort(), 5000); // 5 s abort → rollback path
  try {
    const res = await fetch(`${API}/${encodeURIComponent(cid)}/react`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ emoji, postId: Number(postId) }),
      signal: ctl.signal,
    });
    clearTimeout(timer);
    if (!res.ok) { let msg = ''; try { msg = (await res.json()).message || ''; } catch {} throw new Error(msg || String(res.status)); }
    const data = await res.json();
    // CONFIRMED: adopt the server's counts (authoritative — old emoji decremented,
    // new one incremented); mirror the single active key; mirror survives reload
    if (data && data.counts) for (const [k] of REACTIONS) if (typeof data.counts[k] === 'number') st.counts[k] = data.counts[k];
    if (data && typeof data.active === 'boolean') {
      if (data.active) st.mine = new Set([emoji]);
      else st.mine.delete(emoji); // toggle-off confirmed: only the tapped key clears
    }
    persistMine(cid, st);
  } catch (e: any) {
    // ROLLED BACK: restore the full prior snapshot (mine + counts), surface it — never silent
    st.mine = prevMine;
    st.counts = prevCounts;
    persistMine(cid, st);
    st.err = e && e.name === 'AbortError'
      ? 'Reaction timed out — tap to retry.'
      : "Couldn't save that reaction — tap to retry.";
    pop(btn);
  } finally {
    btn.classList.remove('is-syncing');
    renderRx(cid);
  }
}

// ── summary ⇄ picker ──
function closePickers(except?: HTMLElement) {
  document.querySelectorAll('.comments .c-react-picker').forEach(p => {
    if (p === except) return;
    (p as HTMLElement).hidden = true;
    const w = p.closest('.c-rx');
    const sum = w && w.querySelector('.c-react-sum');
    if (sum) sum.setAttribute('aria-expanded', 'false');
  });
}
function togglePicker(sum: HTMLElement) {
  const wrap = sum.closest('.c-rx'); if (!wrap) return;
  const picker = wrap.querySelector('.c-react-picker') as HTMLElement | null; if (!picker) return;
  const open = picker.hidden;
  closePickers(open ? picker : undefined);
  picker.hidden = !open;
  sum.setAttribute('aria-expanded', String(open));
}
document.addEventListener('click', (e) => {
  const t = e.target as Element;
  if (!t.closest || !t.closest('.c-rx')) closePickers();
});
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') closePickers();
});

// ── share: perma-link comment-{id} + copy + 'Copied' flash (§4.4) ──
function copyText(text: string): Promise<boolean> {
  try {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).then(() => true, () => legacyCopy(text));
    }
  } catch { /* fall through */ }
  return Promise.resolve(legacyCopy(text));
}
function legacyCopy(text: string): boolean {
  try {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;left:-9999px;top:0';
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand('copy');
    document.body.removeChild(ta);
    return ok;
  } catch { return false; }
}
function flash(btn: HTMLElement, label: string, ms: number, onDone?: () => void) {
  const keep = btn.textContent || '';
  btn.textContent = label;
  btn.classList.add('is-flash');
  setTimeout(() => { btn.textContent = keep; btn.classList.remove('is-flash'); if (onDone) onDone(); }, ms);
}

// ── report: existing worker endpoint (brief D10) — minimal reason select ──
function reportPanel(id: string): string {
  return `<span class="c-report" hidden><label class="sr-only" for="c-rep-sel-${id}">Reason</label>` +
    `<select id="c-rep-sel-${id}" class="c-rep-sel">` +
    `<option value="spam">Spam</option><option value="abusive">Abusive</option><option value="off-topic">Off topic</option></select>` +
    `<button type="button" class="c-rep-go" data-id="${id}">Send</button>` +
    `<button type="button" class="c-rep-x" data-id="${id}">Cancel</button></span>`;
}
async function sendReport(btn: HTMLElement) {
  const id = btn.dataset.id || '';
  const panel = btn.closest('.c-report');
  const sel = panel && (panel.querySelector('select') as HTMLSelectElement | null);
  const reason = (sel && sel.value) || 'unspecified';
  btn.disabled = true;
  try {
    const res = await fetch(`${API}/${encodeURIComponent(id)}/report`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason, postId: Number(postId) }),
    });
    if (res.ok || res.status === 202) {
      if (panel) panel.innerHTML = `<span class="c-rep-done" role="status">Reported — thank you.</span>`;
    } else {
      const d = await res.json().catch(() => ({} as any));
      if (panel) panel.innerHTML = `<span class="c-rep-err" role="status">${esc(d && d.message ? d.message : 'Could not send the report — try again shortly.')}</span>`;
    }
  } catch {
    if (panel) panel.innerHTML = `<span class="c-rep-err" role="status">Network error — the report was not sent.</span>`;
  }
}

// ── inline reply: the form MOVES into the comment (§4.6 / P6) ──
let formHome: HTMLElement | null = null;
let movedCard: HTMLElement | null = null;
function restoreFormHome() {
  const card = movedCard || (document.querySelector('.comments .c-form-card') as HTMLElement | null);
  if (card && formHome && card.parentElement !== formHome) formHome.appendChild(card);
}
function openReply(btn: HTMLElement) {
  const card = document.querySelector('.comments .c-form-card') as HTMLElement | null;
  const item = btn.closest('.c-item') as HTMLElement | null;
  if (!card || !item) return;
  if (!formHome) formHome = card.parentElement;
  let slot = null;
  for (const ch of Array.from(item.children)) {
    if ((ch as HTMLElement).classList && (ch as HTMLElement).classList.contains('c-reply-slot')) { slot = ch as HTMLElement; break; }
  } // :scope avoided — child scan is portable
  if (!slot) { slot = document.createElement('div'); slot.className = 'c-reply-slot'; item.appendChild(slot); }
  slot.appendChild(card); // SAME node moves — focus/values survive
  movedCard = card;
  item.classList.add('has-form');
  const parent = $('c-parent') as HTMLInputElement;
  if (parent) parent.value = btn.dataset.id || '0';
  const indicator = $('reply-indicator');
  const replyName = $('reply-name');
  if (indicator && replyName) { replyName.textContent = btn.dataset.name || ''; indicator.hidden = false; }
  (window as any).__replyBtn = btn;
  const ta = $('c-content') as HTMLTextAreaElement | null;
  if (ta) ta.focus();
  try { card.scrollIntoView({ block: 'nearest' }); } catch { card.scrollIntoView(); }
}
document.getElementById('cancel-reply')?.addEventListener('click', () => {
  const btn = (window as any).__replyBtn as HTMLElement | null;
  clearReply();
  if (btn) btn.focus(); // return focus to the originating Reply (WCAG 2.4.3)
});

// ── render: 1-level threading, ONE thread rail, single footer row ──
function renderThread(comments: any[]): string {
  const top     = comments.filter((c: any) => !c.parent);
  const replies = comments.filter((c: any) => c.parent);

  const renderComment = (c: any, replyToName = ''): string => {
    const safeName = esc(c.name || 'Anonymous');
    const iso = String(c.created_at || '');
    const id = esc(String(c.id));
    const linkOpen  = c.url ? `<a href="${esc(c.url)}" rel="nofollow noopener noreferrer" target="_blank">` : '';
    const linkClose = c.url ? '</a>' : '';
    const childReplies = replies.filter((r: any) => r.parent === c.id);
    const replyMark = replyToName
      ? `<div class="c-re-line"><span class="c-re-mark" aria-hidden="true">↳</span> re: ${esc(replyToName)}</div>`
      : '';
    const st = stateFor(c);
    const foot = `<div class="c-foot">` +
      reactionWrap(c, st) +
      `<span class="c-actions">` +
        `<button class="reply-btn" data-id="${id}" data-name="${safeName}" type="button">Reply</button>` +
        `<button class="c-share" data-id="${id}" type="button">Share</button>` +
        `<button class="c-report-btn" data-id="${id}" type="button" aria-expanded="false">Report</button>` +
      `</span>` +
      reportPanel(id) +
      `</div>`;
    return `
      <div class="c-item${replyToName ? ' c-reply' : ''}${c.is_author ? ' c-by-author' : ''}" id="comment-${id}">
        ${replyMark}
        <div class="c-meta">
          <!-- v0.6.10: email_hash (worker v0.1.3) -> 36px gravatar overlay on the
               monogram; d=404 miss removes the img, initials show through. Hash is
               regex-gated to [0-9a-f]{32,64} before it touches the URL. Null hash
               (every row today) renders the initials span exactly as before. -->
          <span class="c-av-wrap"><span class="c-avatar" aria-hidden="true" style="background:${avatarBg(c)}">${esc(initials(c.name || 'Anonymous'))}</span>${/^([0-9a-f]{32}|[0-9a-f]{64})$/.test(String(c.email_hash || '')) ? `<img class="c-photo" src="https://www.gravatar.com/avatar/${String(c.email_hash).toLowerCase()}?s=64&d=404" alt="${esc(c.name || 'Anonymous')}" loading="lazy" decoding="async" width="36" height="36" onerror="this.remove()">` : ''}</span>
          <span class="c-headline">
            <span class="c-name-wrap">${linkOpen}<span class="c-name">${safeName}</span>${linkClose}</span>
            <span class="c-sub">
              ${c.is_author ? '<span class="c-badge">★ AUTHOR</span>' : ''}
              <time class="c-date" data-ts="${esc(iso)}" datetime="${esc(iso)}">${esc(absDate(iso))}</time>
            </span>
          </span>
        </div>
        <div class="c-body">${sanitizeCommentHtml(String(c.content || ''))}</div>
        ${foot}
      </div>
      ${childReplies.length
        ? `<div class="c-kids">${childReplies.map((r: any) => renderComment(r, c.name || 'Anonymous')).join('')}</div>`
        : ''}
    `;
  };

  return `<div class="c-thread">${top.map((c: any) => renderComment(c)).join('')}</div>`;
}

// ── delegated thread interactions (bind once, survive re-render) ──
function bindThread(list: HTMLElement) {
  if (list.dataset.bound) return;
  list.dataset.bound = '1';
  list.addEventListener('click', (e) => {
    const t = e.target as Element;
    const b = t.closest && t.closest('button') as HTMLElement | null;
    if (!b || !list.contains(b)) return;
    if (b.classList.contains('c-react')) { toggleReact(b); return; }
    if (b.classList.contains('c-react-sum')) { togglePicker(b); return; }
    if (b.classList.contains('reply-btn')) { openReply(b); return; }
    if (b.classList.contains('c-share')) {
      const id = b.dataset.id || '';
      const url = `${location.origin}${location.pathname}#comment-${id}`;
      copyText(url).then(ok => flash(b as HTMLElement, ok ? 'Copied' : 'Copy failed', 1600));
      return;
    }
    if (b.classList.contains('c-report-btn')) {
      const item = b.closest('.c-item');
      const panel = item && item.querySelector('.c-report') as HTMLElement | null;
      if (panel) { panel.hidden = !panel.hidden; b.setAttribute('aria-expanded', String(!panel.hidden)); }
      return;
    }
    if (b.classList.contains('c-rep-go')) { sendReport(b); return; }
    if (b.classList.contains('c-rep-x')) {
      const panel = b.closest('.c-report') as HTMLElement | null;
      const item = b.closest('.c-item');
      const rb = item && item.querySelector('.c-report-btn') as HTMLElement | null;
      if (panel) panel.hidden = true;
      if (rb) { rb.setAttribute('aria-expanded', 'false'); rb.focus(); }
      return;
    }
  });
}

// ── pending own-comment ghost row (D13 / P8) — session-only, honest ──
function addPendingRow(name: string, content: string) {
  const list = $('comments-list'); if (!list) return;
  let thread = list.querySelector('.c-thread') as HTMLElement | null;
  if (!thread) { // empty thread until now — seed the rail and drop the empty note
    list.innerHTML = '';
    thread = document.createElement('div');
    thread.className = 'c-thread';
    list.appendChild(thread);
  }
  const div = document.createElement('div');
  div.className = 'c-item is-pending';
  const safe = esc(name || 'Anonymous');
  div.innerHTML =
    `<div class="c-meta">` +
      `<span class="c-avatar is-ghost" aria-hidden="true" style="background:${AV_BG[avHash(safe) % AV_BG.length]}">${esc(initials(name || 'Anonymous'))}</span>` +
      `<span class="c-headline"><span class="c-name">${safe}</span>` +
      `<span class="c-sub"><span class="c-badge c-pend-chip">AWAITING REVIEW</span>` +
      `<time class="c-date" data-ts="${esc(new Date().toISOString())}" datetime="${esc(new Date().toISOString())}">just now</time></span></span>` +
    `</div>` +
    `<div class="c-body">${esc(content).replace(/\n/g, '<br>')}</div>`;
  thread.appendChild(div);
  stampTimes(div);
  try { div.scrollIntoView({ block: 'nearest' }); } catch { div.scrollIntoView(); }
}

// ── states: loading → empty | list | error(retry) ──
let lastComments: any[] | null = null;

async function loadComments() {
  const list = $('comments-list'), loading = $('comments-loading'), err = $('comments-error');
  show(loading); if (loading) loading.setAttribute('aria-busy', 'true');
  show(err, false); show(list, false);
  try {
    const author = section?.dataset.author || '';
    const qs = `?post=${encodeURIComponent(postId)}${author ? '&author=' + encodeURIComponent(author) : ''}`;
    const res = await fetch(API + qs, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(String(res.status));
    const data = await res.json();
    const comments = Array.isArray(data) ? data : (data.comments || []);
    lastComments = comments;
    show(loading, false); if (loading) loading.setAttribute('aria-busy', 'false');
    if (!comments.length) {
      if (list) list.innerHTML = '<p class="c-empty">No comments yet — the first one is yours. New posts are held for review before they appear.</p>';
      show(list);
    } else {
      if (list) {
        restoreFormHome();            // never strand the form in a re-rendered slot
        document.querySelectorAll('.comments .c-item.has-form').forEach(el => el.classList.remove('has-form'));
        list.innerHTML = renderThread(comments);
        bindThread(list);
        stampTimes(list);
        show(list);
      }
    }
    show($('comments-form'));
  } catch {
    show(loading, false); if (loading) loading.setAttribute('aria-busy', 'false');
    show(err);
    ($('retry-comments') as HTMLButtonElement | null)?.focus();
  }
}

// ── live count probe (brief §3b / P1) — one tiny GET, only when the reader ──
// ── reaches the section (IntersectionObserver, 200px lead). Silent on fail. ──
function patchCount(n: number) {
  const btn = $('load-comments-btn');
  if (btn && !btn.hidden) {
    btn.innerHTML = n > 0
      ? `Read the <span class="cnt">${n}</span>&nbsp;comments`
      : `Be the first to comment`;
  }
  const side = section && section.querySelector('.s-side');
  if (side) side.textContent = n > 0 ? `${n} approved · new posts held for review` : 'New posts held for review';
  // article meta live-count hook (data-live-count added in [...slug].astro)
  document.querySelectorAll(`[data-live-count="${postId}"]`).forEach(el => {
    const num = el.querySelector('.lc-n'), lbl = el.querySelector('.lc-l');
    if (num) num.textContent = String(n);
    if (lbl) lbl.textContent = n === 1 ? 'comment' : 'comments';
  });
}
function fetchCount() {
  fetch(`${API}/count?post=${encodeURIComponent(postId)}`, { headers: { accept: 'application/json' } })
    .then(r => (r.ok ? r.json() : null))
    .then(d => { if (d && typeof d.count === 'number') patchCount(d.count); })
    .catch(() => { /* baked value stays — never error for a cosmetic number */ });
}
if (section) {
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const ent of entries) {
        if (ent.isIntersecting) { io.disconnect(); fetchCount(); break; }
      }
    }, { rootMargin: '200px 0px' });
    io.observe(section);
  } else {
    fetchCount();
  }
}

// ── form: validate → POST → per-code handling (brief §4.3) ──
function setMsg(text: string, ok = false, field?: HTMLElement | null) {
  const msg = $('form-msg');
  if (msg) {
    msg.textContent = text;
    msg.className = ok ? 'c-msg-ok' : 'c-err'; // term strip vs mono-deep error
  }
  if (field) field.focus();
}

function countdown(btn: HTMLButtonElement, secs: number) {
  btn.disabled = true;
  btn.dataset.cd = '1';
  let left = secs;
  const label = 'Post Comment';
  const tick = () => {
    if (left > 0) { btn.textContent = `Wait ${left}s`; left--; setTimeout(tick, 1000); }
    else { btn.textContent = label; btn.disabled = false; delete btn.dataset.cd; }
  };
  tick();
}

function clearReply() {
  const parent = $('c-parent') as HTMLInputElement;
  if (parent) parent.value = '0';
  show($('reply-indicator'), false);
  restoreFormHome();
  if (movedCard) movedCard.classList.remove('has-form');
  document.querySelectorAll('.comments .c-item.has-form').forEach(el => el.classList.remove('has-form'));
  movedCard = null;
}

function updateCount() {
  const ta = $('c-content') as HTMLTextAreaElement | null;
  const el = $('c-count');
  if (!ta || !el) return;
  const n = ta.value.length;
  el.textContent = n >= 3500 ? `${n} / 5000` : '';
}

document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form    = e.target as HTMLFormElement;
  const name    = ($('c-name')    as HTMLInputElement).value.trim();
  const email   = ($('c-email')   as HTMLInputElement).value.trim();
  const url     = ($('c-url')     as HTMLInputElement).value.trim();
  const content = ($('c-content') as HTMLTextAreaElement).value.trim();
  const parent  = ($('c-parent')  as HTMLInputElement).value;
  const hp      = ($('c-hp')      as HTMLInputElement).value;
  const consent = ($('c-consent') as HTMLInputElement).checked;
  const notify  = ($('c-notify')  as HTMLInputElement).checked;

  if (hp) { setMsg('Submission failed.', false, null); form.reset(); return; } // bot: silent discard
  if (!name || name.length < 2 || name.length > 100) { setMsg('Name is required (2–100 characters).', false, $('c-name')); return; }
  if (url && !/^https?:\/\//i.test(url)) { setMsg('Website must start with http:// or https://', false, $('c-url')); return; }
  if (!content || content.length > 5000) { setMsg('Comment must be between 1 and 5000 characters.', false, $('c-content')); return; }
  if (!consent) { setMsg('Please tick the comments-policy box first.', false, $('c-consent')); return; }
  if (notify && !email) { setMsg('Add your email to receive reply notices.', false, $('c-email')); return; }

  setMsg('Posting...', true);
  const submitBtn = $('c-submit') as HTMLButtonElement;
  if (submitBtn) submitBtn.disabled = true;

  try {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId: Number(postId), postSlug: section?.dataset.postSlug || '',
        name, email, url, content, parent,
        honeypot: hp, consent, notify,
      }),
    });
    const data = await res.json().catch(() => ({} as any));

    if (res.status === 201) {
      const wasPending = data.status !== 'approved';
      form.reset();
      clearReply(); // restores the form to the bottom before anything re-renders
      updateCount();
      if (!wasPending) {
        loadComments(); // refresh just this post's thread (no reload, no polling)
        setMsg('Posted — live in the thread above.', true);
      } else {
        addPendingRow(name, content); // ghost row: your words are held, not lost
        setMsg('Posted — awaiting moderation. It’ll appear once the editor approves.', true);
      }
    } else if (res.status === 400) {
      const field = /name/i.test(data.message || '') ? $('c-name')
        : /url|website/i.test(data.message || '') ? $('c-url')
        : /comment|content/i.test(data.message || '') ? $('c-content') : null;
      setMsg(data.message || 'Please check the highlighted field.', false, field as HTMLElement);
    } else if (res.status === 429) {
      const ra = Number(res.headers.get('retry-after') || data.retryAfter || 60);
      setMsg(data.message || 'Too many comments — try again shortly.', false);
      if (submitBtn) countdown(submitBtn, Math.min(300, Math.max(1, ra)));
    } else {
      // keep the typed draft — never lose a reader's text
      setMsg(data.message || 'Failed to post comment.', false, submitBtn);
    }
  } catch {
    setMsg('Network error — your text is kept, please try again.', false, $('c-submit'));
  } finally {
    if (submitBtn && !submitBtn.dataset.cd) submitBtn.disabled = false;
  }
});

$('c-content')?.addEventListener('input', updateCount);

// ── idle → first click only. ONE count probe when the reader reaches us. ──
const loadBtn = $('load-comments-btn');
const inner   = $('comments-inner');
if (loadBtn && inner) {
  loadBtn.addEventListener('click', () => {
    loadBtn.hidden = true;
    inner.hidden = false;
    loadComments();
  });
}
$('retry-comments')?.addEventListener('click', () => loadComments());
</script>

