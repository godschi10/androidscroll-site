---
// Comments — click-to-load, zero third-party JS, Worker rail (brief §4).
// v0.5.1: full "terminal editorial" blend per DESIGN-RESEARCH.md PART 4.
//   section.comments.col mount · rule-s divider · qa-box card anatomy ·
//   t-mono-av monograms (deterministic brand-green bg) · SVG reaction pills
//   (bespoke geometry — no emoji chrome, no third-party icons) · notify-form
//   fields (mint dark-mode) · btn-deep submit · .term honest moderation strip.
// States: idle → loading (skeleton) → empty | list | error (retry).
interface Props {
  postId: number;            // REQUIRED — WP post id
  postSlug?: string;         // analytics/moderation context
  authorName?: string;       // post author display name → is_author badge match
  initialCount?: number;     // build-time count, rendered in the button label
  policyUrl?: string;        // default '/comments-policy'
  apiBase?: string;          // Worker origin — one constant to roll back
}
const {
  postId,
  postSlug = '',
  authorName = '',
  initialCount,
  policyUrl = '/comments-policy',
  apiBase = 'https://androidscroll-comments.gwill.workers.dev',
} = Astro.props;
const hasCount = typeof initialCount === 'number' && initialCount > 0;
---

<section class="comments col" id="comments-section" data-post-id={postId} data-post-slug={postSlug}
  data-author={authorName} data-api={apiBase} aria-labelledby="comments-h">
  <div class="rule-s">
    <span class="s-no">§</span>
    <h2 id="comments-h">Comments</h2>
    <span class="s-side">{hasCount ? `${initialCount} approved · new posts held for review` : 'New posts held for review'}</span>
  </div>

  <button id="load-comments-btn" type="button">
    {hasCount
      ? <>Read the <span class="cnt">{initialCount}</span>&nbsp;comments</>
      : <>Be the first to comment</>}
  </button>
  <noscript><p class="c-noscript">Comments require JavaScript — read our
    <a href={policyUrl}>comments policy</a>.</p></noscript>

  <div id="comments-inner" hidden>
    <div id="comments-loading" aria-busy="true">
      <div class="c-skel"></div><div class="c-skel"></div><div class="c-skel"></div>
    </div>
    <div id="comments-error" hidden>
      <p class="c-err-msg" role="alert">Couldn't load comments — the thread service didn't answer.</p>
      <button id="retry-comments" type="button">Retry</button>
    </div>
    <div id="comments-list" hidden></div>

    <div id="comments-form" hidden>
      <div class="c-form-card">
        <div class="kicker-h">Leave a comment</div>
        <!-- v0.5.2 reply banner: sits ABOVE the fields so the context is seen
             the instant Reply is tapped (focus law: banner + textarea in view).
             role=status announces "Replying to {name}" to SRs. Cancel × restores
             top-level and returns focus to the originating Reply button. -->
        <div id="reply-indicator" hidden role="status">
          <span class="c-re-mark" aria-hidden="true">↳</span>
          <span class="c-reply-txt">Replying to <strong id="reply-name"></strong></span>
          <button type="button" id="cancel-reply">Cancel <span aria-hidden="true">×</span></button>
        </div>
        <form id="comment-form">
          <div class="comment-form-grid">
            <div class="c-field">
              <label for="c-name">Name <span class="c-req">*</span></label>
              <input id="c-name" name="name" type="text" required minlength="2" maxlength="100" autocomplete="name" />
            </div>
            <div class="c-field">
              <label for="c-email">Email <span class="c-opt">(optional — needed only for reply notices)</span></label>
              <input id="c-email" name="email" type="email" maxlength="254" autocomplete="email" />
            </div>
          </div>
          <div class="c-field">
            <label for="c-url">Website <span class="c-opt">(optional)</span></label>
            <input id="c-url" name="url" type="url" maxlength="200" inputmode="url" autocomplete="url" placeholder="https://…" />
          </div>
          <div class="c-field">
            <label for="c-content">Comment <span class="c-req">*</span></label>
            <textarea id="c-content" name="content" rows="4" required maxlength="5000" aria-describedby="c-count"></textarea>
            <span id="c-count" class="c-count" aria-live="polite"></span>
          </div>
          <input id="c-parent" name="parent" type="hidden" value="0" />
          <!-- v0.5.2: old in-form reply indicator REMOVED — it duplicated the
               banner IDs above the fields (getElementById hit the banner first,
               this block was dead markup). Single source: the banner. -->
          <!-- honeypot: bots fill it, humans never see it (mirrors vibe_hp) -->
          <div class="c-hp" aria-hidden="true"><label for="c-hp">Leave this empty</label><input id="c-hp" name="honeypot" type="text" tabindex="-1" autocomplete="off" /></div>
          <!-- v0.5.1 (3b.3): NO required attr — the JS guard owns feedback so the
               inline .c-err message always shows (Safari's bubble blocked submit silently). -->
          <p class="c-check"><label><input id="c-consent" name="consent" type="checkbox" /> I agree to the <a href={policyUrl} target="_blank" rel="noopener">comments policy</a>. <span class="c-req">*</span></label></p>
          <p class="c-check"><label><input id="c-notify" name="notify" type="checkbox" /> Email me when someone replies.</label></p>
          <button type="submit" id="c-submit" class="btn-deep">Post Comment</button>
          <p id="form-msg" aria-live="polite" role="status"></p>
          <p class="n-note">Held for review first — approved comments appear here and by email reply notices go to the thread followers.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
const section = document.getElementById('comments-section') as HTMLElement;
const postId  = section?.dataset.postId || '';
const API     = (section?.dataset.api || '') + '/api/comments';

const ALLOWED_COMMENT_TAGS = new Set([
  'a','b','strong','i','em','u','s','p','br','ul','ol','li',
  'blockquote','pre','code','span','del','ins'
]);

const ALLOWED_COMMENT_ATTRS: Record<string, Set<string>> = {
  'a':   new Set(['href', 'title', 'rel', 'target']),
  '*':   new Set(['class']),
};

// XSS boundary — unchanged (DESIGN-RESEARCH §4.12.4): template round-trip.
function sanitizeCommentHtml(html: string): string {
  const tpl = document.createElement('template');
  tpl.innerHTML = html;
  sanitizeNode(tpl.content);
  return tpl.innerHTML;
}

function sanitizeNode(node: Node): void {
  const remove: Node[] = [];
  node.childNodes.forEach(child => {
    if (child.nodeType === Node.ELEMENT_NODE) {
      const el = child as Element;
      const tag = el.tagName.toLowerCase();
      if (!ALLOWED_COMMENT_TAGS.has(tag)) {
        node.insertBefore(document.createTextNode(el.textContent || ''), child);
        remove.push(child);
        return;
      }
      const drop: string[] = [];
      for (const attr of Array.from(el.attributes)) {
        const n = attr.name.toLowerCase();
        const tagAllowed  = ALLOWED_COMMENT_ATTRS[tag] ?? new Set<string>();
        const globAllowed = ALLOWED_COMMENT_ATTRS['*'] ?? new Set<string>();
        if (!tagAllowed.has(n) && !globAllowed.has(n)) { drop.push(attr.name); continue; }
        if (/^on/i.test(n)) { drop.push(attr.name); continue; }
        if (n === 'href' && /^\s*(javascript|data|vbscript):/i.test(attr.value)) {
          drop.push(attr.name); continue;
        }
      }
      drop.forEach(a => el.removeAttribute(a));
      if (tag === 'a') {
        el.setAttribute('rel', 'noopener noreferrer nofollow');
        if (/^https?:/i.test(el.getAttribute('href') || '')) el.setAttribute('target', '_blank');
      }
      sanitizeNode(el);
    } else if (child.nodeType === Node.COMMENT_NODE) {
      remove.push(child);
    }
  });
  remove.forEach(n => node.removeChild(n));
}

function esc(str: string): string {
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}

const $ = (id: string) => document.getElementById(id);
const show = (el: HTMLElement | null, on = true) => { if (el) el.hidden = !on; };

// ── monogram avatar (t-mono-av house component — §4.3) ──
// Deterministic bg among the 4 brand greens only: deep, teal, deeper, verdict.
const AV_BG = ['var(--deep)', 'var(--teal)', 'var(--deeper)', 'var(--verdict)'];
function avHash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h;
}
function avatarBg(c: any): string {
  return c.is_author ? AV_BG[0] : AV_BG[avHash(String(c.name || '')) % AV_BG.length];
}
function initials(name: string): string {
  const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
  if (!parts.length) return 'A';
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

// ── reactions: BESPOKE inline SVG (King law: geometry, not emoji; zero DNA ──
// ── from vibe-comments; house line idiom = stroke currentColor, square caps ──
const REACTIONS = [['like', 'Like'], ['heart', 'Heart'], ['fire', 'Fire'], ['laugh', 'Laugh']] as const;
const REACT_SVG: Record<string, string> = {
  // thumbs-up: straight-line palm + cuff (site idiom, no curves but the shoulder arc)
  like: '<path d="M8.6 20.4V11l5-8.2c2 0 3.2 1.2 3.2 3.2l-.6 3.4h4c1.6 0 2.6 1.2 2.4 2.6l-1.2 6.4c-.2 1.2-1.2 2-2.4 2H8.6Z"/><path d="M3.6 11.6h5v8.8h-5z"/>',
  // heart: classic symmetric silhouette — two semicircular arcs (r=6.3) meeting
  // in a top cleft and a sharp bottom point; same stroke weight as like/fire
  heart: '<path d="M12 20.2 5.7 13.5a6.3 6.3 0 0 1 12.6 0Z"/>',
  // flame: angular outline + diamond core
  fire: '<path d="M12 2.8 16.2 9.4l1.6-1.6c1.6 2 2.6 4 2.6 6.2a8.4 8.4 0 1 1-16.8 0c0-2.2 1-4.2 2.6-6.2l1.6 1.6L12 2.8Z"/><path d="M12 11.4 14.8 15.4 12 19.4 9.2 15.4Z"/>',
  // laugh: grinning face — squint-eye chevrons (∧ ∧, the laughing read) + wide
  // filled open-grin; fewer strokes than slit-eyes version = crisper at 13-14px
  laugh: '<circle cx="12" cy="12" r="8.6"/><path d="M7.2 10.4 9.3 8.6l2.1 1.8M12.6 10.4l2.1-1.8 2.1 1.8"/><path d="M7.6 13.6h8.8a4.4 4.4 0 0 1-8.8 0Z" fill="currentColor" stroke="none"/>',
};
const reactIcon = (k: string) =>
  '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + (REACT_SVG[k] || '') + '</svg>';

function reactionBar(c: any): string {
  const r = c.reactions || {};
  return `<div class="c-reactions">` + REACTIONS.map(([k, label]) => {
    const n = r[k] || 0;
    return `<button type="button" class="c-react" data-id="${esc(String(c.id))}" data-emoji="${k}"`
      + ` aria-pressed="false" aria-label="${label}${n ? ', ' + n + ' so far' : ''}">`
      + reactIcon(k) + `<span class="c-react-n">${n || ''}</span></button>`;
  }).join('') + `</div>`;
}

async function toggleReact(btn: HTMLElement) {
  if (btn.dataset.busy) return;
  btn.dataset.busy = '1';
  try {
    const res = await fetch(`${API}/${encodeURIComponent(btn.dataset.id || '')}/react`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ emoji: btn.dataset.emoji, postId: Number(postId) }),
    });
    if (!res.ok) return;
    const data = await res.json();
    const bar = btn.parentElement as HTMLElement;
    bar.querySelectorAll('.c-react').forEach(b => {
      const el = b as HTMLElement, n = el.querySelector('.c-react-n');
      const count = (data.counts && data.counts[el.dataset.emoji || '']) || 0;
      el.setAttribute('aria-pressed', String(b === btn ? !!data.active : false));
      if (n) n.textContent = count ? String(count) : '';
    });
  } catch { /* counts stay as loaded — never block the reader */ }
  finally { delete btn.dataset.busy; }
}

// ── render: 1-level threading (CodingHorror law — §4.6) ──
function renderThread(comments: any[]): string {
  const top     = comments.filter((c: any) => !c.parent);
  const replies = comments.filter((c: any) => c.parent);

  const renderComment = (c: any, replyToName = ''): string => {
    const safeName = esc(c.name || 'Anonymous');
    const safeDate = esc(new Date(c.created_at).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }));
    const linkOpen  = c.url ? `<a href="${esc(c.url)}" rel="nofollow noopener noreferrer" target="_blank">` : '';
    const linkClose = c.url ? '</a>' : '';
    const childReplies = replies.filter((r: any) => r.parent === c.id);
    const replyMark = replyToName
      ? `<div class="c-re-line"><span class="c-re-mark" aria-hidden="true">↳</span> re: ${esc(replyToName)}</div>`
      : '';
    return `
      <div class="c-item${replyToName ? ' c-reply' : ''}${c.is_author ? ' c-by-author' : ''}">
        ${replyMark}
        <div class="c-meta">
          <span class="c-avatar" aria-hidden="true" style="background:${avatarBg(c)}">${esc(initials(c.name || 'Anonymous'))}</span>
          <span class="c-headline">
            <span class="c-name-wrap">${linkOpen}<span class="c-name">${safeName}</span>${linkClose}</span>
            <span class="c-sub">
              ${c.is_author ? '<span class="c-badge">★ AUTHOR</span>' : ''}
              <time class="c-date" datetime="${esc(String(c.created_at || ''))}">${safeDate}</time>
            </span>
          </span>
        </div>
        <div class="c-body">${sanitizeCommentHtml(String(c.content || ''))}</div>
        ${reactionBar(c)}
        <button class="reply-btn" data-id="${esc(String(c.id))}" data-name="${safeName}" type="button">Reply</button>
      </div>
      ${childReplies.length
        ? `<div class="c-kids">${childReplies.map((r: any) => renderComment(r, c.name || 'Anonymous')).join('')}</div>`
        : ''}
    `;
  };

  return top.map((c: any) => renderComment(c)).join('');
}

function bindThread(list: HTMLElement) {
  list.querySelectorAll('.reply-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id   = (btn as HTMLElement).dataset.id;
      const name = (btn as HTMLElement).dataset.name;
      const parent = $('c-parent') as HTMLInputElement;
      if (parent) parent.value = id || '0';
      const indicator = $('reply-indicator');
      const replyName = $('reply-name');
      if (indicator && replyName) {
        replyName.textContent = name || '';
        indicator.hidden = false;
      }
      (window as any).__replyBtn = btn;
      ($('c-content') as HTMLTextAreaElement)?.focus();
    });
  });
  list.querySelectorAll('.c-react').forEach(b =>
    b.addEventListener('click', () => toggleReact(b as HTMLElement)));
}

// ── states: loading → empty | list | error(retry) ──
let lastComments: any[] | null = null;

async function loadComments() {
  const list = $('comments-list'), loading = $('comments-loading'), err = $('comments-error');
  show(loading); if (loading) loading.setAttribute('aria-busy', 'true');
  show(err, false); show(list, false);
  try {
    const author = section?.dataset.author || '';
    const qs = `?post=${encodeURIComponent(postId)}${author ? '&author=' + encodeURIComponent(author) : ''}`;
    const res = await fetch(API + qs, { headers: { accept: 'application/json' } });
    if (!res.ok) throw new Error(String(res.status));
    const data = await res.json();
    const comments = Array.isArray(data) ? data : (data.comments || []);
    lastComments = comments;
    show(loading, false); if (loading) loading.setAttribute('aria-busy', 'false');
    if (!comments.length) {
      if (list) list.innerHTML = '<p class="c-empty">No comments yet — the first one is yours. New posts are held for review before they appear.</p>';
      show(list);
    } else {
      if (list) {
        list.innerHTML = renderThread(comments);
        bindThread(list);
        show(list);
      }
    }
    show($('comments-form'));
  } catch {
    show(loading, false); if (loading) loading.setAttribute('aria-busy', 'false');
    show(err);
    ($('retry-comments') as HTMLButtonElement | null)?.focus();
  }
}

// ── form: validate → POST → per-code handling (brief §4.3) ──
function setMsg(text: string, ok = false, field?: HTMLElement | null) {
  const msg = $('form-msg');
  if (msg) {
    msg.textContent = text;
    msg.className = ok ? 'c-msg-ok' : 'c-err'; // term strip vs mono-deep error (v0.5.1 §4.8)
  }
  if (field) field.focus();
}

function countdown(btn: HTMLButtonElement, secs: number) {
  btn.disabled = true;
  btn.dataset.cd = '1';
  let left = secs;
  const label = 'Post Comment';
  const tick = () => {
    if (left > 0) { btn.textContent = `Wait ${left}s`; left--; setTimeout(tick, 1000); }
    else { btn.textContent = label; btn.disabled = false; delete btn.dataset.cd; }
  };
  tick();
}

function clearReply() {
  const parent = $('c-parent') as HTMLInputElement;
  if (parent) parent.value = '0';
  show($('reply-indicator'), false);
}

function updateCount() {
  const ta = $('c-content') as HTMLTextAreaElement | null;
  const el = $('c-count');
  if (!ta || !el) return;
  const n = ta.value.length;
  el.textContent = n >= 3500 ? `${n} / 5000` : '';
}

document.getElementById('comment-form')?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const form    = e.target as HTMLFormElement;
  const name    = ($('c-name')    as HTMLInputElement).value.trim();
  const email   = ($('c-email')   as HTMLInputElement).value.trim();
  const url     = ($('c-url')     as HTMLInputElement).value.trim();
  const content = ($('c-content') as HTMLTextAreaElement).value.trim();
  const parent  = ($('c-parent')  as HTMLInputElement).value;
  const hp      = ($('c-hp')      as HTMLInputElement).value;
  const consent = ($('c-consent') as HTMLInputElement).checked;
  const notify  = ($('c-notify')  as HTMLInputElement).checked;

  if (hp) { setMsg('Submission failed.', false, null); form.reset(); return; } // bot: silent discard
  if (!name || name.length < 2 || name.length > 100) { setMsg('Name is required (2–100 characters).', false, $('c-name')); return; }
  if (url && !/^https?:\/\//i.test(url)) { setMsg('Website must start with http:// or https://', false, $('c-url')); return; }
  if (!content || content.length > 5000) { setMsg('Comment must be between 1 and 5000 characters.', false, $('c-content')); return; }
  if (!consent) { setMsg('Please tick the comments-policy box first.', false, $('c-consent')); return; }
  if (notify && !email) { setMsg('Add your email to receive reply notices.', false, $('c-email')); return; }

  setMsg('Posting...', true);
  const submitBtn = $('c-submit') as HTMLButtonElement;
  if (submitBtn) submitBtn.disabled = true;

  try {
    const res = await fetch(API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        postId: Number(postId), postSlug: section?.dataset.postSlug || '',
        name, email, url, content, parent,
        honeypot: hp, consent, notify,
      }),
    });
    const data = await res.json().catch(() => ({} as any));

    if (res.status === 201) {
      form.reset();
      clearReply();
      updateCount();
      if (data.status === 'approved') {
        // refresh just this post's thread (brief §4.2.5 — no whole-page reload, no polling)
        loadComments();
        setMsg('Posted — live in the thread above.', true);
      } else {
        setMsg('Posted — awaiting moderation. It’ll appear once the editor approves.', true);
      }
    } else if (res.status === 400) {
      const field = /name/i.test(data.message || '') ? $('c-name')
        : /url|website/i.test(data.message || '') ? $('c-url')
        : /comment|content/i.test(data.message || '') ? $('c-content') : null;
      setMsg(data.message || 'Please check the highlighted field.', false, field as HTMLElement);
    } else if (res.status === 429) {
      const ra = Number(res.headers.get('retry-after') || data.retryAfter || 60);
      setMsg(data.message || 'Too many comments — try again shortly.', false);
      if (submitBtn) countdown(submitBtn, Math.min(300, Math.max(1, ra)));
    } else {
      // keep the typed draft — never lose a reader's text
      setMsg(data.message || 'Failed to post comment.', false, submitBtn);
    }
  } catch {
    setMsg('Network error — your text is kept, please try again.', false, $('c-submit'));
  } finally {
    if (submitBtn && !submitBtn.dataset.cd) submitBtn.disabled = false;
  }
});

document.getElementById('cancel-reply')?.addEventListener('click', () => {
  clearReply();
  const btn = (window as any).__replyBtn as HTMLElement | null;
  if (btn) btn.focus(); // return focus to the Reply button (WCAG 2.4.3)
});

$('c-content')?.addEventListener('input', updateCount);

// ── idle → first click only. Zero requests until intent, no polling. ──
const loadBtn = $('load-comments-btn');
const inner   = $('comments-inner');
if (loadBtn && inner) {
  loadBtn.addEventListener('click', () => {
    loadBtn.hidden = true;
    inner.hidden = false;
    loadComments();
  });
}
$('retry-comments')?.addEventListener('click', () => loadComments());
</script>

<style is:global>
/* v0.5.1 — terminal-editorial blend. Every selector namespaced under .comments;
   brand tokens only (DESIGN-RESEARCH PART 1:20-39). The old alien-token block
   (--border-light/--brand-primary/--radius-main/...) is dead — no UA fallbacks left. */
.comments{margin-top:clamp(28px,5vh,44px)}
.comments .c-noscript{font-family:var(--mono);font-size:11px;color:var(--muted)}
.comments .c-noscript a{color:var(--deep)}

/* load control — .launch/.btn-ghost voice (§4.10/:670) */
.comments #load-comments-btn{display:flex;width:fit-content;align-items:center;gap:9px;font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--deep);background:var(--paper);border:1px solid var(--deep);padding:11px 16px;border-radius:2px;min-height:44px;cursor:pointer;margin:2px 0 18px;transition:background-color .16s ease-out}
.comments #load-comments-btn:hover{background:var(--band);text-decoration:none}
.comments #load-comments-btn .cnt{margin:0 2px}
.comments #comments-inner{margin-top:4px}

/* skeleton — .slot-frame dashed idiom (§4.9/:238) */
.comments .c-skel{height:72px;border:1px dashed var(--line-2);background:var(--band);border-radius:4px;margin-bottom:12px;animation:c-pulse 1.2s ease-in-out infinite}
@keyframes c-pulse{50%{opacity:.5}}
@media (prefers-reduced-motion: reduce){.comments .c-skel{animation:none}}

/* error/retry — .term box + .btn-ghost (§4.9) */
.comments #comments-error{background:var(--band);border:1px solid var(--line-2);border-left:3px solid var(--deep);padding:11px 14px;margin-bottom:16px}
.comments .c-err-msg{font-family:var(--mono);font-size:12px;color:var(--ink-2);margin:0 0 10px;line-height:1.5}
