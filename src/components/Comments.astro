/* skeleton — structured 2 rows: 36px avatar square + 2 bars (§4.7 / D12) */
.comments .c-skel-row{display:flex;gap:12px;align-items:flex-start;border:1px dashed var(--line-2);background:var(--band);border-radius:4px;padding:14px 16px;margin-bottom:10px;animation:c-pulse 1.2s ease-in-out infinite}
.comments .sk-av{flex:none;width:36px;height:36px;background:var(--band-2);border-radius:2px}
