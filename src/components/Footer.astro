---
/* Footer v2.4 — D3 MAGAZINE KEEPER (King verdict, Sep 11).
   C1 wordmark nameplate (eyes pinned open), honest alerts link (no stub form),
   capped pillar sitemap + The paper in the brand block, legal lives in the
   bottom bar dots. Deep-verdict band, mint type. */
import Wordmark from './Wordmark.astro';
import SocialRow from './SocialRow.astro';
import { SOCIAL_BRAND } from '../data/socials';
import { SITE, PILLARS, POSTS, TOTALS, postsIn, postsDirect } from '../data/site';
const latest3 = POSTS.slice(0, 3);
const year = 2026;
const started = POSTS.reduce((min, p) => p.date < min ? p.date : min, POSTS[0].date).slice(0, 4);
/* sitemap columns: pillars with live posts, capped to 3 visual columns (digest trait 2);
   children capped at 6 (digest: 4–7 links). Empty shelves (buying-guides today) stay
   reachable via the Browse sheet until they have posts. */
const footPillars = PILLARS
  .map(p => ({ ...p, real: postsIn(p).length }))
  .filter(p => p.real > 0)
  .slice(0, 3);
---
<footer class="site-footer" id="colophon">
  <div class="foot-in">
    <div class="foot-grid">
      <div class="foot-col foot-brand">
        <a class="nameplate" href="/" aria-label="AndroidScroll — home">
          <Wordmark />
        </a>
        <p>{SITE.tagline} Built as a static publication: Astro on the edge, no trackers without your consent.</p>
        <p class="foot-alerts"><a href="/contact/">Get launch alerts — tell us where to reach you →</a></p>
        <!-- v0.6.10: nine brand accounts, inline icons, optical-law scaled -->
        <div class="foot-social">
          <span class="soc-kicker">Follow AndroidScroll</span>
          <SocialRow items={SOCIAL_BRAND} label="AndroidScroll on social media" variant="foot" />
        </div>
      </div>

      <!-- v2.7: The paper lifted OUT of the brand block — it's a grid sibling now,
           so mobile gets a true 2x2 (paper + pillars beside each other). King's call. -->
      <nav class="foot-col foot-paper" aria-label="The paper">
        <h4>The paper</h4>
        <ul>
          <li><a href="/start-here/"><span>Start here</span></a></li>
          <li><a href="/about/"><span>About AndroidScroll</span></a></li>
          <li><a href="/how-we-test/"><span>How we test</span></a></li>
          <li><a href="/contact/"><span>Contact the desk</span></a></li>
          <li><a href="/latest/"><span>Latest {TOTALS.posts} guides</span></a></li>
        </ul>
      </nav>

      {footPillars.map(p => (
        <nav class="foot-col" aria-label={p.name}>
          <h4>{p.name}</h4>
          <ul>
            <li><a href={p.path}><span>All {p.name.toLowerCase()}</span></a></li>
            {p.children.slice(0, 6).map(k => (
              <li><a href={k.path}><span>{k.name}</span><span class="cnt">{postsDirect(k).length}</span></a></li>
            ))}
            {p.children.length === 0 && latest3.filter(x => x.root_slug === p.slug).map(x => (
              <li><a href={x.url}><span>{x.title.length > 34 ? x.title.slice(0, 34) + '…' : x.title}</span></a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="foot-bar">
      <span>© {started}–{year} AndroidScroll.com</span>
      <span class="sep">·</span>
      <nav class="foot-legal" aria-label="Legal">
        <a href="/privacy-policy/"><span>Privacy</span></a><span class="sep" aria-hidden="true">·</span>
        <a href="/cookie-policy/"><span>Cookie</span></a><span class="sep" aria-hidden="true">·</span>
        <a href="/disclaimer/"><span>Disclaimer</span></a><span class="sep" aria-hidden="true">·</span>
        <a href="/comments-policy/"><span>Comments</span></a>
      </nav>
      <span class="sep">·</span>
      <span class="matomo-note">Self-hosted Matomo · consent-only · no third-party trackers</span>
      <a class="foot-top" href="#top">Back to top ↑</a>
    </div>
  </div>
</footer>

<script type="module">
  const toast = document.getElementById('toast');
  /* v2.5 back-to-top: href="#top" is the no-JS fallback; JS owns the jump so it
     works in every engine (native anchor jumps are flaky on some builds). */
  const topLink = document.querySelector('.foot-top');
  if (topLink) topLink.addEventListener('click', e => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    try { history.replaceState(null, '', location.pathname + location.search); } catch {}
  });
  /* stub-form handler stays: / and category pages still ship honest on-device stubs */
  document.querySelectorAll('form[data-stub]').forEach(f => {
    f.addEventListener('submit', e => {
      e.preventDefault();
      const inp = f.querySelector('input');
      if (inp.value && inp.checkValidity()) {
        toast.textContent = 'Noted — launch alerts stub registered on this device. (Prototype: no data leaves the page.)';
        inp.value = '';
      } else {
        toast.textContent = 'Enter a valid email to be notified.';
      }
      toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 2800);
    });
  });
</script>
