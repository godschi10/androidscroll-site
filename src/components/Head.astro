---
// Head — meta/OG per page, inline design tokens for flash-free theme.
import { SITE } from '../data/site';
import { THEME_COLORS } from '../data/theme-colors';
const props = Astro.props;
const canonical = SITE.url + Astro.url.pathname;
const title = props.title ? `${props.title} — ${SITE.name}` : `${SITE.name} — ${props.desc || SITE.tagline}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={props.desc || SITE.tagline} />
<link rel="canonical" href={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={props.title || SITE.name} />
<meta property="og:description" content={props.desc || SITE.tagline} />
<meta property="og:type" content={props.ogType || 'website'} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<!-- v1.3 meta fix (see statusbar-PROGRESS.md): WHATWG takes the FIRST matching
     theme-color meta, so ONE dynamic meta only — a static media pair would shadow
     any manual choice that disagrees with the OS. Boot script sets content before
     first paint; no-JS falls back to light. -->
<meta name="theme-color" content={THEME_COLORS.light} id="tc-base" data-light={THEME_COLORS.light} data-dark={THEME_COLORS.dark} />
<meta name="mobile-web-app-capable" content="yes" />
<link rel="manifest" href="/manifest.webmanifest" />
{props.robots && <meta name="robots" content={props.robots} />}
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={new URL('rss.xml', canonical).href} />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='3' fill='%23006E5E'/%3E%3Crect x='19' y='6' width='7' height='7' fill='%23fff'/%3E%3C/svg%3E" />
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('as-theme') || 'system';
      localStorage.setItem('as-theme', t);
      var mq = matchMedia('(prefers-color-scheme: dark)');
      var apply = function () {
        var eff = t === 'system' ? (mq.matches ? 'dark' : 'light') : t;
        document.documentElement.setAttribute('data-theme', eff);
        document.documentElement.setAttribute('data-theme-pref', t);
        /* v1.3: single meta = always the first match. Plain content setAttribute
           repaints per spec (re-run rule) — no remove+re-insert needed. */
        var tc = document.getElementById('tc-base');
        if (tc) {
          tc.setAttribute('content', eff === 'dark' ? tc.dataset.dark : tc.dataset.light);
        }
      };
      apply();
      if (t === 'system' && mq.addEventListener) mq.addEventListener('change', apply);
      var a = localStorage.getItem('as-ads') || 'off';
      var p = localStorage.getItem('as-ph') || 'on';
      document.documentElement.setAttribute('data-ads', a);
      document.documentElement.setAttribute('data-ph', p);
      document.documentElement.classList.add('js');
    } catch (e) {}
  })();
</script>
