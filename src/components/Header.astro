---
/* Header v0.3 — ONE BAR (header-patterns.md decisions, Sep 10):
   - Single sticky bar 54px mobile / 60px desktop (Cloudflare 54 + Velt 69 bracket).
   - Wordmark = biggest element: green square SVG mark with terminal-notch cut
     (echo of the approved Terminal G logo, executed clean) + "AndroidScroll"
     weight 800, "Scroll" in deep teal. NO status-line, NO ad-flag in the bar.
   - Right cluster: 3 stroke-SVG icon buttons (browse, search, theme sun/moon),
     20px icons in 44px hotspots. Zero text glyphs.
   - Scroll >8px adds .is-compact: 1px bottom hairline + 4px soft shadow,
     height eases to 48px.
   - Desktop ≥900px: up to 4 inline category links, mono 12px, between wordmark
     and icons (Cloudflare's labeled-links pattern).
   - Law 8 ad-toggles live in the Browse sheet footer (duplicated markup, classed
     .ad-toggle, wired by event delegation — no duplicate IDs; Footer.astro keeps
     its own instance). Browse bottom sheet + search overlay IDs preserved. */
import { SITE, CATS, PILLARS, TOTALS, childrenOf, postsIn, POSTS } from '../data/site';
const pillarsWithPosts = PILLARS.map(p => ({ ...p, real: postsIn(p).length }));
const navCats = pillarsWithPosts.filter(p => p.real > 0).slice(0, 4);
const navLabel = (name: string) => name.split(/[ &—-]+/).filter(Boolean)[0] || name;
const shortCount = (name: string) => navLabel(name).toLowerCase();
---
<header class="site-header" id="site-header">
  <div class="header-in">
    <a class="wordmark" href="/" aria-label="AndroidScroll — home">
      <svg class="mark" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 0 H24 V24 H0 V4 A4 4 0 0 1 4 0 Z" fill="var(--deep)"/>
        <path d="M24 10 H14 A4 4 0 0 0 10 14 V24 H16 V17 A1 1 0 0 1 17 16 H24 Z" fill="var(--canvas)"/>
        <rect x="15" y="3.5" width="6" height="2.4" fill="var(--canvas)"/>
      </svg>
      <span class="word-text">Android<em>Scroll</em></span>
    </a>

    {navCats.length > 0 && (
      <nav class="head-cats" aria-label="Featured shelves">
        {navCats.map(p => (
          <a href={p.path} title={`${p.name} — ${p.real} live ${p.real === 1 ? 'guide' : 'guides'}`}>{shortCount(p.name)}</a>
        ))}
      </nav>
    )}

    <div class="head-actions">
      <button class="icon-btn" id="browse-trigger" aria-expanded="false" aria-controls="browse-sheet" aria-label="Open browse menu" title="Browse the shelves">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h11"/></svg>
      </button>
      <button class="icon-btn" id="search-trigger" aria-label="Search guides" aria-controls="search-layer" title="Search (/)">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.8" cy="10.8" r="6.3"/><path d="M15.6 15.6 20.5 20.5"/></svg>
      </button>
      <button class="icon-btn" id="theme-toggle" aria-label="Theme: auto (follows system)" title="Light / dark / auto">
        <svg class="glyph-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.4"/><path d="M12 2.6v2.5M12 18.9v2.5M2.6 12h2.5M18.9 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8"/></svg>
        <svg class="glyph-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.2 14.5A8.5 8.5 0 0 1 9.5 3.8a8.5 8.5 0 1 0 10.7 10.7Z"/></svg>
        <svg class="glyph-auto" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.6"/><path d="M12 3.4a8.6 8.6 0 0 1 0 17.2Z" fill="currentColor" stroke="none"/><path d="M12 1.6v2.2M12 20.2v2.2M1.6 12h2.2M20.2 12h2.2"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="scrim" id="scrim" hidden></div>

<aside class="sheet" id="browse-sheet" role="dialog" aria-modal="true" aria-label="Browse all shelves" hidden>
  <div class="sheet-head">
    <h2>The shelves</h2>
    <button class="close-x" id="browse-close" aria-label="Close browse">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5 5 19"/></svg>
    </button>
  </div>
  <nav class="sheet-body" aria-label="Categories">
    {pillarsWithPosts.map(p => (
      <div class="b-pillar">
        <a class="p-name" href={p.path}>{p.name}
          <span class:list={['cnt', { zero: p.real === 0 }]}>{p.real} {p.real === 1 ? 'guide' : 'guides'}</span>
        </a>
        {childrenOf(p).length > 0 && (
          <ul class="b-kids">
            {childrenOf(p).map(k => {
              const n = postsIn(k).length;
              return <li><a href={k.path} class:list={{ 'is-empty': n === 0 }}>
                <span>{k.name}</span>
                <span class:list={['cnt', { zero: n === 0 }]}>{n === 0 ? 'opens soon' : n + (n === 1 ? ' guide' : ' guides')}</span>
              </a></li>;
            })}
          </ul>
        )}
      </div>
    ))}
    <div class="sheet-note">
      Counts are honest: {TOTALS.posts} guides live today across {TOTALS.categories} shelves — the rest open as the
      200-post library lands. <a href="/about/">How we work →</a>
    </div>
    <div class="sheet-foot" aria-label="Ad slot settings">
      <span class="foot-kicker mono">Ad slots (law 8)</span>
      <div class="ad-toggles">
        <label><input type="checkbox" class="ad-toggle" data-role="slots" /> Slots</label>
        <label><input type="checkbox" class="ad-toggle" data-role="placeholders" /> Placeholders</label>
      </div>
      <span class="sheet-foot-note">off = zero height · zero requests · zero shift</span>
    </div>
  </nav>
</aside>

<div class="search-layer" id="search-layer" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="scrim is-open" id="search-scrim" style="position:absolute"></div>
  <div class="search-box">
    <div class="search-meta"><span>Search {TOTALS.posts} guides</span><span>Esc to close</span></div>
    <label class="sr-only" for="search-input" style="position:absolute;left:-9999px">Search query</label>
    <input id="search-input" type="search" placeholder="battery, overheating, whatsapp, malware…" autocomplete="off" />
    <ul class="search-results" id="search-results" aria-live="polite"></ul>
    <div class="search-empty no-js-hide" id="search-empty" hidden>
      No guide matches that yet — and that's the backlog, not a dead end.<br />
      <a href="/contact/">Tell us what to write →</a>
    </div>
  </div>
</div>

<script type="module">
  /* One progressive-enhancement script: theme, compact header, browse sheet,
     search overlay (client index), Law-8 ad toggles (delegated, classed),
     rail stagger. */
  const root = document.documentElement;
  const header = document.getElementById('site-header');
  const scrim = document.getElementById('scrim');
  const sheet = document.getElementById('browse-sheet');
  const searchLayer = document.getElementById('search-layer');
  const searchInput = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const empty = document.getElementById('search-empty');
  const toast = document.getElementById('toast');
  const store = { get: k => { try { return localStorage.getItem(k); } catch { return null; } },
                  set: (k, v) => { try { localStorage.setItem(k, v); } catch {} } };
  let toastTimer;
  const say = m => { toast.textContent = m; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 2600); };

  /* theme — 3-state cycle: light → dark → system (King fix 3); SVG glyph reflects PREF, not just effect */
  const themeBtn = document.getElementById('theme-toggle');
  const mqDark = matchMedia('(prefers-color-scheme: dark)');
  const applyTheme = () => {
    const pref = store.get('as-theme') || 'system';
    const eff = pref === 'system' ? (mqDark.matches ? 'dark' : 'light') : pref;
    root.setAttribute('data-theme', eff);
    root.setAttribute('data-theme-pref', pref);
    themeBtn.classList.toggle('pref-light', pref === 'light');
    themeBtn.classList.toggle('pref-dark', pref === 'dark');
    themeBtn.classList.toggle('pref-system', pref === 'system');
    const names = { light: 'light', dark: 'dark', system: 'auto (follows system)' };
    themeBtn.setAttribute('aria-label', 'Theme: ' + names[pref]);
    themeBtn.title = 'Theme: ' + names[pref] + ' — click to change';
  };
  applyTheme();
  mqDark.addEventListener?.('change', () => { if ((store.get('as-theme') || 'system') === 'system') applyTheme(); });
  themeBtn.addEventListener('click', () => {
    /* every click must produce a VISIBLE change or land on system — never an invisible hop */
    const cur = store.get('as-theme') || 'system';
    const eff = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const sys = mqDark.matches ? 'dark' : 'light';
    let next;
    if (cur === 'system') next = eff === 'dark' ? 'light' : 'dark';
    else if (sys !== cur) next = 'system';
    else next = cur === 'dark' ? 'light' : 'dark';
    store.set('as-theme', next); applyTheme();
    const msg = { light: 'Theme: light', dark: 'Theme: dark', system: 'Theme: auto — follows your phone' };
    say(msg[next]);
  });

  /* rails stagger-in on scroll (IntersectionObserver, 40ms steps, translateY 8px) */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stag = document.querySelectorAll('.stag');
  if (!reduce && 'IntersectionObserver' in window && stag.length) {
    const io = new IntersectionObserver(es => es.forEach((e, i) => {
      if (e.isIntersecting) {
        e.target.style.transitionDelay = Math.min(i * 40, 200) + 'ms';
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }), { rootMargin: '0px 0px -8% 0px' });
    stag.forEach(el => io.observe(el));
  } else {
    stag.forEach(el => el.classList.add('in'));
  }

  /* compact sticky state: >8px scroll adds hairline + 4px shadow, eases to 48px */
  let compact = false;
  const onScroll = () => {
    const want = window.scrollY > 8;
    if (want !== compact) { compact = want; header.classList.toggle('is-compact', want); }
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();

  /* sheets */
  const openSheet = () => { scrim.hidden = false; sheet.hidden = false; requestAnimationFrame(() => { scrim.classList.add('is-open'); sheet.classList.add('is-open'); }); document.getElementById('browse-trigger').setAttribute('aria-expanded', 'true'); };
  const closeSheet = () => { scrim.classList.remove('is-open'); sheet.classList.remove('is-open'); document.getElementById('browse-trigger').setAttribute('aria-expanded', 'false'); setTimeout(() => { sheet.hidden = true; scrim.hidden = true; }, 200); };
  document.getElementById('browse-trigger').addEventListener('click', openSheet);
  document.getElementById('browse-close').addEventListener('click', closeSheet);
  scrim.addEventListener('click', closeSheet);

  /* search overlay */
  const INDEX = JSON.parse(document.getElementById('search-index').textContent);
  const openSearch = () => { searchLayer.hidden = false; searchLayer.classList.add('is-open'); setTimeout(() => searchInput.focus(), 30); render(''); };
  const closeSearch = () => { searchLayer.classList.remove('is-open'); searchLayer.hidden = true; };
  document.getElementById('search-trigger').addEventListener('click', openSearch);
  document.getElementById('search-scrim').addEventListener('click', closeSearch);
  addEventListener('keydown', e => {
    if (e.key === 'Escape') { closeSheet(); closeSearch(); }
    if (e.key === '/' && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); openSearch(); }
  });
  const esc = s => s.replace(/[&<"]/g, c => ({ '&': '&amp;', '<': '&lt;', '"': '&quot;' }[c]));
  function render(q) {
    const terms = q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const hits = (terms.length ? INDEX.filter(p => terms.every(t => (p.title + ' ' + p.excerpt + ' ' + p.cat).toLowerCase().includes(t))) : INDEX).slice(0, 8);
    results.innerHTML = hits.map(p => `<li><a href="${p.url}"><h3>${esc(p.title)}</h3><div class="sr-x">${esc(p.excerpt)}</div><div class="sr-meta">${p.meta}</div></a></li>`).join('');
    empty.hidden = !(terms.length && hits.length === 0);
  }
  searchInput.addEventListener('input', () => render(searchInput.value));

  /* Law 8 ad toggles — one source of truth via event delegation on .ad-toggle.
     Every instance (Browse sheet here, Footer control elsewhere) reads and
     writes the same localStorage keys + html[data-ads]/[data-ph]; no IDs, so
     multiple placements can never collide. */
  const paintAds = () => {
    document.querySelectorAll('.ad-toggle').forEach(box => {
      box.checked = box.dataset.role === 'slots' ? root.getAttribute('data-ads') === 'on' : root.getAttribute('data-ph') !== 'off';
    });
    const foot = document.getElementById('foot-ad-state');
    if (foot) foot.textContent = root.getAttribute('data-ads') === 'on' ? 'ON' : 'OFF';
  };
  paintAds();
  document.addEventListener('change', e => {
    const box = e.target instanceof Element && e.target.closest('.ad-toggle');
    if (!box) return;
    const on = box.checked;
    if (box.dataset.role === 'slots') { root.setAttribute('data-ads', on ? 'on' : 'off'); store.set('as-ads', on ? 'on' : 'off'); }
    else { root.setAttribute('data-ph', on ? 'on' : 'off'); store.set('as-ph', on ? 'on' : 'off'); }
    paintAds();
    say(box.dataset.role === 'slots'
      ? (on ? 'Ad slots ON — still zero requests in this prototype.' : 'Ad slots OFF — zero height, zero shift.')
      : (on ? 'Placeholders shown.' : 'Placeholders hidden — slots render empty.'));
  });
</script>

<script type="application/json" id="search-index" set:html={JSON.stringify(POSTS.map(p => ({ title: p.title, url: p.url, excerpt: p.excerpt, cat: p.cat_name,
    meta: `${p.date} · ${p.read_min} min · ${p.cat_name}` })))} />
