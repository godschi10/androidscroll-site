---
import Base from '../layouts/Base.astro';
import { POSTS, PILLARS, postsIn } from '../data/site';
const magnets = [...POSTS].sort((a, b) => b.comments - a.comments).slice(0, 3);
---
<Base title="Page not found" desc="That door isn't on this site." robots="noindex">
  <div class="col" style="padding-bottom:64px">
    <header class="art-head">
      <div class="hero-kicker">Error 404 · a working door, not a wall</div>
      <h1 class="art-h1">No guide lives here.</h1>
      <p class="art-stand">Search usually finds it — press the ⌕ in the header, or take one of the doors below. If a link broke on our side, tell us and we fix it same week.</p>
    </header>
    <div class="art-body">
      <div class="kicker-h">The three traffic magnets</div>
      <div class="rel-grid" style="border-top:2px solid var(--ink)">
        {magnets.map(m => <article><h3><a href={m.url}>{m.title}</a></h3><div class="byline"><span>{m.comments} comments</span></div></article>)}
      </div>
      <div class="kicker-h" style="margin-top:30px">Or enter through a pillar</div>
      <ul class="b-kids" style="border-top:1px solid var(--line);max-width:520px">
        {PILLARS.map(p => { const n = postsIn(p).length; return (
          <li><a href={p.path}><span>{p.name}</span><span class="cnt">{n} live</span></a></li>); })}
      </ul>
      <p style="margin-top:26px"><a class="btn-deep" href="/contact/">Report a broken link →</a></p>
    </div>
  </div>
</Base>
