---
/* C-FULL article page — breadcrumb, h1+meta, hero, QUICK-ANSWER, dual TOC w/
   scroll-spy, .prose body, tags/share/author/related/prev-next, ONE newsletter
   slot, scaleX progress, BreadcrumbList + BlogPosting JSON-LD.
   Bodies port from WP next: until then the reading surface carries the
   excerpt-driven quick-answer + a port-pending note (never fabricated copy). */
import Base from '../layouts/Base.astro';
import ArticleChrome from '../components/ArticleChrome.astro';
import Comments from '../components/Comments.astro';
import { SITE, POSTS, byPath, bySlug, postsIn, fmtDate } from '../data/site';

export function getStaticPaths() {
  return POSTS.map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const cat = byPath[p.cat_path] || null;

/* related: same-category first, recent-posts fallback (never empty). */
const pool = cat ? postsIn(cat).filter(x => x.slug !== p.slug) : [];
const fresh = [...POSTS].sort((a, b) => (a.date < b.date ? 1 : -1)).filter(x => x.slug !== p.slug && !pool.includes(x));
const related = [...pool, ...fresh].slice(0, 3);

/* prev/next: chronological neighbours (oldest → newest). */
const chrono = [...POSTS].sort((a, b) => (a.date < b.date ? -1 : 1));
const at = chrono.findIndex(x => x.slug === p.slug);
const prev = at > 0 ? chrono[at - 1] : null;
const next = at >= 0 && at < chrono.length - 1 ? chrono[at + 1] : null;

const absUrl = SITE.url + p.url;
const crumbTitle = p.title.split(' ').slice(0, 6).join(' ') + (p.title.split(' ').length > 6 ? '…' : '');
const iso = (d: string) => d + 'T00:00:00+01:00';

/* hero cover: field-manual SVG illustrations per topic (v0.4.6 King: the placeholder
   band read as a dead CTA — real art now; device shots replace these with the body port). */
const COVERS: Array<[RegExp, string, string]> = [
  [/stor|space/, '/img/kb-storage.svg', 'Phone storage screen: free double the APK, cache is the thief'],
  [/install|malware|unknown|security/, '/img/kb-unknown.svg', 'Unknown-sources prompt: allow only your file manager'],
  [/toast|water|overheat/, '/img/kb-toast.svg', 'Phone alert toast mock'],
  [/success|test|fix|problem/, '/img/kb-success.svg', 'Fix-confirmed check mock'],
  [/batter|charg|drain|gemini|morning|whatsapp|excellence/, '/img/kb-hero.svg', 'Terminal showing the fix log'],
];
const coverHit = COVERS.find(([re]) => re.test(p.slug)) || COVERS[4];
const coverSrc = coverHit[1]; const coverAlt = coverHit[2];

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: p.title,
  description: p.excerpt,
  datePublished: iso(p.date),
  dateModified: iso(p.modified),
  author: { '@type': 'Person', name: 'G-will Chijioke', url: SITE.url + '/about/#author' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: absUrl,
  wordCount: p.words,
  timeRequired: `PT${p.read_min}M`,
};
/* breadcrumb trail — v0.6.2: sub-filed posts (cat_path = /category/root/sub/) show
   BOTH levels: Home › root › sub › title. Single-segment posts keep the 2-step trail.
   Trail + BreadcrumbList positions are built from ONE crumb list so they can't drift. */
const catSegs = (p.cat_path || '').split('/').filter(Boolean); // ['category','guides-how-tos','privacy-security']
const isSubFiled = catSegs.length === 3 && catSegs[0] === 'category';
const rootCat = isSubFiled
  ? (bySlug[p.root_slug] || byPath['/category/' + p.root_slug + '/'] || null)
  : null;
const crumbs = [
  { name: 'Home', href: '/' },
  ...(isSubFiled && rootCat ? [{ name: p.root_name || rootCat.name, href: rootCat.path }] : []),
  ...(cat ? [{ name: cat.name, href: cat.path }] : []),
];
const breadcrumbLD = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE.url + c.href })),
    { '@type': 'ListItem', position: crumbs.length + 1, name: crumbTitle },
  ],
};
---
<Base title={p.title} desc={p.excerpt} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(blogPosting).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99))} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD).replace(/</g, String.fromCharCode(92, 117, 48, 48, 51, 99))} />

  <article itemscope itemtype="https://schema.org/BlogPosting">
    <meta itemprop="headline" content={p.title} />
    <meta itemprop="description" content={p.excerpt} />
    <meta itemprop="datePublished" content={iso(p.date)} />
    <meta itemprop="dateModified" content={iso(p.modified)} />
    <meta itemprop="wordCount" content={String(p.words)} />

    <header class="art-head col">
      <nav class="crumb" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i > 0 && <span class="sep" aria-hidden="true">›</span>}
              <a href={c.href}>{c.name}</a>
            </li>
          ))}
          <li aria-current="page"><span class="sep" aria-hidden="true">›</span><span class="txt">{crumbTitle}</span></li>
        </ol>
      </nav>
      <p class="art-kicker mono">{p.cat_name}</p>
      <h1 class="art-h1" itemprop="headline">{p.title}</h1>
      <p class="art-stand" itemprop="description">{p.excerpt}</p>
      <div class="meta-bar">
        <span class="meta-who"><img class="t-mono-av t-mono-av-s" src="/img/author.png" alt="" aria-hidden="true" width="32" height="32" loading="lazy" decoding="async"> By <a href="/about/#author" rel="author">G-will Chijioke</a></span> <!-- v0.6.11 #4: King 'gravatar doesn't work for ... post meta profile image' — byline monogram -> his photo (self-hosted author photo) -->
        <span class="meta-facts"><span class="f-pub"><span class="f-lbl">Published </span><time datetime={p.date} itemprop="datePublished">{fmtDate(p.date)}</time></span>
        {p.modified !== p.date && (<span class="upd">Updated <time datetime={p.modified} itemprop="dateModified">{fmtDate(p.modified)}</time></span>)}
        {p.read_min && <span>{p.read_min} min<span class="f-lbl"> read</span></span>}
        <a class="lc lc-link" id="lc-count" href="#comments-section" data-live-count={p.id}><span class="lc-n">{p.comments}</span> <span class="lc-l">{p.comments === 1 ? 'comment' : 'comments'}</span></a></span>
      </div>
      {/* no body image in WP payload yet: category-tint hero band reserves the slot */}
      <figure class="art-hero">
        <img src={coverSrc} width="800" height="450" alt={coverAlt} loading="eager" fetchpriority="high" decoding="async" itemprop="image" />
        <figcaption>Field illustration — real device shots land with the body port.</figcaption>
      </figure>
    </header>

    <div class="art-layout col">
      <div class="art-main">
        {/* QUICK-ANSWER: verdict first, King's voice, excerpt-honest until bodies land */}
        <aside class="qa-box" aria-label="Quick answer">
          <p class="qa-kicker mono">Quick answer</p>
          <p class="qa-verdict"><strong>FIX:</strong> {p.excerpt}</p>
          <p class="qa-meta mono">⏱ ~{p.read_min} min · Applies to: {p.cat_name} · Full steps land with the body port</p>
          <a class="qa-jump" href="#keep-reading">Jump to the guide ↓</a>
        </aside>

        {/* mobile TOC: native details, zero JS required */}
        <details class="toc-mobile" hidden>
          <summary>In this guide <span class="toc-count"></span></summary>
          <nav data-toc-mobile aria-label="Table of contents"></nav>
        </details>

        <div class="prose" id="keep-reading" itemprop="articleBody">
          <div class="stub-note">
            <b>Prototype — body port pending</b>
            The full {p.words ? p.words.toLocaleString('en-US') + '-word' : ''} body from androidscroll.com ports into this reading template next (H2 every 300–400 words, numbered steps, FAQ accordion, verdict box). Everything around it — header, furniture, meta, related — is live and final.
          </div>
        </div>

        <ArticleChrome title={p.title} url={absUrl} tags={[]} />

        {/* prev/next cards */}
        {(prev || next) && (
          <nav class="post-nav" aria-label="More guides">
            {prev
              ? (<a class="pn-card" href={prev.url} rel="prev"><span class="pn-k mono">← Older</span><span class="pn-t">{prev.title}</span><span class="pn-c mono">{prev.cat_name}</span></a>)
              : <span class="pn-card pn-empty" aria-hidden="true"></span>}
            {next
              ? (<a class="pn-card" href={next.url} rel="next"><span class="pn-k mono">Newer →</span><span class="pn-t">{next.title}</span><span class="pn-c mono">{next.cat_name}</span></a>)
              : <span class="pn-card pn-empty" aria-hidden="true"></span>}
          </nav>
        )}
      </div>

      {/* desktop sticky TOC sidebar w/ scroll-spy */}
      <aside class="toc-side" data-toc-desktop hidden aria-label="On this page"></aside>
    </div>

    <section class="col" aria-label="Related" style="margin-bottom:40px">
      <div class="kicker-h">Keep reading · {p.root_name}</div>
      <div class="rel-grid">
        {related.map(s => (
          <article>
            <h3><a href={s.url}>{s.title}</a></h3>
            <div class="byline"><span>{fmtDate(s.date)}</span><span><b>{s.read_min} min</b></span></div>
          </article>
        ))}
      </div>
    </section>

    <Comments postId={p.id} postSlug={p.slug} initialCount={p.comments}
      authorName="G-will Chijioke" />
  </article>
</Base>
