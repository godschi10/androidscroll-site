---
/* Homepage v3 — H1 FRONT PAGE with H2 VOICE (King verdict, home-mobile-patterns.md).
   Front page, not welcome mat: hero strip (kicker + H1 + one-sentence stand +
   hairline meta + status TICKER) → §00 TOP FIXES (first content ≤420px at 390)
   → §01 LATEST → §02 THE LEDGER (full status panel, below the fold) → §03 PILLAR
   MAP → §04 MONEY TREE → §05 trust → notify. Terminal quick-answer kept, compressed. */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import '../styles/global.css';
import { SITE, POSTS, CATS, PILLARS, TOTALS, postsIn, fmtDate } from '../data/site';

/* TOP FIXES: the five most-substantive fix guides, ordered for a reader in trouble */
const fixSlugs = [
  'android-problems-fix',
  'android-battery-draining-fast',
  'android-phone-overheating',
  'android-storage-full-after-deleting-files',
  '6-charging-mistakes-that-damage-your-phone-battery',
];
const topFixes = fixSlugs.map(s => POSTS.find(p => p.slug === s)!).filter(Boolean);
const latest = [...POSTS].sort((a, b) => (a.date < b.date ? 1 : -1)).slice(0, 8);
const buying = PILLARS.find(p => p.slug === 'buying-guides')!;
const emptyShelves = buying.children.map(c => ({ ...c, real: postsIn(c).length })).filter(c => !c.real);
const shorts = POSTS.filter(p => p.read_min <= 10).length;
const words = POSTS.reduce((n, p) => n + (p.words || 0), 0);
---
<Base>
  <!-- hero strip: masthead voice in three lines, then the ticker (traits 1-4) -->
  <section class="hero wrap" aria-labelledby="hero-h1">
    <div class="hero-main">
      <div class="hero-kicker">The Android field manual · {SITE.benchline}</div>
      <h1 class="hero-h1" id="hero-h1">Master your Android<span class="dot">.</span></h1>
      <p class="hero-stand">No hype, no filler — {TOTALS.posts} long guides tested on the same mid-range phones you hold.</p>
      <div class="hero-meta">
        <span>Est. <b>2019</b></span>
        <span>{TOTALS.posts} guides</span>
        <span>{TOTALS.comments} comments</span>
        <span>{(words / 1000).toFixed(1)}k words</span>
        <span>Android 16 on the bench</span>
      </div>
      <div class="st-ticker mono" aria-label="Site status — live counts">
        <span class="st-sig">site:status ● live</span>
        <span class="sep">—</span>
        <span>fix_guides <b>{TOTALS.posts}</b></span><span class="sep">·</span>
        <span>quick_reads <b>{shorts}</b> ≤10 min</span><span class="sep">·</span>
        <span>comments <b>{TOTALS.comments}</b></span><span class="sep">·</span>
        <span>shelves <b>{TOTALS.categories - TOTALS.empty_categories}/{TOTALS.categories}</b></span><span class="sep">·</span>
        <span>stocked <b>{TOTALS.posts}/200</b></span>
        <span class="batt" data-lvl={Math.round((TOTALS.posts / 200) * 5)} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      </div>
    </div>

    <!-- quick-answer terminal box (signature #4) — compressed to two lines -->
    <div class="term stag" role="group" aria-label="Quick answer">
      <div class="t-line"><span class="t-p">&gt; q:</span><span class="t-k">phone acting up — where do I start?</span></div>
      <div class="t-line"><span class="t-p">&gt; a:</span><span class="t-a">Restart, then <a href="/android-problems-fix/">work the full fix rail</a> in order. <span class="t-cursor" aria-hidden="true"></span></span></div>
    </div>
  </section>

  <!-- §00 TOP FIXES: spec-sheet rows, no boxes — the front page leads with help -->
  <section class="sec wrap" aria-labelledby="s-fixes">
    <div class="rule-s"><span class="s-no">§00</span><h2 id="s-fixes">Top fixes</h2><span class="s-side">start here · most-worked rails first</span></div>
    <div class="fix-rail">
      {topFixes.map((p, i) => (
        <article class="spec-row stag">
          <span class="idx mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="sr-main">
            <h3><a href={p.url}>{p.title}</a></h3>
            <span class="sr-meta mono"><b>FIX {String(i + 1).padStart(2, '0')}</b> · {p.read_min} min · {p.cat_name}{p.comments > 0 && <> · {p.comments} comments</>}<span class="hide-s"> · {p.words.toLocaleString('en-US')} words</span></span>
          </div>
          <span class="arr" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
    <div class="lat-more"><a href="/latest/">All {TOTALS.posts} fixes →</a></div>
  </section>

  <!-- §01 latest: chronologic mono list (moved up — readers want what's new next) -->
  <section class="sec wrap" aria-labelledby="s-latest">
    <div class="rule-s"><span class="s-no">§01</span><h2 id="s-latest">Latest from the bench</h2><span class="s-side">{TOTALS.posts} guides since 2019 · newest first</span></div>
    <div class="lat-list">
      {latest.map(r => (
        <article class="lat-row stag">
          <span class="d mono">{fmtDate(r.date)}</span>
          <div>
            <h3><a href={r.url}>{r.title}</a></h3>
            <div class="m mono"><b>{r.root_name}</b> · {r.read_min} min · {r.comments} comments</div>
          </div>
          <span class="arr" aria-hidden="true">→</span>
        </article>
      ))}
    </div>
    <div class="lat-more"><a href="/latest/">Full chronology, oldest to newest →</a></div>
  </section>

  <!-- §02 THE LEDGER: the full status panel, below the fold where it earns its rows -->
  <section class="sec wrap" aria-labelledby="s-ledger">
    <div class="rule-s"><span class="s-no">§02</span><h2 id="s-ledger">The ledger</h2><span class="s-side">live counts · no vanity metrics</span></div>
    <aside class="st-panel mono" aria-label="Site status — live counts">
      <div class="st-head"><span>site:status</span><span class="st-sig">● live</span></div>
      <ul class="st-rows">
        <li><span class="k">fix_guides</span><span class="dots"></span><span class="v">{TOTALS.posts}</span></li>
        <li><span class="k">quick_reads</span><span class="dots"></span><span class="v">{shorts} ≤10 min</span></li>
        <li><span class="k">comments</span><span class="dots"></span><span class="v">{TOTALS.comments}</span></li>
        <li><span class="k">shelves_open</span><span class="dots"></span><span class="v">{TOTALS.categories - TOTALS.empty_categories}/{TOTALS.categories}</span></li>
        <li><span class="k">shelves_stocking</span><span class="dots"></span><span class="v zero">{TOTALS.empty_categories}</span></li>
        <li><span class="k">library_target</span><span class="dots"></span><span class="v">200 · dec 2026</span></li>
        <li class="st-batt"><span class="k">stock_level</span>
          <span class="batt" data-lvl={Math.round((TOTALS.posts / 200) * 5)} aria-label={`${TOTALS.posts} of 200 guides live`}><i></i><i></i><i></i><i></i><i></i></span>
          <span class="v">{TOTALS.posts}/200</span>
        </li>
      </ul>
      <div class="st-foot">counts read straight off the build — no CMS, no database · {SITE.url.replace('https://', '')}</div>
    </aside>
  </section>

  <!-- §03 pillar map: battery-glyph tiles -->
  <section class="sec wrap" aria-labelledby="s-map">
    <div class="rule-s"><span class="s-no">§03</span><h2 id="s-map">The pillar map</h2><span class="s-side">four shelves · battery glyphs = honest stock</span></div>
    <div class="tiles">
      {PILLARS.map(p => {
        const live = postsIn(p);
        const empty = live.length === 0;
        return (
          <div class:list={['tile stag', { 'is-empty': empty }]}>
            <div class="tile-top">
              <h3><a href={p.path}>{p.name}</a></h3>
              <span class="batt" data-lvl={Math.min(5, live.length)} aria-label={`${live.length} live guides`}><i></i><i></i><i></i><i></i><i></i></span>
            </div>
            <div class="t-meta mono"><b>{live.length} live</b> · {live.reduce((n, x) => n + (x.words || 0), 0).toLocaleString('en-US')} words</div>
            <ul class="mono">
              {p.children.map(k => {
                const n = postsIn(k).length;
                return <li><a href={k.path} class:list={{ 'is-empty': n === 0 }}><span>{k.name}</span><span class="n">{n === 0 ? 'soon' : String(n).padStart(2, '0')}</span></a></li>;
              })}
              {p.children.length === 0 && live.slice(0, 3).map(x => (
                <li><a href={x.url}><span>{x.title.length > 30 ? x.title.slice(0, 30) + '…' : x.title}</span><span class="n">{x.read_min}m</span></a></li>
              ))}
            </ul>
            <div class="t-foot">{empty
              ? <>opens as the 200-post library lands · <a href={p.path}>see the plan →</a></>
              : <><a href={p.path}>Enter shelf →</a></>}</div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- §04 money tree: deep-teal verdict band -->
  <section class="verdict-band" aria-labelledby="s-money">
    <div class="wrap"><div class="vb-in">
      <div>
        <div class="vb-score">
          <span class="n">0</span>
          <span class="of">buyer’s guides<br />published — today</span>
        </div>
        <div class="vb-batt mono" style="margin-top:14px">
          <span class="batt" data-lvl="0" aria-label="Zero of five buying shelves stocked"><i></i><i></i><i></i><i></i><i></i></span>
          0/5 shelves stocked
        </div>
      </div>
      <div>
        <div class="vb-kicker">§04 · Money tree — the honest state</div>
        <h2 class="vb-title" id="s-money">We won’t tell you what to buy until we’ve broken one first.</h2>
        <p class="vb-copy">Buying Guides is the emptiest shelf on the site and the most expensive mistake we could make filling it with filler. {emptyShelves.length} sub-shelves are planned; first drops January 2027; every pick bought at retail and daily-driven two weeks before a verdict ships. Where the library is already deep, the guides above are the receipts.</p>
        <div class="vb-shelves">
          {emptyShelves.map(s => <a class="shelf" href={s.path}><b>{s.name}</b> 0 · Q1 2027</a>)}
        </div>
        <div class="vb-cta">
          <a class="btn-deep" href="/category/buying-guides/">Watch the shelf →</a>
          <span class="vb-fine">Notify-me list builds per shelf — no spam, one email at launch.</span>
        </div>
      </div>
    </div></div>
  </section>

  <!-- trust / EEAT band -->
  <section class="sec wrap" aria-labelledby="s-trust">
    <div class="rule-s"><span class="s-no">§05</span><h2 id="s-trust">Who’s behind this</h2><span class="s-side">EEAT, stated plainly</span></div>
    <div class="trust">
      <div class="trust-in">
        <div class="t-cell">
          <span class="t-k">The desk</span>
          <h3>One writer, accountable by name</h3>
          <div class="t-person">
            <img class="t-mono-av" src="/img/author.png" alt="" aria-hidden="true" width="40" height="40" loading="lazy" decoding="async"> <!-- v0.6.11 #4: desk trust cell -> author photo (was 'G' monogram) -->
            <div><b>G-will Chijioke</b><span>Founder · Android &amp; security writing since 2019</span></div>
          </div>
          <p>Every guide carries a real byline and a correction email. When we’re wrong, the page says so — see the <a href="/comments-policy/">comments policy</a> or <a href="/contact/">contact the desk</a>.</p>
        </div>
        <div class="t-cell">
          <span class="t-k">The bench</span>
          <h3>Mid-range first — your phone, not ours</h3>
          <p>Guides are tested on Galaxy-A / Pixel-a / Redmi-Note class devices — the same class you hold. No flagship-only advice; steps checked on the stock Android you actually run.</p>
          <p style="margin-top:10px"><a href="/how-we-test/">How we test →</a></p>
        </div>
        <div class="t-cell">
          <span class="t-k">The numbers</span>
          <h3>Counted honestly</h3>
          <div class="stat-grid">
            <div class="stat"><div class="n">{TOTALS.posts}</div><div class="l">guides live</div></div>
            <div class="stat"><div class="n">{TOTALS.comments}</div><div class="l">comments</div></div>
            <div class="stat"><div class="n">{TOTALS.empty_categories}</div><div class="l">shelves to stock</div></div>
            <div class="stat"><div class="n">200</div><div class="l">by dec 2026</div></div>
          </div>
          <p>No inflated archive. The roadmap is public because the library is small — that’s the point.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- newsletter / notify -->
  <section class="wrap notify" aria-labelledby="s-notify">
    <div class="notify-in">
      <div>
        <h2 id="s-notify">Get the launch alerts</h2>
        <p>One email when a shelf opens or a flagship guide is re-tested. No digest, no “top 10 of the week.”</p>
      </div>
      <form data-stub>
        <input type="email" placeholder="you@example.com" aria-label="Email address" required />
        <button class="btn-deep" type="submit">Notify me</button>
        <span class="n-note">Prototype stub — this form confirms on-device, nothing is sent.</span>
      </form>
    </div>
  </section>
</Base>
