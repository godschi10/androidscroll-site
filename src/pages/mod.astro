</style>

<script>
/* Console client — zero third-party. Bearer desk API: moderation/list,
   /reports, /stats, moderation/:id actions, public /comments reply.
   API base: absolute Worker rail in prod; on 127.0.0.1/localhost (dist e2e
   preview) we use the SAME-ORIGIN /api path so the local e2e proxy can
   bridge — the Worker CORS allow-list is exact-match and excludes dev
   origins. Tab/filter/page state lives in the URL hash (#/mod/<tab>?k=v). */
const ROOT = document.getElementById('mod-desk') as HTMLElement;

interface Item {
  id: number; post_id: number; parent: number; name: string; content: string;
  status: string; created_at: string; spam_score: number; is_author: boolean;
  reactions: Record<string, number> | null; reaction_total: number | null;
  open_reports: number | null;
}
interface ListResp { ok?: boolean; items?: Item[]; total?: number; page?: number; per?: number; pages?: number }
interface Report {
  id: number; comment_id: number; post_id: number; reason: string;
  created_at: string; comment_name: string | null; comment_status: string | null;
  comment_excerpt: string | null; reporter_hash?: string | null;
  resolved_at?: string | null;
}
interface Stats {
  ok?: boolean; comments_by_status?: Record<string, number>; pending?: number;
  comments_last_7d?: number; reactions_total?: number; open_reports?: number;
  top_posts?: { post_id: number; count: number }[]; posts_with_comments?: number;
  comments_total?: number;
}

const PROD_API = 'https://androidscroll-comments.gwill.workers.dev';
const IS_LOCAL = ['127.0.0.1', 'localhost'].includes(location.hostname);
const API = IS_LOCAL ? '/api' : PROD_API + '/api';

const TOK_KEY = 'androidscroll:modtok';
const POST_MAP: Record<string, { u?: string; t?: string } | string> = (() => {
  /* v0.6.17: map values became {u:url, t:title}; accept legacy string form
     defensively so an old cached page+new script never crashes. */
  try { return JSON.parse(ROOT?.dataset.postMap || '{}'); } catch { return {}; }
})();
function mapSlug(id: number | string): string {
  const v = POST_MAP[String(id)];
  return typeof v === 'string' ? v : (v?.u || '');
}
function mapTitle(id: number | string): string {
  const v = POST_MAP[String(id)];
  return typeof v === 'object' && v ? (v.t || '') : '';
}

/* Site root at runtime — the desk is served from any origin: apex '/',
   staging '/androidscroll-site/'. Astro base is '' at build, so the only
   honest way to resolve '/' + slug on the current host is to take the path
   up to (and incl.) the '/mod/' segment. v0.6.14: fixes trace links that
   404'd on staging because they pointed at origin root. */
function withBase(slug: string): string {
  const m = (location.pathname || '').match(/^(.*?)\/mod\/?$/);
  const root = m ? m[1] + '/' : '/';
  return root + slug.replace(/^\//, '');
}

const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
const lock     = $('mod-lock') as HTMLFormElement | null;
const tokInp   = $('mod-token') as HTMLInputElement | null;
const lockMsg  = $('mod-lock-msg') as HTMLElement | null;
const panel    = $('mod-panel') as HTMLElement | null;
const tabs     = $('mod-tabs') as HTMLElement | null;
const toast    = $('mod-toast') as HTMLElement | null;
const errBox   = $('mod-error') as HTMLElement | null;
const refreshB = $('mod-refresh') as HTMLButtonElement | null;
const signoutB = $('mod-signout') as HTMLButtonElement | null;
const retryB   = $('mod-retry') as HTMLButtonElement | null;

const views: Record<string, HTMLElement | null> = {
  queue:    $('mod-view-queue'),
  all:      $('mod-view-all'),
  reports:  $('mod-view-reports'),
  overview: $('mod-view-overview'),
};
const queueList = $('mod-queue-list');
const queueEmpty = $('mod-queue-empty');
const allList   = $('mod-all-list');
const allEmpty  = $('mod-all-empty');
const seg       = $('mod-seg');
const postForm  = $('mod-postform') as HTMLFormElement | null;
const postInp   = $('mod-postinp') as HTMLInputElement | null;
const pager     = $('mod-pager') as HTMLElement | null;
const prevB     = $('mod-prev') as HTMLButtonElement | null;
const nextB     = $('mod-next') as HTMLButtonElement | null;
const pageN     = $('mod-pagen') as HTMLElement | null;
const repList   = $('mod-rep-list');
const repEmpty  = $('mod-rep-empty');
const cards     = $('mod-cards');
const topList   = $('mod-topposts');
const topEmpty  = $('mod-top-empty');

/* ---------- state (hash-synced) ---------- */
/* v0.6.16: Overview is FIRST + DEFAULT (King 10:24). ?tab= search param is
   honoured for legacy links; hash wins over it. No ?tab=, no hash →
   overview. */
type State = { tab: string; status: string; post: string; page: number };
const state: State = { tab: 'overview', status: 'approved', post: '', page: 1 };
const TABS = ['overview', 'queue', 'all', 'reports'];
const TAB_QUERY = (new URLSearchParams(location.search).get('tab') || '').trim();

function hashOf(s: State): string {
  if (s.tab === 'all') {
    const q = ['status=' + s.status];
    if (s.post) q.push('post=' + s.post);
    if (s.page > 1) q.push('page=' + s.page);
    return '#/mod/all?' + q.join('&');
  }
  return '#/mod/' + s.tab;
}
function readHash(): boolean {
  const m = (location.hash || '').match(/^#\/mod\/(queue|all|reports|overview)(?:\?(.*))?$/);
  if (!m) return false;
  state.tab = m[1];
  const p = new URLSearchParams(m[2] || '');
  const st = p.get('status');
  if (st && ['pending', 'approved', 'spam', 'trash', 'all'].includes(st)) state.status = st;
  state.post = (p.get('post') || '').replace(/[^0-9]/g, '');
  state.page = Math.max(1, parseInt(p.get('page') || '1', 10) || 1);
  return true;
}
function syncHash() {
  const h = hashOf(state);
  try { history.replaceState(null, '', h); } catch { /* file:// sandbox: state still in memory */ }
}
function setTab(tab: string) {
  state.tab = tab;
  clearSelectionSilent(); // v0.6.17: selection clears on tab change
  syncHash();
  paintTabs();
  for (const k of TABS) if (views[k]) views[k]!.hidden = k !== tab;
  show(errBox, false);
  if (tab === 'queue') void loadQueue();
  else if (tab === 'all') void loadAll();
  else if (tab === 'reports') void loadReports();
  else void loadOverview();
}
function paintTabs() {
  if (!tabs) return;
  for (const b of Array.from(tabs.querySelectorAll('.mod-tab'))) {
    (b as HTMLElement).classList.toggle('is-on', b.getAttribute('data-tab') === state.tab);
  }
}

/* ---------- token gate ---------- */
let token = '';
try { token = localStorage.getItem(TOK_KEY) || ''; } catch { /* private mode: session-only */ }
function saveTok(v: string) {
  token = v;
  try { v ? localStorage.setItem(TOK_KEY, v) : localStorage.removeItem(TOK_KEY); } catch { /* ok */ }
}
if (token && tokInp) tokInp.value = token; // auto-filled next visit

function show(el: HTMLElement | null, on: boolean) { if (el) el.hidden = !on; }
let unlocked = false;
function setLocked(on: boolean) {
  unlocked = !on;
  show(lock, on); show(panel, !on); show(tabs, !on);
  show(refreshB, !on); show(signoutB, !on);
}
function setToast(msg: string, bad = false) {
  if (!toast) return;
  toast.textContent = msg;
  toast.classList.toggle('is-bad', bad);
}

/* ---------- helpers ---------- */
function timeAgo(iso: string): string {
  const t = Date.parse(iso);
  if (isNaN(t)) return iso;
  const s = Math.max(0, (Date.now() - t) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm ago';
  if (s < 86400) return Math.floor(s / 3600) + 'h ago';
  if (s < 604800) return Math.floor(s / 86400) + 'd ago';
  return iso.slice(0, 10);
}
function absTitle(iso: string): string { return String(iso || '').replace('T', ' ').replace(/\.\d+Z$/, ' UTC'); }
function stripHtml(s: string): string {
  return String(s || '').replace(/<[^>]*>/g, ' ').replace(/&#?\w+;/g, ' ')
          .replace(/\s+/g, ' ').trim().slice(0, 160);
}
function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string): HTMLElementTagNameMap[K] {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  return e;
}
/* ── v0.6.17 (D): EXACT brand reaction SVGs — paths copied VERBATIM from the
   comment summary bubbles (Comments.astro REACT_SVG: like/heart/fire/laugh,
   r7.9s laugh geometry, non-scaling-stroke, currentColor). Inline innerHTML
   build (not innerHTML from API data — keys are from OUR map). ── */
const VE = ' vector-effect="non-scaling-stroke"';
const REACT_SVG: Record<string, string> = {
  like: `<path class="fl"${VE} d="M8.6 20.4V11l5-8.2c2 0 3.2 1.2 3.2 3.2l-.6 3.4h4c1.6 0 2.6 1.2 2.4 2.6l-1.2 6.4c-.2 1.2-1.2 2-2.4 2H8.6Z"/><path class="fl"${VE} d="M3.6 11.6h5v8.8h-5z"/>`,
  heart: `<path class="fl"${VE} d="M12 20.8C12 20.8 3.2 15 3.2 9.4 3.2 6.4 5.5 4.3 8.2 4.3c1.8 0 3.1 1 3.8 2.3.7-1.3 2-2.3 3.8-2.3 2.7 0 5 2.1 5 5.1 0 5.6-8.8 11.4-8.8 11.4Z"/>`,
  fire: `<path${VE} d="M12 2.8 16.2 9.4l1.6-1.6c1.6 2 2.6 4 2.6 6.2a8.4 8.4 0 1 1-16.8 0c0-2.2 1-4.2 2.6-6.2l1.6 1.6L12 2.8Z"/><path fill="currentColor" stroke="none" d="M12 10.6 15.5 15.4 12 20.2 8.5 15.4Z"/>`,
  laugh: `<path fill="currentColor" stroke="none" fill-rule="evenodd" d="M4.1 12a7.9 7.9 0 1 0 15.8 0a7.9 7.9 0 1 0 -15.8 0Z M7.935 7.411L6.314 9.965L10.264 9.965L8.644 7.411A0.419 0.419 0 0 0 7.935 7.411Z M15.356 7.411L13.736 9.965L17.686 9.965L16.065 7.411A0.419 0.419 0 0 0 15.356 7.411Z M6.614 11.88H17.386a5.386 6.344 0 0 1 -10.773 0Z"/><path d="M3.073 8.75L2.765 10.849A1.36 1.36 0 1 1 1.037 9.347Z" fill="currentColor" stroke="none"/><path d="M20.927 8.75L22.963 9.347A1.36 1.36 0 1 1 21.235 10.849Z" fill="currentColor" stroke="none"/>`,
};

function postRef(id: number, commentId?: number): HTMLElement {
  const meta = el('span', 'mod-meta');
  const slug = mapSlug(id);
  const title = mapTitle(id);
  if (slug) {
    // v0.6.14/16: base-aware — absolute slug 404s under the staging base;
    // withBase() derives the real root from the /mod/ path. When we know the
    // comment row we land on its #comment-<id> anchor (Comments.astro).
    const a = el('a'); a.href = withBase(slug) + (commentId ? '#comment-' + commentId : '');
    a.title = title || slug;
    a.dataset.postlink = String(id);
    const lab = el('span', 'mod-ptitle');
    lab.textContent = title || 'Post ' + id; /* v0.6.17 E: TITLE is the link text; mapped-URL-but-no-title falls back honestly */
    a.appendChild(lab);
    meta.appendChild(a);
    const pid = el('span', 'mod-pid');
    pid.textContent = '#' + id; /* raw id: tiny muted suffix ONLY */
    meta.appendChild(pid);
  } else {
    meta.textContent = 'Post ' + id;
    meta.dataset.postlink = 'raw-' + id;
  }
  return meta;
}
function skeletons(host: HTMLElement | null, n = 3) {
  if (!host) return;
  host.textContent = '';
  for (let i = 0; i < n; i++) host.appendChild(el('div', 'mod-skel'));
}
async function api(path: string, opts: RequestInit = {}): Promise<Response> {
  const headers = new Headers(opts.headers || {});
  headers.set('authorization', 'Bearer ' + token);
  if (opts.body && !headers.has('content-type')) headers.set('content-type', 'application/json');
  return fetch(API + path, { ...opts, headers });
}
function wrongToken() {
  if (lockMsg) { lockMsg.textContent = 'Wrong token'; lockMsg.classList.add('is-bad'); }
  setLocked(true);
}
function netError() { show(errBox, true); }

/* ---------- fetchers per tab ---------- */
let reqSeq = 0; // stale-response guard for fast filter/page changes

async function loadQueue(): Promise<void> {
  if (!token) return;
  const seq = ++reqSeq;
  show(errBox, false); show(queueEmpty, false);
  skeletons(queueList);
  let res: Response;
  try { res = await api('/moderation/list?status=pending&per=25'); }
  catch { if (seq === reqSeq) { skeletons(queueList, 0); netError(); } return; }
  if (seq !== reqSeq) return;
  if (res.status === 401) { wrongToken(); return; }
  if (!res.ok) { skeletons(queueList, 0); setToast('Queue error — HTTP ' + res.status, true); netError(); return; }
  let data: ListResp; try { data = await res.json(); } catch { skeletons(queueList, 0); netError(); return; }
  setLocked(false);
  skeletons(queueList, 0);
  const items = data.items || [];
  show(queueEmpty, items.length === 0);
  const saQ = $('mod-queue-selall-wrap'); if (saQ) saQ.hidden = items.length === 0;
  clearSelectionSilent();
  listStatusById = {};
  if (queueList) {
    queueList.textContent = '';
    for (const it of items) { listStatusById[String(it.id)] = it.status; queueList.appendChild(row(it, { reply: true, bulk: true })); }
  }
}

function allParams(): string {
  const p = new URLSearchParams({ status: state.status, per: '25', page: String(state.page) });
  if (state.post) p.set('post', state.post);
  return p.toString();
}
async function loadAll(): Promise<void> {
  if (!token) return;
  const seq = ++reqSeq;
  show(errBox, false); show(allEmpty, false);
  skeletons(allList);
  if (seg) for (const b of Array.from(seg.querySelectorAll('button')))
    b.classList.toggle('is-on', b.getAttribute('data-status') === state.status);
  if (postInp && postInp.value !== state.post) postInp.value = state.post;
  let res: Response;
  try { res = await api('/moderation/list?' + allParams()); }
  catch { if (seq === reqSeq) { skeletons(allList, 0); netError(); } return; }
  if (seq !== reqSeq) return;
  if (res.status === 401) { wrongToken(); return; }
  if (!res.ok) { skeletons(allList, 0); setToast('List error — HTTP ' + res.status, true); netError(); return; }
  let data: ListResp; try { data = await res.json(); } catch { skeletons(allList, 0); netError(); return; }
  setLocked(false);
  skeletons(allList, 0);
  const items = data.items || [];
  show(allEmpty, items.length === 0);
  const saA = $('mod-all-selall-wrap'); if (saA) saA.hidden = items.length === 0;
  clearSelectionSilent(); // selection clears on tab/filter/page change (King: visible filtered scope only)
  listStatusById = {};
  if (allList) {
    allList.textContent = '';
    for (const it of items) { listStatusById[String(it.id)] = it.status; allList.appendChild(row(it, { reply: true, bulk: true })); }
  }
  const total = data.total ?? items.length;
  const page = data.page ?? state.page;
  const pages = data.pages ?? 1;
  show(pager, total > 25);
  if (pageN) pageN.textContent = 'Page ' + page + ' of ' + Math.max(1, pages) + ' — ' + total + ' total';
  if (prevB) prevB.disabled = page <= 1;
  if (nextB) nextB.disabled = page >= pages;
}

async function loadReports(): Promise<void> {
  if (!token) return;
  const seq = ++reqSeq;
  show(errBox, false); show(repEmpty, false);
  skeletons(repList);
  let res: Response;
  try { res = await api('/moderation/reports?page=1'); }
  catch { if (seq === reqSeq) { skeletons(repList, 0); netError(); } return; }
  if (seq !== reqSeq) return;
  if (res.status === 401) { wrongToken(); return; }
  if (!res.ok) { skeletons(repList, 0); setToast('Reports error — HTTP ' + res.status, true); netError(); return; }
  let data: { items?: Report[]; total?: number }; try { data = await res.json(); } catch { skeletons(repList, 0); netError(); return; }
  setLocked(false);
  skeletons(repList, 0);
  const items = data.items || [];
  show(repEmpty, items.length === 0);
  if (repList) {
    repList.textContent = '';
    for (const r of items) repList.appendChild(reportRow(r));
  }
}

/* ---------- Overview (v0.6.16 expansion — real data only) ---------- */
function sparkPoints(createdList: string[]): number[] {
  // comments per day for the last 7 days (today = index 6), from list created_at
  const DAY = 86_400_000;
  const now = Date.now();
  const buckets = new Array(7).fill(0);
  for (const iso of createdList) {
    const t = Date.parse(iso);
    if (isNaN(t)) continue;
    const daysAgo = Math.floor((now - t) / DAY);
    if (daysAgo >= 0 && daysAgo <= 6) buckets[6 - daysAgo]++;
  }
  return buckets;
}

function sparklineSVG(b: number[]): SVGElement | null {
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg') as SVGElement;
  svg.setAttribute('viewBox', '0 0 280 44');
  svg.setAttribute('width', '280');
  svg.setAttribute('height', '44');
  svg.setAttribute('preserveAspectRatio', 'none');
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Comments per day, last 7 days');
  const max = Math.max(1, ...b);
  const step = 280 / 6;
  const pts = b.map((v, i) => (i * step).toFixed(1) + ',' + (40 - (v / max) * 34).toFixed(1)).join(' ');
  const line = document.createElementNS(NS, 'polyline');
  line.setAttribute('points', pts);
  line.setAttribute('fill', 'none');
  line.setAttribute('stroke', 'var(--deep)');
  line.setAttribute('stroke-width', '2');
  line.setAttribute('stroke-linecap', 'round');
  line.setAttribute('stroke-linejoin', 'round');
  const base = document.createElementNS(NS, 'line');
  base.setAttribute('x1', '0'); base.setAttribute('x2', '280');
  base.setAttribute('y1', '42'); base.setAttribute('y2', '42');
  base.setAttribute('stroke', 'var(--line-2)'); base.setAttribute('stroke-width', '1');
  svg.append(base, line);
  return svg;
}

async function loadOverview(): Promise<void> {
  if (!token) return;
  const seq = ++reqSeq;
  show(errBox, false);
  if (cards) cards.textContent = '';
  let res: Response; let listRes: Response | null = null;
  try {
    const p = Promise.all([
      api('/moderation/stats'),
      api('/moderation/list?status=all&per=100&page=1'),
    ]);
    res = (await p)[0]; listRes = (await p)[1];
  } catch { if (seq === reqSeq) netError(); return; }
  if (seq !== reqSeq) return;
  if (res.status === 401) { wrongToken(); return; }
  if (!res.ok) { setToast('Stats error — HTTP ' + res.status, true); netError(); return; }
  let s: Stats; try { s = await res.json(); } catch { netError(); return; }
  let listData: ListResp = {};
  if (listRes && listRes.ok) { try { listData = await listRes.json(); } catch { /* partial: no extras */ } }
  setLocked(false);
  const items = listData.items || [];
  const by = s.comments_by_status || {};
  const n = (v: unknown) => (Number.isFinite(Number(v)) ? String(Number(v)) : '0');

  /* status tiles — v0.6.16: BUTTONS (King 11:17). PENDING jumps to Queue;
     APPROVED/SPAM/TRASH jump to All Comments pre-filtered (client-side seg). */
  const tiles: [string, string, string, () => void][] = [
    ['approved', n(by.approved), 'Approved', () => jumpFiltered('approved')],
    ['pending',  n(by.pending ?? s.pending), 'Pending', () => setTab('queue')],
    ['spam',     n(by.spam), 'Spam', () => jumpFiltered('spam')],
    ['trash',    n(by.trash), 'Trash', () => jumpFiltered('trash')],
  ];
  const extras: [string, string, string][] = [
    ['last7', 'Last 7 days', n(s.comments_last_7d)],
    ['reactions', 'Reactions', n(s.reactions_total)],
  ];
  if (cards) {
    cards.textContent = '';
    for (const [key, val, label, fn] of tiles) {
      const k = el('button', 'mod-kpi'); k.type = 'button'; k.dataset.kpi = key;
      k.setAttribute('aria-label', label + ' — ' + val + ', open ' + (key === 'pending' ? 'queue' : 'all comments filtered ' + key));
      const b = el('b'); b.textContent = val;
      const sp = el('span'); sp.textContent = label;
      const go = el('span', 'mod-kpi-go'); go.textContent = 'View';
      k.append(b, sp, go);
      k.addEventListener('click', fn);
      cards.appendChild(k);
    }
    for (const [key, label, val] of extras) {
      const k = el('div', 'mod-kpi'); k.dataset.kpi = key;
      const b = el('b'); b.textContent = val;
      const sp = el('span'); sp.textContent = label;
      k.append(b, sp);
      cards.appendChild(k);
    }
  }

  /* ACTION REQUIRED — pending + open reports as clickable tiles */
  const actHost = $('mod-actionreq');
  if (actHost) {
    actHost.textContent = '';
    const pend = Number(by.pending ?? s.pending);
    const reps = Number(s.open_reports);
    const mkTile = (label: string, val: number, hot: boolean, fn: () => void) => {
      const t = el('button', 'mod-act-tile' + (hot ? ' is-hot' : '')); t.type = 'button';
      t.dataset.actiontile = label.toLowerCase().replace(/\s+/g, '');
      const b = el('b'); b.textContent = String(val);
      const sp = el('span'); sp.textContent = hot ? label + ' — act' : label + ' — clear';
      t.append(b, sp); t.addEventListener('click', fn);
      actHost.appendChild(t);
    };
    mkTile('Pending comments', pend, pend > 0, () => setTab('queue'));
    mkTile('Open reports', reps, reps > 0, () => setTab('reports'));
  }

  /* TOP GUIDES — base-aware links via the same postRef map (fix #2 reuse) */
  const tops = (s.top_posts || []).slice(0, 5);
  show(topEmpty, tops.length === 0);
  if (topList) {
    topList.textContent = '';
    for (const t of tops) {
      const rowE = el('div', 'mod-card mod-top-row');
      rowE.appendChild(postRef(t.post_id));
      const c = el('span', 'mod-topn'); c.textContent = t.count + (t.count === 1 ? ' comment' : ' comments');
      rowE.appendChild(c);
      topList.appendChild(rowE);
    }
  }

  /* 7-DAY TREND — inline SVG sparkline from list created_at (no chart lib) */
  const spark = $('mod-spark');
  if (spark) {
    spark.textContent = '';
    const buckets = sparkPoints(items.map((it) => it.created_at));
    const svg = sparklineSVG(buckets);
    if (svg) {
      svg.setAttribute('data-spark', buckets.join(','));
      spark.appendChild(svg);
    }
    const num = el('p', 'mod-spark-num');
    num.textContent = n(s.comments_last_7d) + ' comments in the last 7 days';
    spark.appendChild(num);
  }

  /* RECENT ACTIVITY — last 5 newest from list payload (list is created_at DESC) */
  const recent = $('mod-recent');
  const recEmpty = $('mod-recent-empty');
  if (recent) {
    recent.textContent = '';
    const last5 = items.slice(0, 5);
    show(recEmpty, last5.length === 0);
    for (const it of last5) {
      const rowE = el('div', 'mod-card mod-rec-row');
      const name = el('span', 'mod-rec-name'); name.textContent = it.name || 'Anonymous';
      const snip = el('span', 'mod-rec-snippet');
      const text = stripHtml(it.content || '');
      snip.textContent = text.length > 40 ? text.slice(0, 40) + '\u2026' : text;
      const time = el('span', 'mod-meta'); time.textContent = timeAgo(it.created_at);
      rowE.append(name, time, postRef(it.post_id, it.id), snip);
      recent.appendChild(rowE);
    }
  }

  /* REACTION MIX — client-side aggregate over the SAME list payload */
  const mixHost = $('mod-mix');
  const mixHead = $('mod-mix-head');
  if (mixHost) {
    mixHost.textContent = '';
    const tally: Record<string, number> = {};
    let any = false;
    for (const it of items) {
      const rx = it.reactions || {};
      for (const [e, v] of Object.entries(rx)) {
        tally[e] = (tally[e] || 0) + Number(v || 0);
        any = true;
      }
    }
    const entries = Object.entries(tally).sort((a, b2) => b2[1] - a[1]);
    show(mixHead, any);
    for (const [emoji, count] of entries) {
      const rowE = el('div', 'mod-card mod-mix-row');
      /* v0.6.17 (D): brand SVG glyph ONLY — no word label, no emoji char
         (the 'fire 🔥 17' double read was King-rejected), then the count.
         Keys come from OUR map, so this innerHTML is build-time content. */
      const g = el('span', 'mod-mix-g');
      g.setAttribute('aria-hidden', 'true');
      g.dataset.mixglyph = emoji;
      g.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' + (REACT_SVG[emoji] || '') + '</svg>';
      const sr = el('span'); /* sr-only accessible name for the glyph (no word label shown) */
      sr.className = 'mod-mix-l';
      sr.style.position = 'absolute'; sr.style.width = '1px'; sr.style.height = '1px';
      sr.style.overflow = 'hidden'; sr.style.clip = 'rect(1px 1px 1px 1px)'; sr.style.whiteSpace = 'nowrap';
      sr.textContent = (REACTIONS_LABEL[emoji] || emoji) + ' reactions';
      const c = el('span', 'mod-mix-n'); c.dataset.mix = emoji; c.textContent = String(count);
      rowE.append(g, sr, c);
      mixHost.appendChild(rowE);
    }
  }
}
