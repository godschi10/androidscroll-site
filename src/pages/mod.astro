---
/* MOD-CONSOLE v2 (0.6.16) — token-gated moderation desk over the worker API.
   Four tabs (v0.6.16: Overview FIRST + DEFAULT): Overview (KPI tiles that
   jump to their sections, action-required tiles, top guides, 7-day sparkline,
   recent activity, reaction mix), Queue (pending + actions + reply-as-author),
   All comments (status segment + post filter + pagination), Reports (alert-
   style report cards with their OWN dismiss/resolve — worker v0.1.6 route —
   plus a separate on-the-comment row). Tab + filter state lives in the URL
   hash (#/mod/<tab>?k=v) via history.replaceState so a refresh keeps position.
   - Base layout + robots noindex,nofollow (unlisted — no nav link ever).
   - ZERO third-party JS: plain DOM, one bundled module, Worker rail only.
   - Brand: var() tokens from global.css ONLY (mono labels, --paper cards w/
     1px --line-2 radius 4, --band tint, btn-deep/btn-ghost, mint active tab,
     44px touch, focus-visible, reduced-motion). No new fonts.
   - Token: localStorage 'androidscroll:modtok' (try/catch); Sign-out clears;
     401 → 'Wrong token'. Token never touches the repo or logs. */
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import { POSTS } from '../data/site';

/* Build-time post_id → {url, title} map (v0.6.17: titles over ids — King
   "I hate post number idea… prefer the name of the post link back"). Unknown
   ids render as bare "Post <id>" meta with an honest no-link fallback
   (v0.6.14 — never a dead href). */
const postMap: Record<number, { u: string; t: string }> = {};
for (const p of POSTS) postMap[p.id] = { u: p.url, t: p.title };
---
<Base title="Moderation desk" desc="Private moderation console — queue, all comments, reports, overview." robots="noindex, nofollow">
  <div class="mod-scoped" id="mod-desk" data-post-map={JSON.stringify(postMap)}>
    <section class="mod-band">
      <div class="wrap mod-band-in">
        <a class="mod-mark" href="/" aria-label="AndroidScroll — home"><Wordmark /></a>
        <p class="mod-kicker">Moderation Desk</p>
        <div class="mod-band-actions">
          <button id="mod-refresh" class="btn-ghost" type="button" hidden>Refresh</button>
          <button id="mod-signout" class="btn-ghost" type="button" hidden>Sign out</button>
        </div>
      </div>
      <div class="wrap">
        <!-- v0.6.16: Overview FIRST + DEFAULT (King 10:24) -->
        <nav class="mod-tabs" id="mod-tabs" aria-label="Console sections" hidden>
          <button type="button" class="mod-tab" data-tab="overview">Overview</button>
          <button type="button" class="mod-tab" data-tab="queue">Queue</button>
          <button type="button" class="mod-tab" data-tab="all">All comments</button>
          <button type="button" class="mod-tab" data-tab="reports">Reports</button>
        </nav>
      </div>
    </section>

    <div class="col mod-main">
      <form id="mod-lock" class="mod-card mod-lock" autocomplete="off">
        <p class="mod-label" id="mod-token-label">Access token</p>
        <input id="mod-token" class="mod-token" type="password" aria-labelledby="mod-token-label"
               placeholder="Paste the desk token" />
        <p id="mod-lock-msg" class="mod-result is-bad" role="status" aria-live="polite"></p>
        <div class="mod-act-row">
          <button class="btn-deep" type="submit">Unlock</button>
        </div>
      </form>

      <p id="mod-toast" class="mod-toast" role="status" aria-live="polite"></p>

      <section id="mod-panel" hidden aria-label="Console panel">
        <!-- QUEUE -->
        <div id="mod-view-queue" class="mod-view" hidden>
          <label class="mod-selall" id="mod-queue-selall-wrap"><input type="checkbox" id="mod-queue-selall" class="mod-cbx" aria-label="Select all in queue"><span class="mod-cbx-box" aria-hidden="true"></span><span>Select all</span></label>
          <div id="mod-queue-list" class="mod-rows"></div>
          <p id="mod-queue-empty" class="mod-empty" hidden>Nothing waiting.</p>
        </div>

        <!-- ALL COMMENTS -->
        <div id="mod-view-all" class="mod-view" hidden>
          <div class="mod-filterbar">
            <div class="mod-seg" id="mod-seg" role="group" aria-label="Status filter">
              <button type="button" data-status="pending">Pending</button>
              <button type="button" data-status="approved" class="is-on">Approved</button>
              <button type="button" data-status="spam">Spam</button>
              <button type="button" data-status="trash">Trash</button>
              <button type="button" data-status="all">All</button>
            </div>
            <label class="mod-selall" id="mod-all-selall-wrap"><input type="checkbox" id="mod-all-selall" class="mod-cbx" aria-label="Select all on this page"><span class="mod-cbx-box" aria-hidden="true"></span><span>Select all</span></label>
            <form id="mod-postform" class="mod-postform" autocomplete="off">
              <label class="mod-label mod-label-inline" for="mod-postinp">Post ID</label>
              <input id="mod-postinp" class="mod-postinp" list="mod-postids" inputmode="numeric" placeholder="any" />
              <datalist id="mod-postids">
                <option value="56"></option>
                <option value="10630"></option>
                <option value="12251"></option>
              </datalist>
              <button class="btn-ghost mod-apply" type="submit">Apply</button>
            </form>
          </div>
          <div id="mod-all-list" class="mod-rows"></div>
          <p id="mod-all-empty" class="mod-empty" hidden>No comments match.</p>
          <div id="mod-pager" class="mod-pager" hidden>
            <button id="mod-prev" class="btn-ghost" type="button">Prev</button>
            <p id="mod-pagen" class="mod-pagen"></p>
            <button id="mod-next" class="btn-ghost" type="button">Next</button>
          </div>
        </div>
        <!-- REPORTS (no checkboxes — Dismiss/resolve is its own lifecycle) -->
        <div id="mod-view-reports" class="mod-view" hidden>
          <div id="mod-rep-list" class="mod-rows"></div>
          <p id="mod-rep-empty" class="mod-empty" hidden>No open reports.</p>
        </div>

        <!-- v0.6.17 BULK BAR — floats over Queue + All Comments (sticky at
             the panel bottom) whenever rows are selected. -->
        <div id="mod-bulkbar" class="mod-selbar" hidden></div>

        <!-- OVERVIEW (v0.6.16: first + default tab, expanded real-data-only) -->
        <div id="mod-view-overview" class="mod-view" hidden>
          <div id="mod-cards" class="mod-cards"></div>
          <div id="mod-actionreq" class="mod-actionreq"></div>
          <p class="mod-label mod-top-head">Top guides</p>
          <div id="mod-topposts" class="mod-rows"></div>
          <p id="mod-top-empty" class="mod-empty" hidden>No posts with comments.</p>
          <p class="mod-label mod-top-head">Last 7 days</p>
          <div id="mod-spark" class="mod-spark"></div>
          <p class="mod-label mod-top-head">Recent activity</p>
          <div id="mod-recent" class="mod-rows"></div>
          <p id="mod-recent-empty" class="mod-empty" hidden>No comments yet.</p>
          <p id="mod-mix-head" class="mod-label mod-top-head" hidden>Reaction mix</p>
          <div id="mod-mix" class="mod-rows"></div>
        </div>

        <div id="mod-error" class="mod-card" hidden>
          <p class="mod-label">Network</p>
          <p class="mod-err-msg">Could not reach the desk API.</p>
          <div class="mod-act-row">
            <button id="mod-retry" class="btn-ghost" type="button">Retry</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<style is:global>
/* .mod-scoped — all rules namespaced under the desk root. var() tokens ONLY. */
.mod-scoped .mod-band{background:var(--band);border-bottom:1px solid var(--line-2);padding-top:18px;padding-bottom:0}
.mod-scoped .mod-band-in{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;padding-bottom:14px}
.mod-scoped .mod-mark{display:inline-flex;align-items:center;min-height:44px;color:var(--ink)}
.mod-scoped .mod-kicker{margin:0;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--deep)}
.mod-scoped .mod-band-actions{margin-left:auto;display:flex;gap:10px;flex-wrap:wrap}
.mod-scoped .mod-band-actions .btn-ghost{white-space:nowrap}
.mod-scoped .mod-main{padding-top:14px;padding-bottom:var(--sp-e)}

/* Tabs — mono uppercase, active gets brand mint underline.
   v0.6.17 (C — King: "revert the vertical scroll bar in the tab menu"):
   overflow-x:auto FORCES computed overflow-y to auto, and the tab row's
   fractional line-height (10.5px mono x 1.65 = 17.325px) + margin-bottom:-1px
   bled 1px past the rail → ghost vertical scrollbar on fractional-DPR
   phones. Fix: line-height:1 (integer box), margin-bottom:0, rail pinned to
   an exact 47px (1 border + 2 pad + 44 tab), and overflow-y:hidden then
   clip (progressive) so no vertical scrollbar can ever paint. */
.mod-scoped .mod-tabs{display:flex;gap:4px;overflow-x:auto;overflow-y:hidden;overflow-y:clip;border-top:1px solid var(--line);padding-top:2px;height:47px;box-sizing:border-box;align-items:flex-start}
.mod-scoped .mod-tab{appearance:none;background:none;border:0;border-bottom:3px solid transparent;min-height:44px;line-height:1;padding:12px 14px;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);white-space:nowrap;cursor:pointer}
.mod-scoped .mod-tab:hover{color:var(--deep)}
.mod-scoped .mod-tab.is-on{color:var(--ink);border-bottom-color:var(--mint)}
.mod-scoped .mod-tab:focus-visible{outline:2px solid var(--focus);outline-offset:2px}

/* v0.6.17 (F) TAB-WHITENESS (King 16:5x) — dark-theme active tab/pill must never
   read pure-white: active tab gets brand-mint #00E9B0 text + underline; status
   pills get a dark fill + mint accent border + mint text (no pale --mint slab). */
html[data-theme=dark] .mod-scoped .mod-tab.is-on{color:#00E9B0;border-bottom-color:#00E9B0}
html[data-theme=dark] .mod-scoped .mod-seg button.is-on{background:var(--band-2);border-color:#00E9B0;color:#00E9B0}
@media (prefers-color-scheme:dark){html:not([data-theme=light]) .mod-scoped .mod-tab.is-on{color:#00E9B0;border-bottom-color:#00E9B0}html:not([data-theme=light]) .mod-scoped .mod-seg button.is-on{background:var(--band-2);border-color:#00E9B0;color:#00E9B0}}

.mod-scoped .mod-label{margin:0 0 8px;font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.mod-scoped .mod-label-inline{margin:0 8px 0 0}
.mod-scoped .mod-card{background:var(--paper);border:1px solid var(--line-2);border-left:4px solid var(--verdict);border-radius:4px;margin-top:16px;padding:16px 18px}

.mod-scoped .btn-deep{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--deep);color:var(--on-deep);font-weight:800;font-size:14.5px;padding:11px 20px;min-height:44px;border-radius:2px;border-top:2px solid var(--teal)}
.mod-scoped .btn-deep:hover{background:var(--deeper);color:var(--on-deep);text-decoration:none}
.mod-scoped .btn-ghost{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border:1px solid var(--deep);color:var(--deep);font-weight:800;font-size:14.5px;padding:11px 22px;min-height:44px;border-radius:2px;background:transparent}
.mod-scoped .btn-ghost:hover{background:var(--band);text-decoration:none}
.mod-scoped button:disabled{opacity:.5;cursor:not-allowed}

.mod-scoped .mod-token{width:100%;max-width:420px;background:var(--paper);border:1px solid var(--line-2);border-radius:2px;color:var(--ink);font-family:var(--mono);font-size:14px;padding:10px 12px;min-height:44px}
.mod-scoped .mod-act-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}

/* Inline mono toast — action results. */
.mod-scoped .mod-toast{margin:10px 0 0;font-family:var(--mono);font-size:11px;letter-spacing:.03em;color:var(--deep);font-variant-numeric:tabular-nums;min-height:16px}
.mod-scoped .mod-toast.is-bad{color:var(--ink)}
.mod-scoped .mod-result{margin:10px 0 0;font-family:var(--mono);font-size:11px;letter-spacing:.03em;color:var(--deep);font-variant-numeric:tabular-nums}
.mod-scoped .mod-result.is-bad{color:var(--ink)}

/* Row cards */
/* v0.6.16 (King 10:22): tab panels are NATURAL height — never an artificial
   max-height/overflow that paints a ghost scrollbar 1px past the content. */
.mod-scoped .mod-view{max-height:none;overflow:visible}
.mod-scoped .mod-rows{display:block}
.mod-scoped .mod-item{margin-top:14px}
.mod-scoped .mod-item-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px}
.mod-scoped .mod-name{font-family:var(--display);font-weight:800;font-size:16px;letter-spacing:-.01em;color:var(--ink)}
.mod-scoped .mod-meta{font-family:var(--mono);font-size:10.5px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.mod-scoped .mod-meta a{color:var(--deep)}
.mod-scoped .mod-meta a:hover{text-decoration:underline}
.mod-scoped .mod-chip{margin-left:auto;border:1px solid var(--line-2);border-radius:2px;padding:2px 8px;color:var(--ink-2);font-family:var(--mono);font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.mod-scoped .mod-chip.is-spam{border-color:var(--deep);color:var(--deep)}
.mod-scoped .mod-chip.is-rep{border-color:var(--deep);color:var(--deep)}
.mod-scoped .mod-chip.is-st{color:var(--ink-2)}
.mod-scoped .mod-ex{margin:10px 0 0;font-size:15px;line-height:1.6;color:var(--ink-2);overflow-wrap:anywhere}
.mod-scoped .mod-linkbtn{display:inline-flex;align-items:center;min-height:44px;font-family:var(--mono);font-size:11.5px;font-weight:500;letter-spacing:.04em;color:var(--deep);background:none;border:0;padding:0 2px;margin-top:2px}
.mod-scoped .mod-linkbtn:hover{text-decoration:underline}
.mod-scoped .mod-reply{margin-top:10px}
.mod-scoped .mod-ta{width:100%;min-height:96px;background:var(--paper);border:1px solid var(--line-2);border-radius:2px;color:var(--ink);font-family:var(--sans);font-size:15px;line-height:1.6;padding:10px 12px;resize:vertical}
.mod-scoped .mod-reply-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:10px}
.mod-scoped .mod-reply-msg{font-family:var(--mono);font-size:11px;letter-spacing:.03em;color:var(--deep);margin:8px 0 0}

/* Filter bar (All comments) */
.mod-scoped .mod-filterbar{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px;margin-top:14px}
.mod-scoped .mod-seg{display:flex;flex-wrap:wrap;gap:6px}
.mod-scoped .mod-seg button{appearance:none;border:1px solid var(--line-2);background:var(--paper);color:var(--muted);font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:0 12px;min-height:44px;border-radius:4px;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center}
.mod-scoped .mod-seg button:hover{color:var(--deep);border-color:var(--deep)}
.mod-scoped .mod-seg button.is-on{background:var(--mint);border-color:var(--mint);color:#10231F}
.mod-scoped .mod-postform{display:flex;align-items:center;gap:0;margin-left:auto}
.mod-scoped .mod-postinp{width:110px;background:var(--paper);border:1px solid var(--line-2);border-radius:2px;color:var(--ink);font-family:var(--mono);font-size:13px;padding:9px 10px;min-height:44px;margin-right:8px}
.mod-scoped .mod-apply{padding:11px 16px}

/* Pager */
.mod-scoped .mod-pager{display:flex;align-items:center;gap:14px;margin-top:18px}
.mod-scoped .mod-pagen{margin:0;font-family:var(--mono);font-size:11px;letter-spacing:.05em;color:var(--muted);font-variant-numeric:tabular-nums}

/* v0.6.17 (A) DELETE FOREVER — red danger language (house has no red token:
   derived from --verdict ink family), inline two-tap arm, NEVER native
   confirm(). Armed button swaps label + full ring; auto-disarms in 4s. */
.mod-scoped .btn-danger{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;border:1px solid #A3352A;color:#A3352A;font-weight:800;font-size:14.5px;padding:11px 18px;min-height:44px;border-radius:2px;background:transparent}
.mod-scoped .btn-danger:hover{background:rgba(163,53,42,.08)}
.mod-scoped .btn-danger.is-armed{background:#A3352A;color:#FFF;border-color:#A3352A;outline:2px solid #A3352A;outline-offset:2px}
@media (prefers-color-scheme:dark){html:not([data-theme=light]) .mod-scoped .btn-danger{color:#FF8A7A;border-color:#FF8A7A}html:not([data-theme=light]) .mod-scoped .btn-danger:hover{background:rgba(255,138,122,.12)}html:not([data-theme=light]) .mod-scoped .btn-danger.is-armed{background:#B4402F;border-color:#FF8A7A;color:#FFF;outline-color:#FF8A7A}}
html[data-theme=dark] .mod-scoped .btn-danger{color:#FF8A7A;border-color:#FF8A7A}
html[data-theme=dark] .mod-scoped .btn-danger:hover{background:rgba(255,138,122,.12)}
html[data-theme=dark] .mod-scoped .btn-danger.is-armed{background:#B4402F;border-color:#FF8A7A;color:#FFF;outline-color:#FF8A7A}

/* v0.6.20 (P10 DESK SELECT-STYLE — King: native squares + white pill) —
   custom Desk checkboxes: the native input stays in the DOM (change
   events, data-sel, :checked/:indeterminate all untouched) but is
   visually hidden; the styled box is a sibling span.mod-cbx-box —
   24px rounded, subtle border, brand #00E9B0 tick on a dark fill when
   on, --focus ring on keyboard focus. 44px touch target lives on the
   label wrap. Suits dark AND light: unchecked = paper + line-2 border;
   checked = verdict fill (dark in BOTH themes) + #00E9B0 tick. */
.mod-scoped .mod-cbx-wrap,.mod-scoped .mod-selall{position:relative;display:inline-flex;align-items:center;min-width:44px;min-height:44px;cursor:pointer}
.mod-scoped .mod-cbx{position:absolute;inset:0;width:44px;height:44px;margin:0;opacity:0;cursor:pointer;touch-action:manipulation}
.mod-scoped .mod-cbx-box{flex:none;width:24px;height:24px;border-radius:7px;background:var(--paper);border:1.5px solid var(--line-2);display:inline-grid;place-items:center;transition:border-color .12s ease-out,background-color .12s ease-out}
.mod-scoped .mod-cbx-box::after{content:"";width:12px;height:7px;border:2.5px solid transparent;border-top:0;border-right:0;transform:rotate(-45deg) translateY(-1px)}
.mod-scoped .mod-cbx:checked+.mod-cbx-box{background:var(--verdict);border-color:#00E9B0}
.mod-scoped .mod-cbx:checked+.mod-cbx-box::after{border-color:#00E9B0}
.mod-scoped .mod-cbx:indeterminate+.mod-cbx-box{background:var(--verdict);border-color:#00E9B0}
.mod-scoped .mod-cbx:indeterminate+.mod-cbx-box::after{width:11px;height:0;border:0;border-top:2.5px solid #00E9B0;transform:none}
.mod-scoped .mod-cbx:focus-visible{outline:none}
.mod-scoped .mod-cbx:focus-visible+.mod-cbx-box{outline:2px solid var(--focus);outline-offset:2px}
/* .is-on/.is-mixed mirror :checked/:indeterminate for style engines that
   never match dynamic :checked (proven live: Obscura); synced in
   syncSelUI() only — same paint, zero behavior change. */
.mod-scoped .mod-cbx-box.is-on{background:var(--verdict);border-color:#00E9B0}
.mod-scoped .mod-cbx-box.is-on::after{border-color:#00E9B0}
.mod-scoped .mod-cbx-box.is-mixed{background:var(--verdict);border-color:#00E9B0}
.mod-scoped .mod-cbx-box.is-mixed::after{width:11px;height:0;border:0;border-top:2.5px solid #00E9B0;transform:none}
.mod-scoped .mod-item.mod-selected{border-left-color:#00E9B0}
.mod-scoped .mod-selbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;position:sticky;bottom:12px;z-index:30;margin:14px auto 0;max-width:680px;background:var(--verdict);border:1px solid var(--line-2);border-radius:6px;padding:8px 12px;box-shadow:var(--float)}
.mod-scoped .mod-selbar:empty{display:none}
/* v0.6.20 (P10) — dark floating bar in BOTH themes: verdict fill is dark
   light + dark, count in brand #00E9B0, Approve = mint slab / Spam-Trash-
   Clear = mint-outline ghosts, danger keeps its red language. */
.mod-scoped .mod-selbar .mod-sel-n{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#00E9B0;margin-right:auto;white-space:nowrap}
.mod-scoped .mod-selbar .btn-ghost{border-color:#00E9B0;color:#00E9B0;font-size:13px;padding:9px 14px;min-height:44px;background:transparent}
.mod-scoped .mod-selbar .btn-ghost:hover{background:rgba(0,233,176,.12)}
.mod-scoped .mod-selbar .btn-deep{border-top-color:transparent;background:#00E9B0;color:#10231F;font-size:13px;padding:9px 14px}
.mod-scoped .mod-selbar .btn-deep:hover{background:#00E9B0;color:#10231F;filter:brightness(1.1)}
.mod-scoped .mod-selbar .btn-deep:focus-visible,.mod-scoped .mod-selbar .btn-ghost:focus-visible,.mod-scoped .mod-selbar .btn-danger:focus-visible{outline:2px solid #00E9B0;outline-offset:2px}
.mod-scoped .mod-selbar .btn-danger{border-color:#FF8A7A;color:#FF8A7A;font-size:13px;padding:9px 14px}
.mod-scoped .mod-selbar .btn-danger:hover{background:rgba(255,138,122,.12)}
.mod-scoped .mod-selbar .btn-danger.is-armed{background:#B4402F;color:#FFF;border-color:#FF8A7A;outline-color:#FF8A7A}
.mod-scoped .mod-selall{display:inline-flex;align-items:center;gap:8px;font-family:var(--mono);font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);cursor:pointer}

/* v0.6.17 (E) POST TITLES — link text = title (one line, ellipsis); the raw
   id survives only as a tiny muted '#id' suffix, never a primary label. */
.mod-scoped .mod-ptitle{display:inline-block;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:bottom;text-transform:none;letter-spacing:.02em;font-size:11px;font-weight:600}
@media (max-width:639px){.mod-scoped .mod-ptitle{max-width:180px}}
.mod-scoped .mod-pid{font-size:9.5px;color:var(--muted);letter-spacing:.06em;margin-left:6px}

/* Overview cards */
