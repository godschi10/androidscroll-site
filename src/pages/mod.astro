/* ---------- comment row (Queue + All) ---------- */
function row(it: Item, opts: { reply?: boolean; bulk?: boolean }): HTMLElement {
  const box = el('article', 'mod-card mod-item');
  box.dataset.id = String(it.id);
  if (opts.bulk) box.dataset.bulk = '1';

  const head = el('div', 'mod-item-head');
  if (opts.bulk) {
    /* v0.6.17 (B): 44px touch checkbox, accent = brand --deep fill
       v0.6.20 (P10): custom Desk box — hidden native input + styled
       span.mod-cbx-box sibling (CSS paints :checked/:indeterminate +
       focus ring); input keeps .mod-cbx/data-sel/change = behavior kept. */
    const lb = el('label', 'mod-cbx-wrap');
    const cb = el('input'); (cb as HTMLInputElement).type = 'checkbox';
    cb.className = 'mod-cbx'; cb.dataset.sel = String(it.id);
    cb.setAttribute('aria-label', 'Select comment ' + it.id + ' by ' + (it.name || 'Anonymous'));
    cb.addEventListener('change', () => onSelChange());
    const bx = el('span', 'mod-cbx-box'); bx.setAttribute('aria-hidden', 'true');
    lb.append(cb, bx);
    head.appendChild(lb);
  }
  const name = el('span', 'mod-name'); name.textContent = it.name || 'Anonymous';
  const post = postRef(it.post_id, it.id);
  const time = el('span', 'mod-meta');
  time.textContent = timeAgo(it.created_at); time.title = absTitle(it.created_at);
  head.append(name, post, time);
  const chips: string[] = [];
  if (it.status !== 'approved') chips.push(it.status);
  if (Number(it.reaction_total) > 0) chips.push('\u2726 ' + it.reaction_total);
  if (Number(it.open_reports) > 0) chips.push('reported');
  for (const c of chips) {
    const chip = el('span', 'mod-meta mod-chip is-st'); chip.textContent = c; head.appendChild(chip);
  }
  const score = el('span', 'mod-meta mod-chip is-spam');
  score.textContent = 'Spam ' + (Number.isFinite(it.spam_score) ? it.spam_score : '?');
  head.appendChild(score);
  box.appendChild(head);

  const ex = el('p', 'mod-ex'); ex.textContent = stripHtml(it.content || '');
  box.appendChild(ex);

  const arow = el('div', 'mod-act-row');
  const result = el('span', 'mod-result');
  const mk = (label: string, cls: string, action: string) => {
    const b = el('button', cls); b.type = 'button'; b.textContent = label;
    b.addEventListener('click', () => moderate(it.id, action, b, result));
    return b;
  };
  arow.append(...(it.status === 'approved' ? [] : [mk('Approve', 'btn-deep', 'approve')]));
  if (it.status !== 'spam') arow.appendChild(mk('Spam', 'btn-ghost', 'spam'));
  if (it.status !== 'trash') arow.appendChild(mk('Trash', 'btn-ghost', 'trash'));
  if (it.status === 'spam' || it.status === 'trash') arow.appendChild(mk('Restore', 'btn-ghost', 'restore'));
  /* v0.6.17 (A): trash is terminal unless mass-deleted — DELETE FOREVER on
     trash rows only (worker guard: DELETE route requires status=trash).
     Inline two-tap arm, 4s timeout, never native confirm(). */
  if (it.status === 'trash') arow.appendChild(deleteForeverButton('Delete forever', () => void purgeOne(it.id), String(it.id)));
  box.appendChild(arow);
  box.appendChild(result);

  if (opts.reply) {
    const toggle = el('button', 'mod-linkbtn'); toggle.type = 'button'; toggle.textContent = 'Reply as author';
    const rep = el('div', 'mod-reply'); rep.hidden = true;
    const ta = el('textarea', 'mod-ta'); ta.placeholder = 'Your reply as G-will Chijioke\u2026';
    const rRow = el('div', 'mod-reply-row');
    const send = el('button', 'btn-deep'); send.type = 'button'; send.textContent = 'Send reply';
    const cancel = el('button', 'btn-ghost'); cancel.type = 'button'; cancel.textContent = 'Cancel';
    const rMsg = el('p', 'mod-reply-msg');
    rRow.append(send, cancel);
    rep.append(ta, rRow, rMsg);
    toggle.addEventListener('click', () => {
      rep.hidden = !rep.hidden;
      toggle.textContent = rep.hidden ? 'Reply as author' : 'Hide reply';
      if (!rep.hidden) ta.focus();
    });
    cancel.addEventListener('click', () => { rep.hidden = true; toggle.textContent = 'Reply as author'; });
    send.addEventListener('click', () => sendReply(it, ta, send, rMsg));
    box.appendChild(toggle);
    box.appendChild(rep);
  }
  return box;
}

/* REPORT card (v0.6.16, King 10:20) — a report must NOT look like a comment
   card. Alert treatment: --verdict left rail + tint, reporter WHO + reason
   chip + timestamp as the header meta, the flagged comment rendered as a
   dimmed QUOTE (context, not the body), and the report's OWN actions
   (Dismiss = was noise / Resolve = seen, keep comment) clearly separated
   from the comment-level Spam/Trash row underneath. Go-to-post stays. */
function reportRow(r: Report): HTMLElement {
  const box = el('article', 'mod-card mod-report');
  box.dataset.reportId = String(r.id);
  const head = el('div', 'mod-item-head');
  const who = el('span', 'mod-name'); who.textContent = 'Report received';
  const reporter = el('span', 'mod-meta mod-chip is-rep');
  reporter.textContent = 'Reporter ' + (r.reporter_hash ? '#' + r.reporter_hash : 'unknown');
  const reason = el('span', 'mod-meta mod-chip is-reason');
  reason.textContent = String(r.reason || 'unspecified').toUpperCase();
  const time = el('span', 'mod-meta');
  time.textContent = timeAgo(r.created_at); time.title = absTitle(r.created_at);
  head.append(who, reason, reporter, time);
  box.appendChild(head);

  const sub = el('p', 'mod-meta mod-rep-sub');
  sub.textContent = 'Flagged comment by ' + (r.comment_name || 'Anonymous') +
    ' \u00b7 status ' + (r.comment_status || '?');
  box.appendChild(sub);

  const quote = el('blockquote', 'mod-rep-quote');
  quote.textContent = stripHtml(r.comment_excerpt || '');
  box.appendChild(quote);

  /* report's own trash — separate row, separate meaning */
  const repRow = el('div', 'mod-act-row mod-rep-actions');
  const repResult = el('span', 'mod-result');
  const dismiss = el('button', 'btn-deep'); dismiss.type = 'button'; dismiss.textContent = 'Dismiss report';
  const keep = el('button', 'btn-ghost'); keep.type = 'button'; keep.textContent = 'Resolve \u2014 keep';
  dismiss.addEventListener('click', () => resolveReport(r.id, 'dismiss', dismiss, repResult));
  keep.addEventListener('click', () => resolveReport(r.id, 'keep', keep, repResult));
  const go = el('a');
  const slug = mapSlug(r.post_id);
  go.href = slug ? withBase(slug) + (r.comment_id ? '#comment-' + r.comment_id : '') : '/';
  /* v0.6.17 E: report card post link uses the TITLE (Go to post kept as the
     action verb via aria-label; visible text = title, ellipsized). */
  go.className = 'btn-ghost mod-golink';
  const goLabel = el('span', 'mod-ptitle');
  goLabel.textContent = mapTitle(r.post_id) || 'Go to post';
  go.dataset.postlink = slug ? String(r.post_id) : 'raw-' + r.post_id;
  go.setAttribute('aria-label', 'Go to post' + (mapTitle(r.post_id) ? ': ' + mapTitle(r.post_id) : ' #' + r.post_id));
  go.appendChild(goLabel);
  repRow.append(dismiss, keep, go);
  box.appendChild(repRow);
  box.appendChild(repResult);

  /* comment-level actions — visually de-emphasised, "on the comment" not "on the report" */
  const cRow = el('div', 'mod-act-row mod-rep-comment');
  const cResult = el('span', 'mod-result');
  const cmk = (label: string, cls: string, action: string) => {
    const b = el('button', cls); b.type = 'button'; b.textContent = label;
    b.addEventListener('click', () => moderate(r.comment_id, action, b, cResult));
    return b;
  };
  if (r.comment_status !== 'approved') cRow.appendChild(cmk('Approve', 'btn-ghost', 'approve'));
  if (r.comment_status !== 'spam') cRow.appendChild(cmk('Spam', 'btn-ghost', 'spam'));
  if (r.comment_status !== 'trash') cRow.appendChild(cmk('Trash', 'btn-ghost', 'trash'));
  if (r.comment_status === 'spam' || r.comment_status === 'trash') cRow.appendChild(cmk('Restore', 'btn-ghost', 'restore'));
  if (r.comment_status === 'trash') cRow.appendChild(deleteForeverButton('Delete forever', () => void purgeOne(r.comment_id), String(r.comment_id)));
  if (cRow.children.length) {
    const lead = el('span', 'mod-label mod-rep-lead'); lead.textContent = 'On the comment';
    box.appendChild(lead); box.appendChild(cRow); box.appendChild(cResult);
  }
  return box;
}

async function resolveReport(id: number, action: 'dismiss' | 'keep', btn: HTMLButtonElement, result: HTMLElement): Promise<void> {
  btn.disabled = true;
  try {
    const res = await api('/moderation/reports/' + id + '/resolve', { method: 'POST', body: JSON.stringify({ action }) });
    const data = await res.json().catch(() => ({} as Record<string, unknown>));
    if (res.status === 401) { wrongToken(); return; }
    if (res.ok) {
      setToast('Report #' + id + ' ' + (action === 'dismiss' ? 'dismissed \u2014 comment untouched' : 'resolved \u2014 comment kept'));
      await loadReports();
    } else {
      result.textContent = 'Report #' + id + ' ' + String((data as { message?: string }).message || res.status);
      setToast('Report #' + id + ' failed \u2014 ' + String((data as { message?: string }).message || res.status), true);
      btn.disabled = false;
    }
  } catch {
    netError();
    btn.disabled = false;
  }
}

/* ---------- actions ---------- */
async function moderate(id: number, action: string, btn: HTMLButtonElement, result: HTMLElement): Promise<void> {
  btn.disabled = true;
  try {
    const res = await api('/moderation/' + id, { method: 'POST', body: JSON.stringify({ action }) });
    const data = await res.json().catch(() => ({} as Record<string, unknown>));
    if (res.status === 401) { wrongToken(); return; }
    if (res.ok) {
      const st = (data as { status?: string }).status;
      result.textContent = '#' + id + ' ' + action + (st ? ' \u2192 ' + st : 'd');
      setToast('#' + id + ' ' + action + (st ? ' \u2192 ' + st : 'd'));
      await reloadActive();
    } else {
      result.textContent = '#' + id + ' ' + String((data as { message?: string }).message || res.status);
      setToast('#' + id + ' failed — ' + String((data as { message?: string }).message || res.status), true);
    }
  } catch {
    netError();
  } finally {
    btn.disabled = false;
  }
}

/* ---------- v0.6.17 (A): DELETE FOREVER — two-tap inline arm ---------- */
const ARM_TIMERS = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();
function armTwoTap(btn: HTMLButtonElement, label: string, onConfirm: () => void): void {
  /* first tap arms ('Tap again to confirm'); second tap fires. Disarms after
     4s. Never native confirm() (King law: inline two-tap). */
  const t = ARM_TIMERS.get(btn);
  if (t) { clearTimeout(t); ARM_TIMERS.delete(btn); }
  if (btn.dataset.armed === '1') {
    btn.dataset.armed = '0';
    btn.classList.remove('is-armed');
    btn.textContent = label;
    onConfirm();
    return;
  }
  btn.dataset.armed = '1';
  btn.classList.add('is-armed');
  btn.textContent = 'Tap again to confirm';
  ARM_TIMERS.set(btn, setTimeout(() => {
    if (btn.isConnected && btn.dataset.armed === '1') {
      btn.dataset.armed = '0';
      btn.classList.remove('is-armed');
      btn.textContent = label;
    }
  }, 4000));
}

function deleteForeverButton(label: string, onConfirm: () => void, idForAria: string): HTMLButtonElement {
  const b = el('button', 'btn-danger'); b.type = 'button'; b.textContent = label;
  b.dataset.deleteForever = idForAria;
  b.setAttribute('aria-label', 'Delete forever — ' + idForAria + ' (permanent)');
  b.addEventListener('click', () => armTwoTap(b, label, onConfirm));
  return b;
}

async function purgeOne(id: number): Promise<void> {
  const btn = document.querySelector('button[data-delete-forever="' + id + '"]') as HTMLButtonElement | null;
  if (btn) btn.disabled = true;
  try {
    const res = await api('/moderation/comments/' + id, { method: 'DELETE' });
    const data = await res.json().catch(() => ({} as Record<string, unknown>));
    if (res.status === 401) { wrongToken(); return; }
    if (res.ok) {
      setToast('#' + id + ' permanently deleted');
      selected.delete(String(id));
      await reloadActive();
    } else {
      setToast('#' + id + ' delete failed — ' + String((data as { message?: string }).message || (data as { code?: string }).code || res.status), true);
      if (btn) btn.disabled = false;
    }
  } catch {
    netError();
    if (btn) btn.disabled = false;
  }
}

/* ---------- v0.6.17 (B): BULK SELECT + mass actions ---------- */
const selected = new Set<string>();               // comment ids (string)
let listStatusById: Record<string, string> = {};  // last rendered rows by id

function activeBulkHost(): HTMLElement | null {
  if (state.tab === 'queue') return queueList;
  if (state.tab === 'all') return allList;
  return null;
}
function onSelChange(): void {
  const host = activeBulkHost();
  if (!host) return;
  const ids = Array.from(host.querySelectorAll('input[data-sel]'))
    .map((i) => (i as HTMLInputElement)).filter((i) => i.checked)
    .map((i) => i.dataset.sel as string);
  for (const k of Array.from(selected)) if (!ids.includes(k)) selected.delete(k);
  for (const k of ids) selected.add(k);
  syncSelUI();
}
function clearSelection(): void {
  selected.clear();
  const host = activeBulkHost();
  if (host) for (const i of Array.from(host.querySelectorAll('input[data-sel]'))) (i as HTMLInputElement).checked = false;
  syncSelUI();
}
function syncSelUI(): void {
  const bar = $('mod-bulkbar');
  const host = activeBulkHost();
  const n = selected.size;
  if (!bar || !host) return;
  for (const c of Array.from(host.querySelectorAll('input[data-sel]'))) {
    const art = (c as HTMLElement).closest('.mod-item');
    art?.classList.toggle('mod-selected', (c as HTMLInputElement).checked);
    /* v0.6.20 (P10): styled box mirrors :checked for engines that never
       match dynamic :checked (Obscura, proven live) — same paint. */
    (c as HTMLElement).nextElementSibling?.classList.toggle('is-on', (c as HTMLInputElement).checked);
  }
  if (n === 0) { show(bar, false); bar.textContent = ''; }
  else {
    show(bar, true);
    renderBulkBar(bar);
  }
  /* header select-all reflects the visible filtered scope */
  for (const key of ['queue', 'all']) {
    const sa = $('mod-' + key + '-selall') as HTMLInputElement | null;
    if (!sa) continue;
    const boxes = Array.from(host.querySelectorAll('input[data-sel]')) as HTMLInputElement[];
    const visChecked = boxes.filter((b) => b.checked).length;
    sa.checked = boxes.length > 0 && visChecked === boxes.length;
    sa.indeterminate = visChecked > 0 && visChecked < boxes.length;
    /* v0.6.20 (P10): select-all styled box mirrors checked/mixed. */
    sa.nextElementSibling?.classList.toggle('is-on', sa.checked);
    sa.nextElementSibling?.classList.toggle('is-mixed', sa.indeterminate);
  }
}
function renderBulkBar(bar: HTMLElement): void {
  bar.textContent = '';
  const ids = Array.from(selected).map(Number);
  const cnt = el('span', 'mod-sel-n'); cnt.dataset.selcount = String(ids.length);
  cnt.textContent = ids.length + ' selected';
  const mkB = (label: string, cls: string, fn: () => void) => {
    const b = el('button', cls); b.type = 'button'; b.textContent = label;
    b.dataset.bulkaction = label.toLowerCase(); b.addEventListener('click', fn);
    return b;
  };
  bar.appendChild(cnt);
  bar.appendChild(mkB('Approve', 'btn-deep', () => void bulkApply(ids, 'approve', bar)));
  bar.appendChild(mkB('Spam', 'btn-ghost', () => void bulkApply(ids, 'spam', bar)));
  bar.appendChild(mkB('Trash', 'btn-ghost', () => void bulkApply(ids, 'trash', bar)));
  /* Delete-forever only when EVERY selected row is trash (worker guard). */
  const allTrash = ids.length > 0 && ids.every((id) => listStatusById[String(id)] === 'trash');
  if (allTrash) {
    bar.appendChild(deleteForeverButton('Delete forever', () => void bulkApply(ids, 'purge', bar), ids.length + ' selected'));
  }
  bar.appendChild(mkB('Clear', 'btn-ghost', () => clearSelection()));
}
async function bulkApply(ids: number[], action: string, bar: HTMLElement): Promise<void> {
  for (const b of Array.from(bar.querySelectorAll('button'))) (b as HTMLButtonElement).disabled = true;
  let res: Response;
  try { res = await api('/moderation/bulk', { method: 'POST', body: JSON.stringify({ ids, action }) }); }
  catch { netError(); for (const b of Array.from(bar.querySelectorAll('button'))) (b as HTMLButtonElement).disabled = false; return; }
  const data = await res.json().catch(() => ({} as Record<string, unknown>));
  if (res.status === 401) { wrongToken(); return; }
  if (!res.ok) {
    setToast('Bulk ' + action + ' failed — ' + String((data as { message?: string }).message || res.status), true);
    for (const b of Array.from(bar.querySelectorAll('button'))) (b as HTMLButtonElement).disabled = false;
    return;
  }
  const d = data as { succeeded?: number; total?: number; results?: { id: number; ok: boolean; code?: string }[] };
  const okN = Number(d.succeeded ?? 0); const tot = Number(d.total ?? ids.length);
  const fails = (d.results || []).filter((r) => !r.ok);
  const PAST: Record<string, string> = { approve: 'approved', spam: 'spammed', trash: 'trashed', purge: 'purged' };
  if (fails.length) {
    setToast(okN + '/' + tot + ' applied — failed: ' + fails.map((f) => '#' + f.id + ' ' + (f.code || 'error')).join(', '), true);
  } else {
    setToast(okN + '/' + tot + ' ' + (PAST[action] || action));
  }
  clearSelectionSilent();
  await reloadActive();
}
function clearSelectionSilent(): void {
  selected.clear();
  const bar = $('mod-bulkbar');
  if (bar) { show(bar, false); bar.textContent = ''; }
}

async function sendReply(it: Item, ta: HTMLTextAreaElement, btn: HTMLButtonElement, msg: HTMLElement): Promise<void> {
  const content = ta.value.trim();
  if (!content) { msg.textContent = 'Write something first.'; return; }
  btn.disabled = true; msg.textContent = '';
  try {
    const res = await fetch(API + '/comments', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        postId: it.post_id,
        name: 'G-will Chijioke',
        content,
        parent: it.id,
        consent: true,
      }),
    });
    const data = await res.json().catch(() => ({} as Record<string, unknown>));
    if (res.ok && (data as { ok?: boolean }).ok) {
      const rid = String((data as { id?: number }).id ?? '?');
      msg.textContent = 'Reply queued as #' + rid + ' — approve it below.';
      setToast('Reply queued as #' + rid + ' — approve it below.');
      ta.value = '';
      await reloadActive();
    } else {
      msg.textContent = String((data as { message?: string }).message || ('HTTP ' + res.status));
    }
  } catch {
    msg.textContent = 'Could not reach the desk API — retry.';
  } finally {
    btn.disabled = false;
  }
}

function reloadActive(): Promise<void> {
  if (state.tab === 'queue') return loadQueue();
  if (state.tab === 'all') return loadAll();
  if (state.tab === 'reports') return loadReports();
  return loadOverview();
}

/* ---------- wiring ---------- */
lock?.addEventListener('submit', (ev) => {
  ev.preventDefault();
  lockMsg?.classList.remove('is-bad');
  if (lockMsg) lockMsg.textContent = '';
  saveTok((tokInp?.value || '').trim());
  if (!token) { if (lockMsg) lockMsg.textContent = 'Paste the desk token first.'; return; }
  void setTab(state.tab);
});

tabs?.addEventListener('click', (ev) => {
  const b = (ev.target as HTMLElement)?.closest?.('.mod-tab') as HTMLElement | null;
  if (!b || !unlocked) return;
  void setTab(b.getAttribute('data-tab') || 'overview');
});
seg?.addEventListener('click', (ev) => {
  const b = (ev.target as HTMLElement)?.closest?.('button[data-status]') as HTMLElement | null;
  if (!b) return;
  state.status = b.getAttribute('data-status') || 'approved';
  state.page = 1;
  syncHash();
  void loadAll();
});
postForm?.addEventListener('submit', (ev) => {
  ev.preventDefault();
  state.post = (postInp?.value || '').trim().replace(/[^0-9]/g, '');
  state.page = 1;
  syncHash();
  void loadAll();
});
prevB?.addEventListener('click', () => {
  if (state.page > 1) { state.page -= 1; syncHash(); void loadAll(); }
});
nextB?.addEventListener('click', () => { state.page += 1; syncHash(); void loadAll(); });

refreshB?.addEventListener('click', () => void reloadActive());
/* v0.6.17 (B): header select-all — scope = the rows actually rendered in the
   current filtered tab (visible filtered scope, per brief). */
for (const key of ['queue', 'all']) {
  const sa = $('mod-' + key + '-selall') as HTMLInputElement | null;
  sa?.addEventListener('change', () => {
    const host = key === 'queue' ? queueList : allList;
    if (!host) return;
    for (const c of Array.from(host.querySelectorAll('input[data-sel]'))) (c as HTMLInputElement).checked = sa.checked;
    onSelChange();
  });
}
retryB?.addEventListener('click', () => void reloadActive());
signoutB?.addEventListener('click', () => {
  saveTok('');
  if (tokInp) tokInp.value = '';
  if (lockMsg) { lockMsg.textContent = 'Signed out.'; lockMsg.classList.remove('is-bad'); }
  setLocked(true);
});

window.addEventListener('hashchange', () => {
  if (!readHash()) return;
  paintTabs();
  if (unlocked) void setTab(state.tab);
});

/* boot: hash keeps tab (and All-tab filters) across refresh; ?tab= legacy
   deep link is honoured when no hash present; default = Overview (v0.6.16) */
if (!readHash() && TABS.includes(TAB_QUERY)) state.tab = TAB_QUERY;
paintTabs();
for (const k of TABS) if (views[k]) views[k]!.hidden = k !== state.tab;
setLocked(true);
if (token) void setTab(state.tab); // saved token → straight into the console
</script>
